{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_LEAN": "1"
  },
  "permissions": {
    "allow": [
      "Bash(unzip -l *)",
      "Bash(unzip -p *)",
      "Bash(javap *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-CimInstance *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Write-Output *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Measure-Object *)",
      "Bash(\"/c/Users/Will/.jdks/jdk-25.0.3+9/bin/javap.exe\" *)",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__Roblox_Studio__screen_capture",
      "mcp__Roblox_Studio__get_console_output",
      "mcp__computer-use__screenshot",
      "mcp__computer-use__zoom",
      "PowerShell(Start-Sleep *)",
      "PowerShell(Out-Null)",
      "PowerShell(Out-String *)",
      "PowerShell(Get-PnpDevice *)",
      "PowerShell(Get-NetIPAddress *)",
      "PowerShell(Get-NetAdapter *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Date *)",
      "PowerShell(Get-ItemProperty *)",
      "Bash(git ls-tree *)",
      "Bash(git merge-base *)",
      "Bash(git rev-list *)",
      "Bash(tasklist *)",
      "Bash(cygpath *)",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__find",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__visualize__read_me",
      "mcp__terminal__read_terminal"
    ]
  },
  "enabledPlugins": {
    "nimble@knowledge-work-plugins": false,
    "product-management@knowledge-work-plugins": false,
    "productivity@knowledge-work-plugins": false,
    "design@anthropic-plugin-directory": false
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" statusline || bash .claude/hooks/lean/run.sh statusline"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__github__get_job_logs",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" post-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" session-start",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
