{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 300000,
  "env": {
    "CLAUDE_LEAN": "1"
  },
  "enabledPlugins": {
    "nimble@knowledge-work-plugins": false,
    "product-management@knowledge-work-plugins": false,
    "productivity@knowledge-work-plugins": false,
    "design@anthropic-plugin-directory": false
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" statusline || bash .claude/hooks/lean/run.sh statusline"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__github__get_job_logs",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" post-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lean/run.sh\" session-start",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
