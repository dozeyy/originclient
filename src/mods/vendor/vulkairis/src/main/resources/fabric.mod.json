{
	"schemaVersion": 1,
	"id": "vulkairis",
	"version": "${version}",
	"name": "VulkaIris (Origin build)",
	"description": "Unofficial mod that let's you use Iris shaders with Vulkanmod",
	"authors": [
		"ColorfulSunshine"
	],
	"contributors": [
		"Lilbroskato",
		"crispypeanutsyt",
		"Origin Client"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/vulkairis",
		"sources": "https://github.com/Potatochip-p/vulkairis"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/vulkairis/Icon.png",
