<Window x:Class="OriginLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Origin Launcher"
        Icon="Assets/origin.ico"
        Width="1180" Height="740"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <!-- Poster backdrop behind every page: the family art in greyscale, the
             giant version numeral, the scrims and the page dim (ArtStage.cs). -->
        <controls:ArtStage x:Name="Stage"/>

        <!-- Chromeless content layer. Background=Transparent (not null) so
             empty space is still hit-testable for the drag-anywhere handler
             below; buttons consume the click first, so this only fires when
             the click lands on genuinely empty background. -->
        <Grid Background="Transparent" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">

            <!-- Pages fill the window; each page clears the 56 px bar itself (Home's
                 launch screen covers the bar, and the bar hides while it shows). -->
            <ContentControl x:Name="PageHost">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageTransform"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- The Import page (ImportPanel): a full page like Profiles, in the same slot, under the bar. It
                 replaces the page behind it while it is open (that page is hidden, never unloaded). -->
            <ContentControl x:Name="ImportPageHost" Visibility="Collapsed" IsTabStop="False" Focusable="False"
                            KeyboardNavigation.TabNavigation="Cycle"/>

            <!-- The bar's surface (spec 11.4: color.nav, a 1 px hairline underneath, no blur, fixed). Pages scroll
                 UNDER it and never read through it; on Home it fades out so the art runs to the top edge. -->
            <Border x:Name="BarSurface" Height="{StaticResource Size.Bar}" VerticalAlignment="Top" IsHitTestVisible="False"
                    Background="{StaticResource Brush.PanelGlass}" BorderBrush="{StaticResource Brush.SoftStroke}"
                    BorderThickness="0,0,0,1" Opacity="0"/>

            <!-- The top bar: brand left, page tabs centred, actions right. -->
            <Grid x:Name="TopBar" Height="{StaticResource Size.Bar}" VerticalAlignment="Top" Margin="24,0,12,0"
                  SizeChanged="TopBar_LayoutChanged">
                <StackPanel x:Name="BarBrand" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            AutomationProperties.Name="Origin">
                    <controls:BrandLogo Width="{StaticResource Size.Logo.Bar}" Height="{StaticResource Size.Logo.Bar}" VerticalAlignment="Center"/>
                    <Image Source="{StaticResource Brand.Wordmark}" Height="{StaticResource Size.Wordmark.Bar}" Margin="8,0,0,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <!-- Centred on the window; TopBar_LayoutChanged slides it left only when the
                     actions on the right would come within Space.5 of SETTINGS (narrow windows). -->
                <StackPanel x:Name="NavTabs" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            SizeChanged="TopBar_LayoutChanged">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="NavTabsShift"/>
                    </StackPanel.RenderTransform>
                    <ToggleButton x:Name="NavHome" Style="{StaticResource Button.NavItem}"
                                  Checked="NavHome_Checked" Unchecked="Nav_Unchecked"
                                  AutomationProperties.Name="Home">
                        <controls:TrackedText Text="HOME" Tracking="0.14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="NavMods" Style="{StaticResource Button.NavItem}"
                                  Checked="NavMods_Checked" Unchecked="Nav_Unchecked"
                                  AutomationProperties.Name="Mods">
                        <controls:TrackedText Text="MODS" Tracking="0.14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="NavProfiles" Style="{StaticResource Button.NavItem}"
                                  Checked="NavProfiles_Checked" Unchecked="Nav_Unchecked"
                                  AutomationProperties.Name="Profiles">
                        <controls:TrackedText Text="PROFILES" Tracking="0.14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="NavSettings" Style="{StaticResource Button.NavItem}"
                                  Checked="NavSettings_Checked" Unchecked="Nav_Unchecked"
                                  AutomationProperties.Name="Settings">
                        <controls:TrackedText Text="SETTINGS" Tracking="0.14"/>
                    </ToggleButton>
                </StackPanel>

                <StackPanel x:Name="BarActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            SizeChanged="TopBar_LayoutChanged">
                    <!-- Update badge: hidden until UpdateService finds a newer release;
                         clicking downloads it, swaps the install, and restarts. -->
                    <Button x:Name="UpdateBadge" Click="UpdateBadge_Click"
                            Style="{StaticResource Button.Chrome}"
                            Padding="8" Margin="0,0,4,0" MinWidth="{StaticResource Size.ControlMd}" MinHeight="{StaticResource Size.ControlMd}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Install update">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Download}" Style="{StaticResource Icon.Base}"
                                  Stroke="{StaticResource Brush.Text}"/>
                            <!-- After a failed update: one calm word on the badge itself (no hover label needed). -->
                            <TextBlock x:Name="UpdateRetryText" Text="Update failed - retry" Style="{StaticResource Text.Caption}"
                                       Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,2,0"
                                       Foreground="{StaticResource Brush.Warning}"/>
                        </StackPanel>
                    </Button>
                    <!-- Website: opens originclient.org in the default browser (ExternalLink). -->
                    <Button x:Name="WebsiteButton" Click="WebsiteButton_Click"
                            Style="{StaticResource Button.Chrome}"
                            Padding="8" Margin="0,0,4,0" MinHeight="{StaticResource Size.ControlMd}"
                            AutomationProperties.Name="Open the Origin website, originclient.org">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Emblem.Globe}" Style="{StaticResource Icon.Base}"
                                 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="WebsiteLabel" Text="Website" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Canvas x:Name="WebsiteArrow" Width="0" Height="{StaticResource Icon.SizeLinkHint}" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon.LinkHint}"/>
                            </Canvas>
                        </StackPanel>
                    </Button>
                    <!-- Store: opens originclient.org/store in the default browser. Same ghost look as Website. -->
                    <Button x:Name="StoreButton" Click="StoreButton_Click"
                            Style="{StaticResource Button.Chrome}"
                            Padding="8" Margin="0,0,4,0" MinHeight="{StaticResource Size.ControlMd}"
                            AutomationProperties.Name="Open the Origin store, originclient.org/store">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Store}" Style="{StaticResource Icon.Base}"
                                 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="StoreLabel" Text="Store" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Canvas x:Name="StoreArrow" Width="0" Height="{StaticResource Icon.SizeLinkHint}" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon.LinkHint}"/>
                            </Canvas>
                        </StackPanel>
                    </Button>
                    <!-- Import from another launcher: opens the Import page. -->
                    <Button x:Name="ImportButton" Click="ImportButton_Click"
                            Style="{StaticResource Button.Chrome}"
                            Padding="8" Margin="0,0,4,0" MinWidth="{StaticResource Size.ControlMd}" MinHeight="{StaticResource Size.ControlMd}"
                            ToolTip="Import"
                            AutomationProperties.Name="Import from another launcher">
                        <Path Data="{StaticResource Icon.ImportIn}" Style="{StaticResource Icon.Base}"
                             
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <!-- Friends (docs/SOCIAL.md): the dot lights for unread messages,
                         requests and party invites, in the family accent. -->
                    <Grid Margin="0,0,6,0">
                        <Button x:Name="FriendsButton" Click="FriendsButton_Click"
                                Style="{StaticResource Button.Chrome}"
                                Padding="8" MinWidth="{StaticResource Size.ControlMd}" MinHeight="{StaticResource Size.ControlMd}"
                                ToolTip="Friends" AutomationProperties.Name="Friends">
                            <Path Data="{StaticResource Icon.Friends}" Style="{StaticResource Icon.Base}"
                                 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Ellipse x:Name="FriendsBadge" Width="7" Height="7" Fill="{DynamicResource Brush.Accent}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                                 IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                    <!-- The account chip: face, name, chevron. Opens the account drawer. -->
                    <Button x:Name="AccountButton" Click="AccountButton_Click"
                            Style="{StaticResource Button.Chrome}"
                            Padding="6,0,8,0" MinHeight="{StaticResource Size.ControlMd}" MinWidth="{StaticResource Size.ControlMd}"
                            AutomationProperties.Name="Accounts">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="2" ClipToBounds="True"
                                    Background="{StaticResource Brush.CardAlt}">
                                <controls:PlayerHead x:Name="AccountFace"/>
                            </Border>
                            <TextBlock x:Name="AccountName" Text="Sign in" Margin="8,0,6,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon.Base}"
                                  Width="12" Height="12" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Margin="10,0" Background="{StaticResource Brush.Stroke}" VerticalAlignment="Center"/>
                    <Button Click="MinimizeButton_Click" Style="{StaticResource Button.Chrome}"
                            Padding="10" MinWidth="{StaticResource Size.ControlMd}" MinHeight="{StaticResource Size.ControlMd}"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <Path Data="{StaticResource Icon.Minimize}" Style="{StaticResource Icon.Base}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Click="CloseButton_Click" Style="{StaticResource Button.Chrome}"
                            Padding="10" MinWidth="{StaticResource Size.ControlMd}" MinHeight="{StaticResource Size.ControlMd}"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Base}"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Account switcher overlay (scrim + slide-out panel) -->
        <Border x:Name="Scrim" Background="{StaticResource Brush.Scrim}" Opacity="0"
                Visibility="Collapsed" IsHitTestVisible="False"
                MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

        <Border x:Name="AccountPanel" Width="{StaticResource Size.Drawer}" HorizontalAlignment="Right"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1,0,0,0"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="AccountPanelTransform" X="{StaticResource Size.Drawer}"/>
            </Border.RenderTransform>
            <ContentControl x:Name="AccountPanelHost"/>
        </Border>

        <!-- Friends drawer: same slide-out and the same width (Size.Drawer) as the account panel.
             Shares the Scrim; only one drawer is open at once. -->
        <Border x:Name="FriendsDrawer" Width="{StaticResource Size.Drawer}" HorizontalAlignment="Right"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1,0,0,0"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FriendsDrawerTransform" X="{StaticResource Size.Drawer}"/>
            </Border.RenderTransform>
            <ContentControl x:Name="FriendsPanelHost"/>
        </Border>

        <!-- Embedded Microsoft sign-in: a locked-in-place card over the rest of
             the app (not a separate OS window) so the whole OAuth flow stays
             inside the launcher. Only ever shown while AccountPanel is already
             open, so it reuses that panel's Scrim rather than needing its own. -->
        <Border x:Name="SignInPanel" Width="460" Height="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect><StaticResource ResourceKey="Shadow.Overlay"/></Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="SignInPanelScale" ScaleX="0.94" ScaleY="0.94"/>
            </Border.RenderTransform>
            <ContentControl x:Name="SignInPanelHost"/>
        </Border>

        <!-- Social toasts, above everything. They sit 104 px up from the bottom, clear of Home's Play row
             (48 px tall, 32 up) and its status line, so a toast never covers Play or Join server.
             Moves left of the Friends drawer while it's open (MainWindow.xaml.cs: SetFriendsOpen). -->
        <controls:SocialToastHost x:Name="Toasts" Width="320"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,104"/>

        <!-- Opening animation, over everything; removes itself when done (StartupIntro.xaml.cs). -->
        <controls:StartupIntro x:Name="Intro"/>
    </Grid>
</Window>
