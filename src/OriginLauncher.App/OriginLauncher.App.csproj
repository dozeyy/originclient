<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\origin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF tests (src/OriginLauncher.UiTests) read the crash windows' generated named fields. -->
    <InternalsVisibleTo Include="OriginLauncher.UiTests" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\origin.ico" />
    <!-- Poster art (Assets/SOURCES.md): per version family, a greyscale home layer
         (g1280/g2560/g3840), a colour bloom layer for launch (c1280/c2560/c3840) and picker
         thumbs (tg grey, tc colour). ArtStage picks the tier by the window's pixel width and
         falls back to a lower tier if a file is absent. Rebuilt by tools/launcher-art/build_art.py;
         the glob picks up any tier that file writes. -->
    <Resource Include="Assets\Art\*.jpg" />
    <!-- Other launchers' logos for the import screens, and the Origin wordmark. -->
    <Resource Include="Assets\Logos\*.png" />
    <Resource Include="Assets\Brand\*.png" />
    <!-- Home banner preview art (tools/launcher-previews renders these). -->
    <Resource Include="Assets\Promos\*.jpg" />
    <!-- The launcher uses one openly licensed Minecraft-style face. In-game
         UI uses Minecraft's own Font renderer and does not bundle this file. -->
    <Resource Include="..\..\tools\font-atlas\fonts\Monocraft.ttf" Link="Assets\Fonts\Monocraft.ttf" />
    <!-- Inter (OFL), the launcher's text face since the Poster restyle: the same
         face as the in-game Origin menus. One file per weight, one "Inter" family. -->
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-400.ttf" Link="Assets\Fonts\Inter-400.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-500.ttf" Link="Assets\Fonts\Inter-500.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-600.ttf" Link="Assets\Fonts\Inter-600.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-700.ttf" Link="Assets\Fonts\Inter-700.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-800.ttf" Link="Assets\Fonts\Inter-800.ttf" />
    <Content Include="..\..\website\assets\fonts\Inter-LICENSE.txt" Link="ThirdParty\Inter-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\font-atlas\fonts\Monocraft-LICENSE.txt" Link="ThirdParty\Monocraft-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The icon set (Theme/Icons.xaml) is Feather-based; MIT asks its notice ship along. -->
    <Content Include="..\..\design\icon-proposals\origin-icon-system-v2\LICENSE-Feather.txt" Link="ThirdParty\Feather-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Bundles each src/mods module's Gradle build output into the launcher's
    output directory (as Bundled/OriginClient/originclient-<mcver>.jar, read at
    runtime via OriginPaths.BundledOriginClientJar) so a Fabric instance the
    launcher provisions can be pre-loaded with the Origin Client build matching
    the chosen Minecraft version — no separate manual copy step, and whatever
    tool packages this output into a setup installer picks the jars up along
    with everything else. VersionManager's OriginBuilds registry maps each MC
    version to the bundled filename here.

    Each entry globs originclient-<module>-*.jar (minus -sources/-dev) in its
    module's build/libs, so a mod_version bump can never orphan the path
    (launcher-v1.0.33 shipped-failed on exactly that when names were pinned).
    The cost: a stale second jar in build/libs would collide on the same Link.
    CI is immune — .github/actions/publish-launcher places exactly one jar per
    module (built, or reused from the last release as
    originclient-<module>-reused.jar) — but locally, clean build/libs after a
    version bump.

    A glob that matches nothing simply adds no item, so a fresh checkout (or a
    launcher-only change) still builds before ./gradlew build has been run —
    the launcher already fail-softs at runtime when a bundled jar is absent
    (VersionManager falls back to the standalone perf-mod catalog for that
    version). A RELEASE build must still verify the jars are present.

    Every jar is kept LOOSE next to the exe in a single-file publish. Without
    ExcludeFromSingleFile it gets embedded in the bundle and extracted to a temp
    dir, while OriginPaths.BundledOriginClientJar looks in AppContext.BaseDirectory
    (the exe's own folder) — so File.Exists is false, the launcher thinks the
    mod isn't bundled, and it falls back to the standalone perf-mod catalog (a
    stray Sodium that breaks Iris). Loose = the path resolves.
  -->
  <ItemGroup>
    <!-- 1.21.1 STOCK — full Origin build, self-contained perf stack (jar-in-jar):
         Sodium 0.6.13 + Indium + Iris 1.8.8. Default install. -->
    <Content Include="..\mods\versions\1.21.1\build\libs\originclient-*.jar"
             Exclude="..\mods\versions\1.21.1\build\libs\originclient-*-sources.jar;..\mods\versions\1.21.1\build\libs\originclient-*-dev.jar">
      <Link>Bundled\OriginClient\originclient-1.21.1.jar</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- 1.20 / 1.20.1 — Origin client only; perf stack installed standalone. -->
