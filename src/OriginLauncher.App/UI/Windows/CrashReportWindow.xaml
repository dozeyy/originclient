<Window x:Class="OriginLauncher.App.UI.Windows.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin — Minecraft crashed"
        Width="880" MinWidth="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- The window is as tall as its content (SizeToContent), so there is no empty band when the mod list is hidden;
         "Show details" adds a fixed 200 px panel. The five buttons need ~800 px in one row with the longest fix label (the width at which CI's
         "Check nothing is cut off" is happy); narrower than that the tool buttons wrap onto a second row. -->
    <!-- Same rule as CrashWindow: theme brushes, type scale and the shared buttons only. -->
    <!-- The 24 px edge is padding on a border, not a margin on the grid, so the window's content fills its
         whole area (a margin shifts what a screenshot of the content captures). -->
    <Border Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Several games can run at once (one per account), so the window
             names which one crashed: "<account> · Minecraft <version>". -->
        <StackPanel Grid.Row="0">
            <!-- A soft warm tag for the cause (CrashClassifier's Tag), then the plain-language headline. -->
            <TextBlock x:Name="CauseTag" Style="{StaticResource Text.BodyStrong}" Foreground="{StaticResource Brush.Warning}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="HeadlineText" Text="Minecraft closed unexpectedly" Style="{StaticResource Text.Heading}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="WhoText" Style="{StaticResource Text.BodyStrong}" Foreground="{StaticResource Brush.Accent}"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ReasonText" Style="{StaticResource Text.BodyDim}" LineHeight="20"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- One row per implicated mod; hidden when the culprit is unknown. -->
        <Border Grid.Row="2" x:Name="CulpritPanel" Margin="0,16,0,0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}" Padding="16"
                Visibility="Collapsed">
            <StackPanel x:Name="CulpritList"/>
        </Border>

        <!-- Technical detail stays behind "Show details": a player should not meet a stack trace first. -->
        <Border Grid.Row="3" x:Name="DetailsPanel" Visibility="Collapsed" Height="200" Margin="0,8,0,0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="{StaticResource Brush.TextDim}" BorderThickness="0"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Label}" Padding="16"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Footer: the tools (what happened) on the left, the way out (Close, then the one main fix) on the right.
             Every button is the same height (Size.Control) and the secondary ones share one minimum width, so the
             row reads as one set; only the main fix is filled. The vertical margins keep a wrapped row apart; the
             grid's -4 bottom margin takes the extra back so the bottom edge stays at the 24 px padding. -->
        <Grid Grid.Row="4" Margin="0,12,0,-4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Bottom">
                <Button x:Name="DetailsButton" Content="Show details" Style="{StaticResource Button.Secondary}"
                        MinWidth="104" Margin="0,4,8,4" Click="Details_Click"/>
                <Button x:Name="CopyReportButton" Content="Copy report" Style="{StaticResource Button.Secondary}"
                        MinWidth="104" Margin="0,4,8,4" Click="CopyReport_Click"/>
                <Button x:Name="OpenLogButton" Content="Open logs folder" Style="{StaticResource Button.Secondary}"
                        MinWidth="104" Margin="0,4,8,4" Click="OpenLog_Click"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource Button.Secondary}"
                        MinWidth="104" Margin="0,4,8,4" Click="Close_Click"/>
                <Button x:Name="ActionButton" Content="Relaunch with Origin only"
                        Style="{StaticResource Button.Primary.Medium}" Margin="0,4,0,4" Click="Action_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
