<Window x:Class="OriginLauncher.App.UI.Windows.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin — Minecraft crashed"
        Width="620" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#FF090D0C"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- Self-contained styling (hardcoded, no theme StaticResources), same
         rule as CrashWindow: a crash surface must render no matter what. -->
    <Window.Resources>
        <Style x:Key="CrashButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="#FFEFF7F4"/>
            <Setter Property="Background" Value="#FF192320"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF263732"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF23302C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CrashButtonPrimary" TargetType="Button" BasedOn="{StaticResource CrashButton}">
            <Setter Property="Background" Value="#FF4BC8AE"/>
            <Setter Property="Foreground" Value="#FF061512"/>
            <Setter Property="BorderBrush" Value="#FF79DEC9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF79DEC9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Minecraft crashed while starting"
                   Foreground="#FFEFF7F4" FontSize="26" FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1" x:Name="ReasonText" Foreground="#FFA7BBB5" FontSize="13.5" LineHeight="20"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- One row per implicated mod; hidden when the culprit is unknown. -->
        <Border Grid.Row="2" x:Name="CulpritPanel" Margin="0,14,0,0" Background="#FF121918"
                BorderBrush="#FF3B524C" BorderThickness="1" CornerRadius="2" Padding="14"
                Visibility="Collapsed">
            <StackPanel x:Name="CulpritList"/>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Background="#FF121918" BorderBrush="#FF3B524C"
                BorderThickness="1" CornerRadius="2">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="#FFA7BBB5" BorderThickness="0"
                     FontFamily="{StaticResource Font.Mono}" FontSize="11" Padding="14"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OpenLogButton" Content="Open log" Style="{StaticResource CrashButton}"
                    Margin="0,0,8,0" Click="OpenLog_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource CrashButton}"
                    Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="RetryButton" Content="Retry without mods"
                    Style="{StaticResource CrashButtonPrimary}" Click="Retry_Click"/>
        </StackPanel>
    </Grid>
</Window>
