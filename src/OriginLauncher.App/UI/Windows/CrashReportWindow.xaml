<Window x:Class="OriginLauncher.App.UI.Windows.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin — Minecraft crashed"
        Width="620" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#FF0E1110"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- Self-contained styling: literal colours and system fonts only (Segoe UI, Consolas), no
         theme resources, so a crash surface renders even if the theme is what broke.
         Each hex mirrors a Theme/Colors.xaml token (keep them in step by hand):
         #FF0E1110 Color.Bg, #FFF1E9D2 Color.Text, #FFB8B5A6 Color.TextDim, #FF8C9187 Color.TextMuted,
         #FF1D2420 Color.Card, #FF27302A Color.CardAlt, #FF121614 Color.Field, #FF2E3B33 Color.SoftStroke,
         #FF4E705C Color.Stroke, #FF5FD09B Color.Accent, #FF83E2B5 Color.AccentHover, #FF0A1710 Color.TextOnAccent. -->
    <Window.Resources>
        <Style x:Key="CrashButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="#FFF1E9D2"/>
            <Setter Property="Background" Value="#FF1D2420"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF2E3B33"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF27302A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CrashButtonPrimary" TargetType="Button" BasedOn="{StaticResource CrashButton}">
            <Setter Property="Background" Value="#FF5FD09B"/>
            <Setter Property="Foreground" Value="#FF0A1710"/>
            <Setter Property="BorderBrush" Value="#FF83E2B5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF83E2B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Several games can run at once (one per account), so the window
             names which one crashed: "<account> · Minecraft <version>". -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Minecraft crashed while starting"
                       Foreground="#FFF1E9D2" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="WhoText" Foreground="#FF5FD09B" FontSize="13.5" FontWeight="SemiBold"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ReasonText" Foreground="#FFB8B5A6" FontSize="13.5" LineHeight="20"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- One row per implicated mod; hidden when the culprit is unknown. -->
        <Border Grid.Row="2" x:Name="CulpritPanel" Margin="0,14,0,0" Background="#FF121614"
                BorderBrush="#FF4E705C" BorderThickness="1" CornerRadius="2" Padding="14"
                Visibility="Collapsed">
            <StackPanel x:Name="CulpritList"/>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Background="#FF121614" BorderBrush="#FF4E705C"
                BorderThickness="1" CornerRadius="2">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="#FFB8B5A6" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" Padding="14"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OpenLogButton" Content="Open log" Style="{StaticResource CrashButton}"
                    Margin="0,0,8,0" Click="OpenLog_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource CrashButton}"
                    Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="RetryButton" Content="Retry without mods"
                    Style="{StaticResource CrashButtonPrimary}" Click="Retry_Click"/>
        </StackPanel>
    </Grid>
</Window>
