<Window x:Class="OriginLauncher.App.UI.Windows.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin — Minecraft crashed"
        Width="620" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- Same rule as CrashWindow: theme brushes, type scale and the shared buttons only. -->
    <!-- The 24 px edge is padding on a border, not a margin on the grid, so the window's content fills its
         whole area (a margin shifts what a screenshot of the content captures). -->
    <Border Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Several games can run at once (one per account), so the window
             names which one crashed: "<account> · Minecraft <version>". -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Minecraft crashed while starting" Style="{StaticResource Text.H1}"/>
            <TextBlock x:Name="WhoText" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Acc}"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ReasonText" Style="{StaticResource Text.BodyDim}" LineHeight="20"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- One row per implicated mod; hidden when the culprit is unknown. -->
        <Border Grid.Row="2" x:Name="CulpritPanel" Margin="0,16,0,0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}" Padding="16"
                Visibility="Collapsed">
            <StackPanel x:Name="CulpritList"/>
        </Border>

        <Border Grid.Row="3" Margin="0,8,0,0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="{StaticResource Brush.TextDim}" BorderThickness="0"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Eyebrow}" Padding="16"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OpenLogButton" Content="Open log" Style="{StaticResource Button.Secondary}"
                    MinWidth="110" Margin="0,0,8,0" Click="OpenLog_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource Button.Secondary}"
                    MinWidth="110" Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="RetryButton" Content="Retry without mods"
                    Style="{StaticResource Button.Primary.Medium}" Click="Retry_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
