<Window x:Class="OriginLauncher.App.UI.Windows.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin — Minecraft crashed"
        Width="840" Height="380" MinWidth="820" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- The button row (Show details, Copy report, Open logs folder, Close and the main fix) needs ~750 px at its
         natural size: 24 px edges + the window frame make 810 the smallest width that never cuts a label (CI's
         "Check nothing is cut off" caught it at 720). -->
    <!-- Same rule as CrashWindow: theme brushes, type scale and the shared buttons only. -->
    <!-- The 24 px edge is padding on a border, not a margin on the grid, so the window's content fills its
         whole area (a margin shifts what a screenshot of the content captures). -->
    <Border Padding="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Several games can run at once (one per account), so the window
             names which one crashed: "<account> · Minecraft <version>". -->
        <StackPanel Grid.Row="0">
            <!-- A soft warm tag for the cause (CrashClassifier's Tag), then the plain-language headline. -->
            <TextBlock x:Name="CauseTag" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Warning}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="HeadlineText" Text="Minecraft closed unexpectedly" Style="{StaticResource Text.H1}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="WhoText" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Acc}"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ReasonText" Style="{StaticResource Text.BodyDim}" LineHeight="20"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- One row per implicated mod; hidden when the culprit is unknown. -->
        <Border Grid.Row="2" x:Name="CulpritPanel" Margin="0,16,0,0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}" Padding="16"
                Visibility="Collapsed">
            <StackPanel x:Name="CulpritList"/>
        </Border>

        <!-- Technical detail stays behind "Show details": a player should not meet a stack trace first. -->
        <Border Grid.Row="3" x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,8,0,0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="{StaticResource Brush.TextDim}" BorderThickness="0"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Eyebrow}" Padding="16"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DetailsButton" Content="Show details" Style="{StaticResource Button.Secondary}"
                    MinWidth="100" Margin="0,0,8,0" Click="Details_Click"/>
            <Button x:Name="CopyReportButton" Content="Copy report" Style="{StaticResource Button.Secondary}"
                    MinWidth="100" Margin="0,0,8,0" Click="CopyReport_Click"/>
            <Button x:Name="OpenLogButton" Content="Open logs folder" Style="{StaticResource Button.Secondary}"
                    MinWidth="100" Margin="0,0,8,0" Click="OpenLog_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource Button.Secondary}"
                    MinWidth="80" Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="ActionButton" Content="Relaunch with Origin only"
                    Style="{StaticResource Button.Primary.Medium}" Click="Action_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
