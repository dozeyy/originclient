<Window x:Class="OriginLauncher.App.UI.Windows.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin Launcher — Error"
        Width="660" Height="560" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#FF0E1110"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- Self-contained styling: literal colours and system fonts only (Segoe UI, Consolas), no
         theme resources, so a crash surface renders even if the theme is what broke.
         Each hex mirrors a Theme/Colors.xaml token (keep them in step by hand):
         #FF0E1110 Color.Bg, #FFF1E9D2 Color.Text, #FFB8B5A6 Color.TextDim, #FF8C9187 Color.TextMuted,
         #FF1D2420 Color.Card, #FF27302A Color.CardAlt, #FF121614 Color.Field, #FF2E3B33 Color.SoftStroke,
         #FF4E705C Color.Stroke, #FF5FD09B Color.Accent, #FF83E2B5 Color.AccentHover, #FF0A1710 Color.TextOnAccent. -->
    <Window.Resources>
        <Style x:Key="CrashButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="#FFF1E9D2"/>
            <Setter Property="Background" Value="#FF1D2420"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF2E3B33"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF27302A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CrashButtonPrimary" TargetType="Button" BasedOn="{StaticResource CrashButton}">
            <Setter Property="Background" Value="#FF5FD09B"/>
            <Setter Property="Foreground" Value="#FF0A1710"/>
            <Setter Property="BorderBrush" Value="#FF83E2B5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF83E2B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Heading" Text="Origin Launcher ran into a problem"
                   Foreground="#FFF1E9D2" FontSize="26" FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1" x:Name="Summary" Foreground="#FFB8B5A6" FontSize="13.5" LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Origin closed unexpectedly. Copy the details if you need support."/>

        <Border Grid.Row="2" Margin="0,18,0,0" Background="#FF121614" BorderBrush="#FF4E705C" BorderThickness="1" CornerRadius="2">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="#FFF1E9D2" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="14"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <TextBlock Grid.Row="3" x:Name="SavedTo" Foreground="#FF8C9187" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Content="Copy details" Style="{StaticResource CrashButton}" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource CrashButtonPrimary}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
