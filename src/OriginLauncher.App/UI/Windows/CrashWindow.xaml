<Window x:Class="OriginLauncher.App.UI.Windows.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin Launcher — Error"
        Width="660" Height="560" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#FF090D0C"
        FontFamily="/OriginLauncher.App;component/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- Self-contained styling (hardcoded, no theme StaticResources): a crash
         dialog must render even if something in the app's resources is the very
         thing that broke. -->
    <Window.Resources>
        <Style x:Key="CrashButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="#FFEFF7F4"/>
            <Setter Property="Background" Value="#FF192320"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF263732"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF23302C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CrashButtonPrimary" TargetType="Button" BasedOn="{StaticResource CrashButton}">
            <Setter Property="Background" Value="#FF4BC8AE"/>
            <Setter Property="Foreground" Value="#FF061512"/>
            <Setter Property="BorderBrush" Value="#FF79DEC9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#FF79DEC9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Heading" Text="Origin Launcher ran into a problem"
                   Foreground="#FFEFF7F4" FontSize="26" FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1" x:Name="Summary" Foreground="#FFA7BBB5" FontSize="13.5" LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Origin closed unexpectedly. Copy the details if you need support."/>

        <Border Grid.Row="2" Margin="0,18,0,0" Background="#FF121918" BorderBrush="#FF3B524C" BorderThickness="1" CornerRadius="12">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="#FFEFF7F4" BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" Padding="14"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <TextBlock Grid.Row="3" x:Name="SavedTo" Foreground="#FF6D817B" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Content="Copy details" Style="{StaticResource CrashButton}" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource CrashButtonPrimary}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
