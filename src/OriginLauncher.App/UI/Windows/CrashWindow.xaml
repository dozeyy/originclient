<Window x:Class="OriginLauncher.App.UI.Windows.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Origin Launcher — Error"
        Width="660" Height="560" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- Built entirely from the theme (brushes, type scale, Button.Secondary / Button.Primary.Medium),
         so it matches the launcher. Only fonts, brushes and styles are read from App.xaml's
         dictionaries; no literals here. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Heading" Text="Origin Launcher ran into a problem"
                   Style="{StaticResource Text.H1}"/>

        <TextBlock Grid.Row="1" x:Name="Summary" Style="{StaticResource Text.BodyDim}" LineHeight="20"
                   TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Origin closed unexpectedly. Copy the details if you need support."/>

        <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" Foreground="{StaticResource Brush.Text}" BorderThickness="0"
                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Caption}" Padding="16"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <TextBlock Grid.Row="3" x:Name="SavedTo" Style="{StaticResource Text.Caption}"
                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Content="Copy details" Style="{StaticResource Button.Secondary}"
                    MinWidth="110" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource Button.Primary.Medium}"
                    MinWidth="110" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
