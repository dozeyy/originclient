<UserControl x:Class="OriginLauncher.App.UI.Controls.ImportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d"
             KeyboardNavigation.TabNavigation="Cycle">

    <!-- The Import page (Poster look): a full page like Profiles, in the same 1000 px column under the top bar.
         One pane at a time (ImportPanel.xaml.cs keeps the state machine):
           DetectPane     "Bring it all over": one tile per launcher found (logo, folder, counts, a tick), a slim row for
                          the launchers that weren't found, Choose what to import / Import everything
           PickList       "Choose what to import": a card per launcher, a row per setup, ticks at both levels
           Legacy         what to bring, versions, one version, review, whose settings, one setup, details (720 px column)
           ProgressPane   "Importing": one big percentage and bar, a row per setup (waiting, copying, done)
           DonePane       "You're all set": what came over and the new profiles
           FailedPane     "Nothing changed": the reason
         Every colour, type and shape is a Theme token; the orange tick, dot and bar are the Poster accent (Brush.Acc, indicators only). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>

        <!-- A shield with a tick (the "nothing in your other launchers changed" line). Not in the icon set. -->
        <Geometry x:Key="Import.Icon.Shield">M12,3 L5,6 L5,11 C5,15.5 8,19 12,21 C16,19 19,15.5 19,11 L19,6 Z M9,12 L11,14 L15,10</Geometry>

        <!-- The virtualized list. The column is the page's own edge, so the list sits flush with the title; the 3 px
             inset keeps the outset focus frame from being clipped and the scrollbar gets its own column. -->
        <Style x:Key="Import.List" TargetType="ItemsControl">
            <Setter Property="Margin" Value="-3,-3,-3,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False" Padding="0,0,8,9" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <ItemsPresenter Margin="3"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The arrow on a row that opens a page (Icon.Chevron turned to point right). -->
        <Style x:Key="Import.Go" TargetType="Path" BasedOn="{StaticResource Icon.Base}">
            <Setter Property="Data" Value="{StaticResource Icon.Chevron}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="10,0,2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
            </Setter>
        </Style>

        <!-- The tick: a 22 px block that fills with the accent when on (a dash when only some are). The whole 32 px
             square is the hit area. -->
        <Style x:Key="Import.Tick" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent">
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="{StaticResource Radius.Chip}"
                                    Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Stroke}"
                                    BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Base}"
                                      Width="14" Height="14" StrokeThickness="2.4"
                                      Stroke="{StaticResource Brush.TextOnAccent}" Visibility="Collapsed"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Acc}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Acc}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Acc}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Acc}"/>
                                <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Minus}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A launcher tile / a result card: the card surface; the tile lifts one step on hover. -->
        <Style x:Key="Import.Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="Padding" Value="16,16,16,16"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The three counts under a tile and the four on Done: a number, then its label in small caps. -->
        <Style x:Key="Import.StatNumber" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="LineHeight" Value="28"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- A header button: plain bold words, no frame (Back, Cancel, What to bring, Add a folder). -->
        <Style x:Key="Import.HeaderButton" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ================= rows ================= -->

        <!-- A heading, or a folding one (Done: "SKIPPED - 2"). -->
        <DataTemplate DataType="{x:Type controls:ImportSectionVm}">
            <Grid Margin="0,14,0,6" MinHeight="24">
                <Button x:Name="Btn" Style="{StaticResource Social.SectionButton}" Padding="2,2" Click="Section_Click">
                    <Grid>
                        <TextBlock x:Name="Head" Text="{Binding Heading}" Style="{StaticResource Social.Section}"/>
                        <Path x:Name="Chev" Data="{StaticResource Icon.Chevron}" Style="{StaticResource Icon.Base}"
                              Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0" Stroke="{StaticResource Brush.TextMuted}" RenderTransformOrigin="0.5,0.5"
                              Visibility="Collapsed"/>
                    </Grid>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Collapsible}" Value="False">
                    <Setter TargetName="Btn" Property="IsHitTestVisible" Value="False"/>
                    <Setter TargetName="Btn" Property="Focusable" Value="False"/>
                    <Setter TargetName="Btn" Property="IsTabStop" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Collapsible}" Value="True">
                    <Setter TargetName="Chev" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Collapsed}" Value="True">
                    <Setter TargetName="Chev" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Gold}" Value="True">
                    <Setter TargetName="Head" Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:ImportTitleVm}">
            <StackPanel Margin="2,12,0,12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" TextWrapping="Wrap" TextTrimming="None"
                           Margin="0,0,0,4" Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Sub}" Style="{StaticResource Social.Quiet}" TextWrapping="Wrap" TextTrimming="None"
                           Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:HintVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <TextBlock Text="{Binding Text}" Style="{StaticResource Social.Quiet}" TextWrapping="Wrap" TextTrimming="None"/>
            </Border>
        </DataTemplate>

        <!-- A quiet line that changes in place (the version page's "Settings from ..."). -->
        <DataTemplate DataType="{x:Type controls:ImportNoteVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <TextBlock Text="{Binding Text}" Style="{StaticResource Social.Quiet}" TextWrapping="Wrap" TextTrimming="None"/>
            </Border>
        </DataTemplate>

        <!-- ================= Detect ================= -->

        <!-- A launcher found on this PC: its real logo, name and folder, one tick (in or out of Import everything),
             and its three counts. The whole tile toggles the tick; the tick itself is the keyboard stop. -->
        <DataTemplate DataType="{x:Type controls:LauncherTileVm}">
            <Border Style="{StaticResource Import.Tile}" Cursor="Hand" ToolTip="{Binding Tip}"
                    MouseLeftButtonUp="Tile_MouseUp">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The launcher's own colour, faint, in the tile's top-left corner (an accent, never a fill). It
                         reaches the tile's edge through the padding and takes no clicks. -->
                    <Border Grid.RowSpan="2" Margin="-16" CornerRadius="{StaticResource Radius.Card}"
                            Background="{Binding TintWash}" IsHitTestVisible="False"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Avatar" Width="44" Height="44" Background="{StaticResource Brush.Bg}"
                                BorderBrush="{Binding TintEdge}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="InitialText" Text="{Binding Initial}" Style="{StaticResource Social.Initial}"/>
                                <Image x:Name="LogoImage" Source="{Binding Logo}" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Social.Name}" FontWeight="Bold"
                                       FontSize="15" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PathText}" Style="{StaticResource Social.Caption}"
                                       ToolTip="{Binding PathText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Import.Tick}" IsThreeState="False"
                                  IsChecked="{Binding Ticked, Mode=OneWay}" IsEnabled="{Binding CanTick}"
                                  Margin="8,-6,-8,-6" VerticalAlignment="Top"
                                  Click="TileTick_Click" ToolTip="Include in Import everything"
                                  AutomationProperties.Name="{Binding TickName}"/>
                    </Grid>
                    <!-- Cell padding 8 and gap 4: "INSTANCES" (62 px) must fit a third of the smallest window's tile. -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                        <Border Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Control}"
                                Padding="8,10" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SetupsText}" Style="{StaticResource Import.StatNumber}"/>
                                <TextBlock Text="{Binding SetupsLabel}" Style="{StaticResource Text.Eyebrow}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Control}"
                                Padding="8,10" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding WorldsText}" Style="{StaticResource Import.StatNumber}"/>
                                <TextBlock Text="WORLDS" Style="{StaticResource Text.Eyebrow}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Control}"
                                Padding="8,10">
                            <StackPanel>
                                <TextBlock Text="{Binding ModsText}" Style="{StaticResource Import.StatNumber}"/>
                                <TextBlock Text="MODS" Style="{StaticResource Text.Eyebrow}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                    <Setter TargetName="LogoImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One launcher's small logo in the "not found" row. -->
        <DataTemplate DataType="{x:Type controls:MissingLauncherVm}">
            <Border Width="28" Height="28" Margin="0,0,6,0" Background="{StaticResource Brush.Bg}"
                    CornerRadius="{StaticResource Radius.Chip}" ToolTip="{Binding Title}">
                <Grid>
                    <TextBlock x:Name="InitialText" Text="{Binding Initial}" Style="{StaticResource Social.Initial}"/>
                    <Image x:Name="LogoImage" Source="{Binding Logo}" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                    <Setter TargetName="LogoImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Choose what to import ================= -->

        <!-- A launcher's card header: tick for all of its setups, logo, name, "5 of 5 selected, 17 worlds, 244 mods".
             The setups below are drawn as the same card (the group's Pos gives the top corners). -->
        <DataTemplate DataType="{x:Type controls:PickGroupVm}">
            <Border Margin="{Binding Gap}" Background="{StaticResource Brush.Card}" Padding="16,14,16,6">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource Social.CardCorners}">
                        <Binding Path="Pos"/>
                        <Binding Source="{StaticResource Radius.Card}"/>
                    </MultiBinding>
                </Border.CornerRadius>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Import.Tick}" IsThreeState="False" IsChecked="{Binding State, Mode=OneWay}"
                              IsEnabled="{Binding CanTick}" Margin="-6,0,6,0" Click="GroupTick_Click"
                              ToolTip="Tick or untick every setup" AutomationProperties.Name="{Binding TickName}"/>
                    <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource Brush.Bg}"
                            BorderBrush="{Binding TintEdge}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="InitialText" Text="{Binding Initial}" Style="{StaticResource Social.Initial}"/>
                            <Image x:Name="LogoImage" Source="{Binding Logo}" Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Social.Name}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                    <Setter TargetName="LogoImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One setup inside its launcher's card: tick, name, "23 mods - 3 worlds", its Minecraft version, and the arrow
             that opens its own review. A press on the row ticks it (or opens it when Origin can't run its version). -->
        <DataTemplate DataType="{x:Type controls:PickRowVm}">
            <Border Background="{StaticResource Brush.Card}" Padding="8,0,8,0">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource Social.CardCorners}">
                        <Binding Path="Pos"/>
                        <Binding Source="{StaticResource Radius.Card}"/>
                    </MultiBinding>
                </Border.CornerRadius>
                <Border x:Name="Inner" Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Control}"
                        Padding="12,8,8,8" Margin="0,0,0,4" Cursor="Hand" ToolTip="{Binding RowTip}"
                        MouseLeftButtonUp="PickRow_MouseUp">
                    <Grid MinHeight="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Import.Tick}" IsChecked="{Binding Ticked, Mode=OneWay}"
                                  IsEnabled="{Binding CanTick}" Margin="-6,0,6,0" Click="PickTick_Click"
                                  ToolTip="Include in import" AutomationProperties.Name="{Binding TickName}"/>
                        <StackPanel x:Name="Words" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Caption}"
                                       TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                        <Border x:Name="Badge" Grid.Column="2" Background="{StaticResource Brush.Card}"
                                CornerRadius="{StaticResource Radius.Chip}" Padding="9,4" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Label}" FontSize="12"/>
                        </Border>
                        <Button Grid.Column="3" Style="{StaticResource Social.Icon}" Margin="6,0,0,0" Click="PickReview_Click"
                                ToolTip="Review this setup on its own" AutomationProperties.Name="{Binding ReviewName}">
                            <Path Style="{StaticResource Import.Go}" Margin="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>
                </Border>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Pos}" Value="{x:Static controls:CardPos.Last}">
                    <Setter TargetName="Inner" Property="Margin" Value="0,0,0,8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                    <Setter TargetName="Words" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="Badge" Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Importing ================= -->

        <!-- One setup while importing: waiting (plain), copying (a small bar and the step), done (a tick). -->
        <DataTemplate DataType="{x:Type controls:ProgressRowVm}">
            <Border x:Name="Card" Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Card}"
                    Padding="14,10" Margin="0,0,0,4">
                <Grid MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" Background="{StaticResource Brush.Bg}"
                            BorderBrush="{Binding TintEdge}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Chip}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="InitialText" Text="{Binding Initial}" Style="{StaticResource Social.Initial}"/>
                            <Image x:Name="LogoImage" Source="{Binding Logo}" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Launcher}" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <Border x:Name="Done" Grid.Column="2" Width="22" Height="22" CornerRadius="{StaticResource Radius.Chip}"
                            Background="{StaticResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="Collapsed">
                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                              StrokeThickness="2.4" Stroke="{StaticResource Brush.TextOnAccent}"/>
                    </Border>
                    <Border x:Name="Track" Grid.Column="2" Width="160" Height="4" Background="{StaticResource Brush.ProgressTrack}"
                            CornerRadius="{StaticResource Radius.Bar}" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="Collapsed">
                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" Background="{DynamicResource Brush.Acc}"
                                CornerRadius="{StaticResource Radius.Bar}"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Grid.Column="3" Text="{Binding Status}" Style="{StaticResource Text.Label}"
                               FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                    <Setter TargetName="LogoImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Done" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Track" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="Transparent"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Done ================= -->

        <!-- A big number and its label (the four counts in "You're all set"). -->
        <DataTemplate x:Key="Import.StatBox" DataType="{x:Type controls:ImportStatVm}">
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Control}"
                    Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Import.StatNumber}" FontSize="32" LineHeight="36"/>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Eyebrow}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A new profile: the launcher's logo, the profile's name, "From CurseForge - 1.20.1". "+9 more" opens Profiles. -->
        <DataTemplate x:Key="Import.ProfileCard" DataType="{x:Type controls:ProfileCardVm}">
            <Border x:Name="Card" Style="{StaticResource Import.Tile}" Padding="12,12" Margin="0,0,8,8" MinHeight="60"
                    MouseLeftButtonUp="ProfileCard_MouseUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Avatar" Width="36" Height="36" Background="{StaticResource Brush.Bg}"
                            BorderBrush="{Binding TintEdge}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Chip}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="InitialText" Text="{Binding Initial}" Style="{StaticResource Social.Initial}"/>
                            <Image x:Name="LogoImage" Source="{Binding Logo}" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="Words" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <TextBlock x:Name="MoreText" Grid.ColumnSpan="2" Text="{Binding Name}" Style="{StaticResource Text.Label}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                    <Setter TargetName="LogoImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMore}" Value="True">
                    <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Words" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="MoreText" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Card" Property="Cursor" Value="Hand"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= the older pages (what to bring, versions, review, ...) ================= -->

        <!-- "Import from all versions": the whole row and its tick box do the same thing (mixed = some versions). -->
        <DataTemplate DataType="{x:Type controls:SelectAllVm}">
            <Button Style="{StaticResource Social.Row}" Click="SelectAll_Click" IsEnabled="{Binding Enabled}"
                    AutomationProperties.Name="Import from all versions" ToolTip="Tick or untick every version">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Import from all versions" Style="{StaticResource Social.Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Social.Check}" IsThreeState="False"
                              IsChecked="{Binding State, Mode=OneWay}"
                              IsEnabled="{Binding Allowed, RelativeSource={RelativeSource AncestorType={x:Type controls:ImportPanel}}}"
                              Click="SelectAllTick_Click" ToolTip="Tick or untick every version"
                              AutomationProperties.Name="Import from all versions"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- One Minecraft version: the row opens it (what it brings, its setups); the tick box takes it in or out. -->
        <DataTemplate DataType="{x:Type controls:VersionRowVm}">
            <Button Style="{StaticResource Social.Row}" Click="VersionRow_Click"
                    AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding RowTip}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Words" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Social.Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Caption}"
                                   TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock Text="{Binding Contents}" Style="{StaticResource Social.Quiet}"
                                   TextWrapping="Wrap" TextTrimming="None"
                                   Visibility="{Binding HasContents, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Import.Warning}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Social.Check}" IsChecked="{Binding Ticked, Mode=OneWay}"
                              Visibility="{Binding CanTick, Converter={StaticResource BoolToVis}}"
                              IsEnabled="{Binding Allowed, RelativeSource={RelativeSource AncestorType={x:Type controls:ImportPanel}}}"
                              Click="VersionTick_Click" ToolTip="Include in import"
                              AutomationProperties.Name="{Binding TickName}"/>
                    <Path Grid.Column="2" Style="{StaticResource Import.Go}"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                    <Setter TargetName="Words" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "What to bring": the switches wrap inside one card (Import.Chip, Theme/Social.xaml). -->
        <DataTemplate DataType="{x:Type controls:CategoryBarVm}">
            <Border Style="{StaticResource Social.RowStatic}" Padding="10,10,4,4">
                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False"
                              IsEnabled="{Binding Allowed, RelativeSource={RelativeSource AncestorType={x:Type controls:ImportPanel}}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Import.Chip}" Content="{Binding Text}"
                                          IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding Enabled}"
                                          ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True"
                                          AutomationProperties.Name="{Binding AutomationName}" Click="Chip_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <!-- One setup: the row opens its own review; the tick box takes it in or out. -->
        <DataTemplate DataType="{x:Type controls:SetupRowVm}">
            <Button Style="{StaticResource Social.Row}" Click="SetupRow_Click"
                    AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding RowTip}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Avatar" Style="{StaticResource Social.Avatar}" Margin="0,0,10,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Initial}" Style="{StaticResource Social.Initial}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource Social.Name}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CaptionText" Text="{Binding Caption}" Style="{StaticResource Social.Caption}"
                                   TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Import.Warning}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Content="Change" Style="{StaticResource Social.Action}"
                                Visibility="{Binding HasChoice, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding Allowed, RelativeSource={RelativeSource AncestorType={x:Type controls:ImportPanel}}}"
                                ToolTip="Pick whose settings to use" Click="SetupChange_Click"
                                AutomationProperties.Name="{Binding ChangeName}"/>
                        <CheckBox Style="{StaticResource Social.Check}" IsChecked="{Binding Ticked, Mode=TwoWay}"
                                  Visibility="{Binding ShowTick, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding Allowed, RelativeSource={RelativeSource AncestorType={x:Type controls:ImportPanel}}}"
                                  Click="SetupTick_Click" ToolTip="Include in import"
                                  AutomationProperties.Name="{Binding TickName}"/>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                    <Setter TargetName="Avatar" Property="Opacity" Value="0.55"/>
                    <Setter TargetName="NameText" Property="Opacity" Value="0.55"/>
                    <Setter TargetName="CaptionText" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Whose settings: the setup and how much it was played; the picked one has a 1 px accent frame (like SELECTED on Profiles). -->
        <DataTemplate DataType="{x:Type controls:ChooseRowVm}">
            <Button Style="{StaticResource Social.Row}" Click="ChooseRow_Click"
                    AutomationProperties.Name="{Binding Name}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Frame" Grid.ColumnSpan="2" Margin="-10,-8" BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                    <Border Style="{StaticResource Social.Avatar}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}" Style="{StaticResource Social.Initial}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Caption}" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Frame" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:ImportOptionVm}">
            <Border Style="{StaticResource Social.RowStatic}" Padding="10,6">
                <Grid MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Social.Name}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Quiet}" TextWrapping="Wrap"
                                   TextTrimming="None"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Toggle.Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}" Click="Option_Click"
                                  AutomationProperties.Name="{Binding Label}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:ImportStatVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               TextTrimming="None" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:ImportLineVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Social.Name}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Social.Caption}" TextWrapping="Wrap"
                                   TextTrimming="None" Visibility="{Binding HasCaption, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Import.Warning}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Social.Caption}"
                               Foreground="{Binding StatusBrush}" Margin="12,0,0,0" VerticalAlignment="Top"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The page column: the same 1000 px and insets as Profiles (the top inset clears the 56 px bar). -->
        <Grid x:Name="Column" MaxWidth="1000" Margin="32,96,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="Auto"/>   <!-- notice -->
                <RowDefinition Height="*"/>      <!-- the page -->
                <RowDefinition Height="Auto"/>   <!-- footer -->
            </Grid.RowDefinitions>

            <!-- Header: the poster title, one or two lines under it, a status line with a dot, and the page's small
                 actions on the right. Done has its own title inside its card, so the header goes away there. -->
            <Grid x:Name="HeaderBlock" Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="BRING IT ALL OVER" Style="{StaticResource Text.Poster}"
                               HorizontalAlignment="Left" TextTrimming="None" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap"
                               TextTrimming="None" MaxWidth="600" HorizontalAlignment="Left" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.Acc}"
                                 VerticalAlignment="Center" Margin="0,1,10,0"/>
                        <Path x:Name="ScanSpinner" Data="{StaticResource Icon.Loading}" Style="{StaticResource Icon.Base}"
                              Width="14" Height="14" Margin="-3,0,7,0" Stroke="{StaticResource Brush.TextDim}"
                              RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ScanSpin"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextDim}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,8,0,0">
                    <Button x:Name="BringButton" Style="{StaticResource Import.HeaderButton}" Content="What to bring"
                            Click="Bring_Click" Visibility="Collapsed" ToolTip="Pick what each version brings over"
                            AutomationProperties.Name="What to bring"/>
                    <Button x:Name="BrowseButton" Style="{StaticResource Import.HeaderButton}" Click="Browse_Click"
                            Visibility="Collapsed" ToolTip="Point Origin at a setup's folder" AutomationProperties.Name="Add a folder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                                  Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Add a folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BackButton" Style="{StaticResource Import.HeaderButton}" Content="Back"
                            Click="Back_Click" Visibility="Collapsed" ToolTip="Back (Esc)" AutomationProperties.Name="Back"/>
                    <Button x:Name="CancelButton" Style="{StaticResource Import.HeaderButton}" Content="Cancel"
                            Click="Cancel_Click" Visibility="Collapsed" ToolTip="Stop importing" AutomationProperties.Name="Cancel import"/>
                </StackPanel>
            </Grid>

            <!-- One status line: why Import is off, or what went wrong with a folder. -->
            <Border x:Name="NoticeStrip" Grid.Row="1" Style="{StaticResource Social.Strip}" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="NoticeIcon" Data="{StaticResource Icon.Alert}" Style="{StaticResource Icon.Base}"
                          Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top" Stroke="{StaticResource Brush.Warning}"/>
                    <TextBlock x:Name="NoticeText" Grid.Column="1" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" TextTrimming="None"/>
                </Grid>
            </Border>

            <!-- ============ the page (one pane at a time) ============
                 Each pane keeps its own list, so Back returns to the same scroll position and focus. -->
            <Grid Grid.Row="2">

                <!-- Detect -->
                <ScrollViewer x:Name="DetectPane" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0,0,8,0" Margin="-3,-3,-3,0">
                    <StackPanel Margin="3">
                        <TextBlock x:Name="ScanNote" Text="Looking through your other launchers..." Style="{StaticResource Text.BodyDim}"
                                   Margin="0,6,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="TilesList" Focusable="False" Margin="0,0,-16,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid x:Name="TilesGrid" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- The launchers that weren't found (or were empty): one slim row, and the way to point at a folder. -->
                        <Border x:Name="MissingBar" Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Card}"
                                Padding="14,10" Margin="0,0,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="MissingLogos" Focusable="False" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="MissingText" Grid.Column="1" Style="{StaticResource Text.BodyDim}"
                                           TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"/>
                                <Button x:Name="LocateButton" Grid.Column="2" Style="{StaticResource Button.Chrome}" Click="Browse_Click"
                                        Height="32" Padding="12,0" Margin="12,0,0,0" ToolTip="Point Origin at a launcher's folder"
                                        AutomationProperties.Name="Locate folder">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                                              Margin="0,0,7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="Locate folder" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Choose what to import -->
                <ItemsControl x:Name="PickList" Style="{StaticResource Import.List}" Visibility="Collapsed"/>

                <!-- The older pages, in a narrower column beside the title: what to bring + versions, one version, review,
                     whose settings, one setup, details. -->
                <Grid x:Name="Legacy" MaxWidth="720" HorizontalAlignment="Left" Visibility="Collapsed">
                    <ItemsControl x:Name="VersionsList" Style="{StaticResource Import.List}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="VersionList" Style="{StaticResource Import.List}" Visibility="Collapsed"/>

                    <Grid x:Name="ReviewPane" Visibility="Collapsed">
                        <ItemsControl x:Name="ReviewList" Style="{StaticResource Import.List}"/>
                        <StackPanel x:Name="ReviewPlanning" Orientation="Horizontal" Margin="2,12,16,0"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                            <Path Data="{StaticResource Icon.Loading}" Style="{StaticResource Icon.Base}"
                                  Width="14" Height="14" Stroke="{StaticResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ReviewSpin"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="Checking what can come over..." Style="{StaticResource Social.Quiet}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Behind a back arrow: whose settings, one setup, the details. -->
                    <Grid x:Name="PageGrid" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="SingleTop" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="VERSION" Style="{StaticResource Social.Section}" Margin="2,0,0,6"/>
                            <ComboBox x:Name="TargetBox" Tag="Pick a version" MinHeight="36" Padding="12,6,30,6"
                                      SelectionChanged="TargetBox_SelectionChanged" AutomationProperties.Name="Origin version"/>
                            <TextBlock x:Name="TargetNote" Style="{StaticResource Import.Warning}" Margin="2,8,0,0"
                                       Visibility="Collapsed"/>
                            <!-- What this setup brings: the same switches as its version's page (one choice per version). -->
                            <TextBlock Text="WHAT TO BRING" Style="{StaticResource Social.Section}" Margin="2,14,0,6"/>
                            <ContentControl x:Name="SingleBring" Focusable="False" IsTabStop="False"/>
                        </StackPanel>
                        <ItemsControl x:Name="PageList" Grid.Row="1" Style="{StaticResource Import.List}"/>
                        <StackPanel x:Name="PlanningRow" Grid.Row="1" Orientation="Horizontal" Margin="2,6,16,0"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                            <Path x:Name="PlanSpinner" Data="{StaticResource Icon.Loading}" Style="{StaticResource Icon.Base}"
                                  Width="14" Height="14" Stroke="{StaticResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="PlanSpin"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="Checking what can come over..." Style="{StaticResource Social.Quiet}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Importing: the big percentage and bar, then a row per setup. -->
                <Grid x:Name="ProgressPane" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Card}"
                            Padding="20,18,20,20" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="ProgressPercent" Text="0" Style="{StaticResource Text.Poster}"
                                               FontSize="48" LineHeight="52"/>
                                    <TextBlock Text="%" Style="{StaticResource Text.Poster}" FontSize="22" LineHeight="26"
                                               VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,0,0,0">
                                    <TextBlock x:Name="ProgressSetup" Style="{StaticResource Text.Body}" TextAlignment="Right"
                                               HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource Text.Caption}" TextAlignment="Right"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="ProgressTrack" Height="6" Margin="0,16,0,0" Background="{StaticResource Brush.ProgressTrack}"
                                    CornerRadius="{StaticResource Radius.Bar}" SizeChanged="ProgressTrack_SizeChanged">
                                <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource Brush.Acc}"
                                        CornerRadius="{StaticResource Radius.Bar}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="ProgressList" Grid.Row="1" Style="{StaticResource Import.List}"/>
                </Grid>

                <!-- Done -->
                <ScrollViewer x:Name="DonePane" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0,0,8,0" Margin="-3,-3,-3,0" Visibility="Collapsed">
                    <StackPanel Margin="3">
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Card}" Padding="32,28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- The mark, with a green check badge on its corner: it worked. -->
                                <Grid Width="96" Height="96" Margin="0,0,32,0" VerticalAlignment="Center">
                                    <controls:OriginMark Width="88" Height="88" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Background="{StaticResource Brush.Success}"
                                            BorderBrush="{StaticResource Brush.Card}" BorderThickness="3">
                                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                                              StrokeThickness="2.6" Stroke="{StaticResource Brush.TextOnAccent}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IMPORT FINISHED" Style="{StaticResource Text.Eyebrow}"
                                               Foreground="{StaticResource Brush.Success}"/>
                                    <TextBlock x:Name="DoneTitle" Text="YOU'RE ALL SET" Style="{StaticResource Text.Poster}"
                                               Margin="0,6,0,14" TextTrimming="None" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="DoneStats" Focusable="False" Margin="0,0,-8,0"
                                                  ItemTemplate="{StaticResource Import.StatBox}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid x:Name="DoneStatsGrid" Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DoneProfilesTitle" Text="NEW PROFILES" Style="{StaticResource Text.Eyebrow}"
                                   Margin="0,24,0,10"/>
                        <ItemsControl x:Name="DoneProfiles" Focusable="False" Margin="0,0,-8,0"
                                      ItemTemplate="{StaticResource Import.ProfileCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel x:Name="DoneNotes" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Nothing changed: the reason is the page. -->
                <Border x:Name="FailedPane" Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Card}"
                        BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1"
                        Padding="24,20" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="FailedBadge" Width="32" Height="32" CornerRadius="16" Background="{StaticResource Brush.Danger}"
                                Margin="0,0,16,0" VerticalAlignment="Top">
                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                                  StrokeThickness="2.6" Stroke="{StaticResource Brush.TextOnAccent}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FailedTitle" Text="Import failed" Style="{StaticResource Social.Name}" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Danger}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="FailedReason" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer: what is ready on the left, the page's buttons on the right. -->
            <Grid x:Name="Footer" Grid.Row="3" Margin="0,18,0,0" MinHeight="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterNote" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextDim}"
                           TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FooterSecondary" Style="{StaticResource Button.Secondary}" Height="44" Padding="22,0"
                            Margin="0,0,10,0" Click="FooterSecondary_Click"/>
                    <Button x:Name="FooterPrimary" Style="{StaticResource Button.Primary}" Height="44" Padding="22,0"
                            MinWidth="120" Click="FooterPrimary_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PrimaryIcon" Data="{StaticResource Icon.Import}" Style="{StaticResource Icon.Base}"
                                  Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="PrimaryText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <controls:ConfirmOverlay x:Name="Confirm"/>
    </Grid>
</UserControl>
