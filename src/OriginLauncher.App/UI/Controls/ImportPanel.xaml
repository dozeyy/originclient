<UserControl x:Class="OriginLauncher.App.UI.Controls.ImportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <!-- Import from another Minecraft launcher: Find -> Review -> Importing -> Done,
         one modal card in MainWindow (like the sign-in card). Workbench tokens only:
         every colour, size and corner comes from Theme/. The lists and tables are
         built in code (ImportPanel.xaml.cs) from the engine's scan and plan. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,18,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StepText" Text="STEP 1 OF 3" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock x:Name="TitleText" Text="Import from another launcher" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource Button.Chrome}" Width="32" Height="32" Padding="6"
                    Click="CloseButton_Click" ToolTip="Close" AutomationProperties.Name="Close import">
                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Base}"
                      Width="12" Height="12" Stroke="{StaticResource Brush.TextDim}"/>
            </Button>
        </Grid>
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Brush.SoftStroke}"/>

        <!-- Body: one page per step -->
        <Grid Grid.Row="1">

            <!-- FIND -->
            <Grid x:Name="FindPage">
                <!-- Scanning: a spinner line and skeleton rows, never an empty box -->
                <StackPanel x:Name="ScanningPanel" Margin="24,20,24,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path x:Name="ScanSpinner" Data="{StaticResource Icon.Loading}" Style="{StaticResource Icon.Base}"
                              Width="16" Height="16" Stroke="{StaticResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ScanSpin"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="Looking for other launchers..." Style="{StaticResource Text.BodyDim}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Height="52" Margin="0,0,0,8" Opacity="0.6" Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Row}"/>
                    <Border Height="52" Margin="0,0,0,8" Opacity="0.45" Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Row}"/>
                    <Border Height="52" Opacity="0.3" Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Row}"/>
                </StackPanel>

                <!-- Empty: nothing found -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Margin="24,0" VerticalAlignment="Center"
                            HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="No other launchers found" Style="{StaticResource Text.H2}" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyNote"
                               Text="Origin looked for the Minecraft launcher, Prism, Modrinth and CurseForge. If yours is somewhere else, pick its folder."
                               Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- The list, grouped by launcher (built in code) -->
                <ScrollViewer x:Name="FindScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Margin="24,16,12,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock x:Name="FindNote" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel x:Name="FindList"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- REVIEW -->
            <Grid x:Name="ReviewPage" Visibility="Collapsed">
                <ScrollViewer x:Name="ReviewScroll" VerticalScrollBarVisibility="Auto" Margin="24,16,12,0" Padding="0,0,12,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <!-- Source -->
                        <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FROM" Style="{StaticResource Text.Eyebrow}"/>
                                    <TextBlock x:Name="SourceName" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SourceDetail" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="ChooseAnotherButton" Grid.Column="1" Content="Choose another" VerticalAlignment="Center"
                                        Style="{StaticResource Button.Chrome}" Padding="12,6" MinHeight="32" Click="ChooseAnother_Click"
                                        Foreground="{StaticResource Brush.Accent}"/>
                            </Grid>
                        </Border>

                        <!-- Target -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Into Origin" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="TargetBox" Grid.Column="1" MinWidth="170" MinHeight="32" Padding="12,5"
                                      SelectionChanged="TargetBox_SelectionChanged" AutomationProperties.Name="Origin version"/>
                            <TextBlock x:Name="TargetNote" Grid.Column="2" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </Grid>

                        <!-- While the plan is being worked out -->
                        <StackPanel x:Name="PlanningPanel" Orientation="Horizontal" Margin="0,22,0,0">
                            <Path x:Name="PlanSpinner" Data="{StaticResource Icon.Loading}" Style="{StaticResource Icon.Base}"
                                  Width="16" Height="16" Stroke="{StaticResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="PlanSpin"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="PlanningText" Text="Checking what can come over..." Style="{StaticResource Text.BodyDim}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- The plan: counts, attention, details -->
                        <StackPanel x:Name="PlanPanel" Visibility="Collapsed">
                            <WrapPanel x:Name="StatsPanel" Margin="0,16,0,0"/>
                            <TextBlock x:Name="DownloadNote" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="Collapsed"/>

                            <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource Text.Eyebrow}" Margin="0,20,0,8"
                                       Foreground="{StaticResource Brush.Warning}"/>
                            <StackPanel x:Name="AttentionList"/>

                            <Button x:Name="DetailsToggle" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="0,6,12,6" MinHeight="32"
                                    Style="{StaticResource Button.Chrome}" Click="DetailsToggle_Click" Foreground="{StaticResource Brush.Accent}"
                                    AutomationProperties.Name="Review details">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="DetailsIcon" Data="{StaticResource Icon.Plus}" Style="{StaticResource Icon.Base}"
                                          Width="12" Height="12" Margin="8,0,8,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock x:Name="DetailsLabel" Text="Review details" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,8,0,8">
                                <TextBlock Text="OPTIONS" Style="{StaticResource Text.Eyebrow}" Margin="0,4,0,8"/>
                                <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}"
                                        BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14,6">
                                    <StackPanel>
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                                <TextBlock Text="Copy my single-player worlds" Style="{StaticResource Text.Body}"/>
                                                <TextBlock Text="Off by default: worlds can be very big." Style="{StaticResource Text.Caption}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="CopyWorldsToggle" Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                                          Click="Option_Click" AutomationProperties.Name="Copy my single-player worlds"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource Brush.SoftStroke}"/>
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                                <TextBlock Text="Copy unused packs" Style="{StaticResource Text.Body}"/>
                                                <TextBlock Text="Also bring resource and shader packs you were not using." Style="{StaticResource Text.Caption}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="CopyPacksToggle" Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                                          Click="Option_Click" AutomationProperties.Name="Copy unused packs"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource Brush.SoftStroke}"/>
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                                <TextBlock Text="Keep my current Origin settings" Style="{StaticResource Text.Body}"/>
                                                <TextBlock Text="Where Origin already has a settings file, keep it instead of replacing it." Style="{StaticResource Text.Caption}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="KeepSettingsToggle" Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                                          Click="Option_Click" AutomationProperties.Name="Keep my current Origin settings"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource Brush.SoftStroke}"/>
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                                <TextBlock Text="Replace server list" Style="{StaticResource Text.Body}"/>
                                                <TextBlock Text="Use the old server list even if Origin already has one (the old Origin list is saved)." Style="{StaticResource Text.Caption}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="ReplaceServersToggle" Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                                          Click="Option_Click" AutomationProperties.Name="Replace server list"/>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource Brush.SoftStroke}"/>
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                                <TextBlock Text="Replace existing caches" Style="{StaticResource Text.Body}"/>
                                                <TextBlock Text="Distant Horizons and Voxy caches: replace ones Origin already has (the old ones are saved)." Style="{StaticResource Text.Caption}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="ReplaceCachesToggle" Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                                          Click="Option_Click" AutomationProperties.Name="Replace existing caches"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="EVERY ITEM" Style="{StaticResource Text.Eyebrow}" Margin="0,18,0,4"/>
                                <TextBlock Text="Nothing is dropped without a reason. Each line says what happens and why."
                                           Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="TablesPanel"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- IMPORTING -->
            <Grid x:Name="ImportingPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                    <TextBlock x:Name="ProgressTitle" Text="Importing..." Style="{StaticResource Text.H2}" TextAlignment="Center"/>
                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource Text.BodyDim}" TextAlignment="Center" Margin="0,10,0,18"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ProgressTrack" Height="8" Background="{StaticResource Brush.CardAlt}"
                            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                            SizeChanged="ProgressTrack_SizeChanged">
                        <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Background="{StaticResource Brush.Accent}"
                                CornerRadius="{StaticResource Radius.Control}"/>
                    </Border>
                    <TextBlock x:Name="ProgressPercent" Text="0%" Style="{StaticResource Text.Caption}" TextAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Keep Origin open. If you cancel, everything is put back the way it was."
                               Style="{StaticResource Text.Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0"/>
                </StackPanel>
            </Grid>

            <!-- DONE -->
            <Grid x:Name="DonePage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,16,12,0" Padding="0,0,12,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock x:Name="DoneHeadline" Style="{StaticResource Text.H2}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DoneNote" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DoneError" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.Danger}" Visibility="Collapsed"/>
                        <StackPanel x:Name="DoneSections" Margin="0,8,0,0"/>
                        <Button x:Name="OpenLogButton" Margin="0,16,0,8" HorizontalAlignment="Left" Padding="0,6,12,6" MinHeight="32"
                                Style="{StaticResource Button.Chrome}" Click="OpenLog_Click" Foreground="{StaticResource Brush.Accent}"
                                AutomationProperties.Name="Open import log">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                                      Margin="8,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Open import log" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterNote" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BrowseButton" Content="Browse for a folder..." Style="{StaticResource Button.Secondary}"
                            Padding="16,7" MinHeight="32" Margin="0,0,10,0" Click="Browse_Click"/>
                    <Button x:Name="SecondaryButton" Content="Cancel" Style="{StaticResource Button.Secondary}"
                            Padding="16,7" MinHeight="32" Margin="0,0,10,0" Click="Secondary_Click"/>
                    <Button x:Name="PrimaryButton" Content="Continue" Style="{StaticResource Button.Primary}"
                            Padding="22,7" MinHeight="32" MinWidth="110" Click="Primary_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <controls:ConfirmOverlay x:Name="Confirm" Grid.RowSpan="3"/>
    </Grid>
</UserControl>
