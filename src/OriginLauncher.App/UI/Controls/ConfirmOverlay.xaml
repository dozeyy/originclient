<UserControl x:Class="OriginLauncher.App.UI.Controls.ConfirmOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Visibility="Collapsed"
             IsHitTestVisible="True"
             KeyboardNavigation.TabNavigation="Contained"
             KeyboardNavigation.DirectionalNavigation="Contained">

    <!-- Modal confirm dialog in the launcher's own visual language (spec 11.10: Surface fill, Radius.Lg, pad 24,
         at most 440 wide, Shadow.Overlay, over the scrim), not a Win32 MessageBox. Footer right-aligned: the
         secondary (cancel) first, then the primary or danger button, both lg 36 and at least 96 wide. Awaited via
         ShowAsync; Primary returns true, Secondary/Esc returns false; the safe action holds the focus. -->
    <Border Background="{StaticResource Brush.Scrim}">
        <Border Style="{StaticResource Surface.DialogSheet}" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="440" Margin="24">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.BodyDim}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource Button.Secondary}"
                            MinWidth="96" Margin="0,0,8,0" Click="SecondaryButton_Click"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource Button.Primary.Medium}"
                            MinWidth="96" Click="PrimaryButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
