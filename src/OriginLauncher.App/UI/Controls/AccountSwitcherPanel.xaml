<UserControl x:Class="OriginLauncher.App.UI.Controls.AccountSwitcherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:OriginLauncher.App.Core.Models"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- An account: the shared row (Theme/Surfaces.xaml); the active one is framed in the family accent
             (an indicator, never text). -->
        <!-- Same proportions as the top bar's pill: the head is the row's height minus 8 (Size.RowHead 40 in a 48 row), a
             4 px inset all round (1 edge + 3 padding), and the row's corner is Radius.Md, so the head's is that minus 4
             (Radius.Xs). -->
        <Style x:Key="AccountRow" TargetType="Border" BasedOn="{StaticResource Surface.Row}">
            <Setter Property="Padding" Value="{StaticResource Padding.AccountRow}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The row's choose action: a real Button (Tab reaches it, Enter/Space picks it, a screen reader names it), drawn
             bare so the row's own surface (AccountRow, which lifts on hover) is the look. The keyboard ring is the
             Radius.Md control ring, sitting just outside the 3 px row inset. -->
        <Style x:Key="AccountChoose" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeepLine" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Style="{StaticResource Drawer.Header}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Accounts" Style="{StaticResource Drawer.Title}"/>
                <TextBlock Text="One game window per account" Style="{StaticResource Drawer.Subtitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Social.Icon}" VerticalAlignment="Top"
                    Click="CloseButton_Click" ToolTip="Close" AutomationProperties.Name="Close">
                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
        </Grid>

        <!-- Account list / empty state, the add button, and what an account keeps -->
        <StackPanel Grid.Row="1" Margin="16,0">
            <TextBlock x:Name="EmptyStateText"
                       Text="No accounts added yet. Add a Microsoft account to sign in."
                       Style="{StaticResource Text.BodyDim}" Margin="4,0,4,12"
                       TextWrapping="Wrap" VerticalAlignment="Top"/>

            <ItemsControl x:Name="AccountList" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MinecraftAccount}">
                        <!-- Choose (the whole row but the trash) and Remove are sibling buttons, never nested, so a click on
                             the trash can't also switch to the account. -->
                        <Border Style="{StaticResource AccountRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource AccountChoose}" Click="AccountRow_Click"
                                        AutomationProperties.Name="{Binding ChooseLabel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:PlayerHead Grid.Column="0" Width="{StaticResource Size.RowHead}" Height="{StaticResource Size.RowHead}" Margin="0,0,12,0"
                                                             Crisp="True" CornerRadius="{StaticResource Radius.Xs}"
                                                             Uuid="{Binding Id}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel>
                                                <!-- Only a half-added account carries a badge; signed-in accounts show just the name. -->
                                                <controls:TrackedText DockPanel.Dock="Right" Tracking="0.12" FontSize="{StaticResource FontSize.Label}" FontWeight="Bold"
                                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                                      Text="PENDING" Foreground="{StaticResource Brush.Hue.Gold}"
                                                                      Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Gamertag}" Style="{StaticResource Text.BodyStrong}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}"/>
                                        </StackPanel>
                                        <controls:TrackedText Grid.Column="2" Text="ACTIVE" Tracking="0.16"
                                                              FontSize="{StaticResource FontSize.Label}" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"
                                                              VerticalAlignment="Center" Margin="12,0,2,0"
                                                              Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Button>
                                <!-- Remove (same trash button as a Mods page row): asks first, then deletes this account's
                                     sign-in from the launcher; its worlds and settings stay on disk. -->
                                <Button Grid.Column="1" Style="{StaticResource Social.Icon}" Margin="8,0,4,0"
                                        Click="RemoveButton_Click" ToolTip="Remove account"
                                        AutomationProperties.Name="{Binding RemoveLabel}">
                                    <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource Icon.Small}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="AddAccountButton" Style="{StaticResource Button.Primary.Medium}" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    AutomationProperties.Name="Add Microsoft account"
                    Click="AddAccountButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Icon.Small}"
                          Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="Add Microsoft account" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- What an account keeps (CLAUDE.md: settings, worlds and servers per account; mods per version). -->
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Lg}"
                    Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <controls:TrackedText Text="EACH ACCOUNT KEEPS ITS OWN" Tracking="0.16"
                                          FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"
                                          HorizontalAlignment="Left" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,12">
                        <Path Data="{StaticResource Icon.Globe}" Style="{StaticResource Icon.Small}"
                              Margin="0,0,12,0" Stroke="{StaticResource Brush.Text}"/>
                        <TextBlock Text="Worlds, servers and settings" Style="{StaticResource KeepLine}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Path Data="{StaticResource Icon.Account}" Style="{StaticResource Icon.Small}"
                              Margin="0,0,12,0" Stroke="{StaticResource Brush.Text}"/>
                        <TextBlock Text="Game window, so several can play at once" Style="{StaticResource KeepLine}"/>
                    </DockPanel>
                    <DockPanel>
                        <Path Data="{StaticResource Icon.Jar}" Style="{StaticResource Icon.Small}"
                              Margin="0,0,12,0" Stroke="{StaticResource Brush.Text}"/>
                        <TextBlock Text="Mods stay shared per version" Style="{StaticResource KeepLine}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Sign-in error -->
        <TextBlock Grid.Row="2" x:Name="ErrorText" Style="{StaticResource Text.Body}"
                   Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"
                   Margin="16,12,16,16" Visibility="Collapsed"/>

        <!-- Remove's "are you sure" (the Friends drawer's confirm, over this drawer only). -->
        <controls:ConfirmOverlay x:Name="Confirm" Grid.RowSpan="4"/>

    </Grid>
</UserControl>
