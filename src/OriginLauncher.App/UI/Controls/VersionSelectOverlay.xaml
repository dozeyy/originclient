<UserControl x:Class="OriginLauncher.App.UI.Controls.VersionSelectOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d"
             Visibility="Collapsed" Focusable="True">

    <UserControl.Resources>
        <!-- A family tile is a ListBoxItem (selection on click is built in). The
             chrome is stripped; the template paints the tile: a 16:9 thumb in grey
             that turns to colour on hover / selection, a 3 px bar in the family's
             own accent, then the range and the name. Hover lifts it 4 px. -->
        <Style x:Key="FamilyItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Card}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Tile" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift"/>
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="{StaticResource Radius.Md}" ClipToBounds="True"
                                    Background="{StaticResource Brush.Bg}" Height="{Binding ThumbHeight}">
                                <Grid>
                                    <Image Source="{Binding Grey}" Stretch="UniformToFill"/>
                                    <Image x:Name="Colour" Source="{Binding Colour}" Stretch="UniformToFill" Opacity="0"/>
                                    <!-- The number set into the art (11.6): bottom-left, in a corner shade chosen for this art. -->
                                    <controls:VersionCardNumeral Text="{Binding Number}" Range="{Binding ArtRange}" Strength="{Binding ScrimStrength}" Reach="{Binding ScrimReach}"/>
                                    <Rectangle x:Name="Bar" Height="3" VerticalAlignment="Bottom" Fill="{Binding Accent}" Opacity="0"/>
                                    <Border x:Name="CurrentTag" Visibility="{Binding CurrentVisibility}" Background="{StaticResource Brush.ScrimMid}"
                                            CornerRadius="{StaticResource Radius.Xs}" Padding="6,3"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                        <controls:TrackedText Text="PLAYING" Tracking="0.12" FontSize="{StaticResource FontSize.Label}" FontWeight="Bold"
                                                              Foreground="{StaticResource Brush.Text}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- The range moves into the art on cards wide enough for it (RangeInArt); otherwise it stays here. -->
                            <TextBlock Grid.Row="1" Text="{Binding Range}" Visibility="{Binding RangeBelowVisibility}" Margin="0,8,0,0" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"/>
                            <!-- Wraps to a second line before it is cut (tiles narrow to ~107 px at the smallest window). -->
                            <TextBlock Grid.Row="2" Text="{Binding Name}" Margin="0,2,0,16" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="{StaticResource LineHeight.Caption}" MaxHeight="32"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-4" Duration="{StaticResource Motion.Scene}"/>
                                            <DoubleAnimation Storyboard.TargetName="Colour" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Scene}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Scene}"/>
                                            <!-- No To: settles on its base value, which the
                                                 IsSelected trigger sets (1 selected, 0 not). Hover is colour + lift
                                                 only: the accent bar means "picked". -->
                                            <DoubleAnimation Storyboard.TargetName="Colour" Storyboard.TargetProperty="Opacity" Duration="{StaticResource Motion.Scene}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Colour" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A version chip: a radio in the ghost-outline look of the other buttons (Size.ControlSm tall, so the
             1.21.x family fits one row). Checked = a soft accent wash with an accent edge. -->
        <Style x:Key="VersionChip" TargetType="RadioButton">
            <Setter Property="Height" Value="{StaticResource Size.ControlSm}"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Body" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Stroke}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Md}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Brush.StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- A whole-window view over Home's art (the art still follows the pick live behind a
         dim). It starts below the 56 px top bar, which stays on top so Minimize / Close keep
         working. No header: the only chrome is the X at the top right. -->
    <Grid x:Name="Scene">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="OverlayTranslate"/>
        </Grid.RenderTransform>
        <!-- Clicking outside the content column closes it. -->
        <Border Background="{StaticResource Brush.PageDim}" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

        <ScrollViewer x:Name="Body" Margin="0,56,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" IsTabStop="False">
            <!-- MinHeight = the viewport, so the column centres vertically and only scrolls when it cannot fit. -->
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel x:Name="Column" VerticalAlignment="Center" MaxWidth="1280" Margin="32,56,32,24"
                            Background="Transparent">
                    <!-- The families, newest first, in one row that fills the width. -->
                    <ListBox x:Name="FamilyList" Margin="0,0,-8,0" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource FamilyItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionChanged="FamilyList_SelectionChanged"
                             AutomationProperties.Name="Version families">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- The family's versions as chips, then Play. -->
                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Md}" Padding="20,16,20,12" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:TrackedText x:Name="ChipsLabel" Text="TRICKY TRIALS" Tracking="0.16"
                                                  FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                                  Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                            <WrapPanel Grid.Column="1" x:Name="ChipsPanel" VerticalAlignment="Center"
                                       AutomationProperties.Name="Version"/>
                            <Button Grid.Column="2" x:Name="LaunchButton" Style="{StaticResource Button.Primary.Medium}"
                                    Margin="12,0,0,4" VerticalAlignment="Center" Click="Launch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M7,5 L19,12 L7,19 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="12" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="LaunchText" Text="Play 1.21.1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- The one control left from the old header: a floating X in the corner, just under the bar. -->
        <Button x:Name="CloseButton" Style="{StaticResource Social.Icon}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,24,0"
                Click="Close_Click" AutomationProperties.Name="Close">
            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
    </Grid>
</UserControl>
