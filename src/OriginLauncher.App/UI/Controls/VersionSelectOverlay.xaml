<UserControl x:Class="OriginLauncher.App.UI.Controls.VersionSelectOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OriginLauncher.App.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d"
             Visibility="Collapsed" Focusable="True">

    <UserControl.Resources>
        <!-- The sheet's own scroll bars are the launcher's thin ones (the default grey track showed as a white bar down
             the right edge whenever the sheet had to scroll). -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>

        <!-- Step 1: a family card is a ListBoxItem. The chrome is stripped; the template paints the card (Workbench
             "Choosing a version"): the family's art in full colour on top, then the range in bold, the family name, and
             a quiet status line (a dot and words, no bubble). Hover lifts it 4 px. The pick (the family holding the
             player's version) wears the emerald ring at a 2 px gap and a SELECTED capsule on the art; keyboard focus
             draws the same ring in the softer accent line (Focus.Card). Clicking a card opens its family (FamilyItem_Click). -->
        <Style x:Key="FamilyItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Card}"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="FamilyItem_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Tile" Background="Transparent" RenderTransformOrigin="0.5,0.5" Width="{Binding CardWidth}">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Ring" Margin="-4" CornerRadius="{StaticResource Radius.Ring.Lg}" BorderThickness="2"
                                    BorderBrush="{StaticResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <!-- A local brush, so the hover fades its colour with the lift instead of switching it. -->
                            <Border x:Name="Face" BorderBrush="{StaticResource Brush.SoftStroke}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Color.Card}"/>
                                </Border.Background>
                                <StackPanel>
                                    <!-- The art is a brush on a rounded border: the corners are the card's, with no clip to pay for. -->
                                    <Border Height="{Binding ThumbHeight}" CornerRadius="{StaticResource Radius.Lg.Top}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Colour}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <!-- SELECTED: an even capsule (Padding.Capsule.Sm, ui:Capsule.On), caps centred in it. -->
                                        <Border x:Name="Tag" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                Padding="{StaticResource Padding.Capsule.Sm}" ui:Capsule.On="True"
                                                Background="{StaticResource Brush.ScrimMid}">
                                            <TextBlock Text="SELECTED" Style="{StaticResource Text.Capsule}" Foreground="{StaticResource Brush.Text}"/>
                                        </Border>
                                    </Border>
                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Text="{Binding Range}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="{StaticResource LineHeight.Title}"/>
                                        <TextBlock Text="{Binding Name}" Margin="0,2,0,0" Style="{StaticResource Text.Caption}"/>
                                        <!-- "2 of 10 installed": a dot and quiet words. Nothing until every release of the family has been read
                                             (the line keeps its height meanwhile, so the cards never jump). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding BadgeVisibility}">
                                            <Ellipse Width="{StaticResource Size.Dot}" Height="{StaticResource Size.Dot}" Fill="{Binding BadgeDot}"
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BadgeText}" Style="{StaticResource Text.CaptionDim}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-4" Duration="{StaticResource Motion.HoverIn}"/>
                                            <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Background.Color"
                                                            To="{StaticResource Color.CardAlt}" Duration="{StaticResource Motion.HoverIn}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Hover}"/>
                                            <ColorAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Background.Color"
                                                            Duration="{StaticResource Motion.Hover}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step 2's dropdown item: the version, and a quiet emerald dot when it is already on disk. No words about
             downloading (Will, 2026-10-25): the launcher installs whatever Play needs on its own. -->
        <DataTemplate x:Key="ReleaseItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Version}" VerticalAlignment="Center"/>
                <Ellipse Width="{StaticResource Size.Dot}" Height="{StaticResource Size.Dot}" Fill="{StaticResource Brush.Hue.Emerald}"
                         Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding DotVisibility}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- A whole-window view over Home's art: the page dims to the scrim and a sheet sits under the 56 px top bar
         (which stays on top, so Minimize / Close keep working). The sheet's width follows the window (SizeCards):
         about 80 % of it, between the token min and max, and its cards keep their 16:9 art. Step 2 is one panel over
         the cards: the clicked card grows into it, so the sheet itself never changes size between the steps. -->
    <Grid x:Name="Scene">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="OverlayTranslate"/>
        </Grid.RenderTransform>
        <!-- Clicking outside the sheet closes it. -->
        <Border Background="{StaticResource Brush.Scrim}" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

        <Grid x:Name="Stage" Margin="0,56,0,0">
            <!-- Centred in the free band, as tall as the sheet and no taller: it scrolls only when the window is shorter
                 than the sheet. (It used to be stretched to a MinHeight bound to its own viewport; that value lagged a pass
                 behind a resize and a bar flashed up on the right edge.) -->
            <ScrollViewer x:Name="Body" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" IsTabStop="False">
                <!-- The sheet's shadow is its own still layer behind it, drawn once and cached (BitmapCache), not an
                     Effect on the sheet: an Effect re-renders the whole sheet (art, text, cards) through the blur on every
                     frame anything inside it moves, so each card hover, the panel's grow and the entrance ran at a
                     fraction of the frame rate and hover lagged behind the mouse (Will, 2026-10-25). -->
                <Grid HorizontalAlignment="Center" Margin="24,8,24,16">
                <Border x:Name="SheetShadow" Background="{StaticResource Brush.Sheet}" CornerRadius="{StaticResource Radius.Dialog}"
                        Effect="{StaticResource Shadow.Overlay}" IsHitTestVisible="False"/>
                <Border x:Name="Sheet" Style="{StaticResource Surface.Dialog}" Background="{StaticResource Brush.Sheet}"
                        Effect="{x:Null}" MaxWidth="{StaticResource Size.Sheet.Max}">
                    <Grid x:Name="SheetContent">
                        <!-- ===== Step 1: the families ===== -->
                        <Grid x:Name="FamiliesPane">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Choose a version" Style="{StaticResource Text.Heading}"/>
                                    <TextBlock x:Name="FamiliesCaption" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <Button x:Name="CloseButton" Style="{StaticResource Social.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="Close_Click" AutomationProperties.Name="Close">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                            <!-- Four across, two down. The panel keeps 4 px of room round the cards (8 above, for the hover
                                 lift) so the selected ring (4 px outside its card) is never clipped by the list's viewport;
                                 the list's negative margins give that room back, and the right and bottom ones also cancel
                                 the cards' own 12 px gap. Its own template: the stock ListBox template wraps the list in a
                                 border with a hard-coded 1 px padding, which made the grid 2 px wider than its slot. -->
                            <ListBox x:Name="FamilyList" Grid.Row="1" Margin="-4,-8,-16,-16" Padding="0" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource FamilyItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Version families">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" Margin="4,8,4,4"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>

                        <!-- ===== Step 2: one family, expanded ===== -->
                        <!-- Under the panel, over the faded cards: a click anywhere off the panel closes the picker, like the
                             backdrop outside the sheet. -->
                        <Border x:Name="PanelCatcher" Background="Transparent" Visibility="Collapsed"
                                MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>
                        <!-- The clicked card, grown (Will, 2026-10-25): it scales and moves out of its own grid slot into
                             this centred panel (ExpandFrom), the other cards fade back. Back, the family's art, range and
                             name, and ONE compact dropdown of its releases, newest first, on "Choose a version" until one is picked. Picking a release in it picks the
                             version, and that is all; a click off the panel or Esc goes back to Home. -->
                        <Border x:Name="FamilyPanel" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Lg}" Padding="16" RenderTransformOrigin="0,0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PanelScale"/>
                                    <TranslateTransform x:Name="PanelShift"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <StackPanel x:Name="FamilySide">
                                <Button x:Name="BackButton" Style="{StaticResource Button.Chrome}" HorizontalAlignment="Left" Margin="-8,-4,0,8"
                                        Padding="8,0,12,0" Click="Back_Click" AutomationProperties.Name="All versions">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Back}" Style="{StaticResource Icon.Small}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                                        <TextBlock Text="All versions" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- The art is a brush on a rounded border: the corners are the panel's, with no clip to pay for. -->
                                <Border x:Name="PanelArt" Height="{Binding DetailArtHeight}" CornerRadius="{StaticResource Radius.Md}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Colour}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding Range}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <ComboBox x:Name="ReleaseBox" Style="{StaticResource Input.ComboBox}" Margin="0,16,0,0" Tag="Choose a version"
                                          ItemContainerStyle="{StaticResource Input.ComboBoxItem}" ItemTemplate="{StaticResource ReleaseItem}"
                                          SelectionChanged="ReleaseBox_SelectionChanged"
                                          AutomationProperties.Name="Version"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
