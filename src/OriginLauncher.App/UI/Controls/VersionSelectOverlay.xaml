<UserControl x:Class="OriginLauncher.App.UI.Controls.VersionSelectOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d"
             Visibility="Collapsed" Focusable="True">

    <UserControl.Resources>
        <controls:VersionChipsConverter x:Key="VersionChips"/>
        <controls:UpperCaseConverter x:Key="Upper"/>

        <!-- A card is a ListBoxItem: selection-on-click is built in and reliable,
             which a Border+MouseLeftButtonUp was not. The item chrome is stripped;
             the DataTemplate paints the whole card. -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A version chip inside a card (website .vcard li). -->
        <DataTemplate x:Key="VersionChipTemplate">
            <Border Style="{StaticResource Chip}" Margin="0,0,5,0" Padding="7,3">
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Chip}"/>
            </Border>
        </DataTemplate>

        <!-- Grid card (3-column landing): the family's artwork on top, then the
             website's version card: title, tagline, version chips. Hover brightens
             the stroke, keyboard focus is the 2 px emerald frame. -->
        <DataTemplate x:Key="GridCardTemplate">
            <Grid x:Name="CardRoot" Width="300" Height="176">
                <Border Background="{StaticResource Brush.PanelGlass}"
                        BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"/>
                <Border x:Name="HoverEdge" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}" Opacity="0"/>
                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="1,1,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill" AlignmentY="Center"/>
                        </Border.Background>
                        <Border CornerRadius="1,1,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource Color.InkFade0}" Offset="0.2"/>
                                    <GradientStop Color="{StaticResource Color.CardFade95}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="14,4,14,10">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}"/>
                        <TextBlock Text="{Binding Tagline, Converter={StaticResource Upper}}"
                                   Style="{StaticResource Text.Eyebrow}" Margin="0,3,0,8"/>
                        <ItemsControl ItemsSource="{Binding Versions, Converter={StaticResource VersionChips}}"
                                      ItemTemplate="{StaticResource VersionChipTemplate}"
                                      IsHitTestVisible="False" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                <Border x:Name="FocusFrame" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2"
                        CornerRadius="{StaticResource Radius.Card}" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="HoverEdge" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="FocusFrame" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Compact left-stack row (detail view): thumbnail, title, a selected
             wash with the emerald frame. -->
        <DataTemplate x:Key="StackCardTemplate">
            <Grid x:Name="StackRoot" Height="56">
                <Border x:Name="Fill" Background="{StaticResource Brush.PanelGlass}"
                        BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Row}"/>
                <Border x:Name="HoverEdge" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Row}" Opacity="0"/>
                <Border x:Name="SelWash" Background="{StaticResource Brush.AccentSoft}"
                        CornerRadius="{StaticResource Radius.Row}" Opacity="0"/>
                <Border x:Name="SelRing" CornerRadius="{StaticResource Radius.Row}" BorderThickness="2"
                        BorderBrush="{StaticResource Brush.Accent}" Opacity="0"/>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="1" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="SelWash" Property="Opacity" Value="1"/>
                    <Setter TargetName="SelRing" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="HoverEdge" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Version dropdown entry: the plain version string ("1.20.4"). -->
        <DataTemplate x:Key="VersionItemTemplate">
            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" MinWidth="120"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="OverlayStage" Background="{StaticResource Brush.WindowBackdrop}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="OverlayTranslate"/>
        </Grid.RenderTransform>
        <Grid Margin="36,24,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: the website's section head, eyebrow then the big line. -->
            <Grid Grid.Row="0" Margin="8,0,8,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Back-to-grid (only in detail view) -->
                <Button Grid.Column="0" x:Name="BackButton" Style="{StaticResource Button.Chrome}" Width="34" Height="34"
                        Padding="8" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"
                        Click="Back_Click" ToolTip="All versions" AutomationProperties.Name="All versions">
                    <Path Data="{StaticResource Icon.Back}" Style="{StaticResource Icon.Base}"
                          Width="16" Height="16" Stroke="{StaticResource Brush.TextDim}"/>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MINECRAFT" Style="{StaticResource Text.Eyebrow}" Margin="1,0,0,4"/>
                    <TextBlock Text="Versions" Style="{StaticResource Text.Headline}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Chrome}" Width="34" Height="34" Padding="8"
                        VerticalAlignment="Center" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Base}"
                          Width="14" Height="14" Stroke="{StaticResource Brush.TextDim}"/>
                </Button>
            </Grid>

            <!-- ===== GRID STATE ===== -->
            <Viewbox Grid.Row="1" x:Name="GridState" Stretch="Uniform" StretchDirection="DownOnly"
                     MaxWidth="1040" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ListBox x:Name="GridList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardItem}"
                         ItemTemplate="{StaticResource GridCardTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="GridList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Columns fixed at 3, rows left to UniformGrid so the
                                 grid follows the catalog instead of a hardcoded 9.
                                 Eight cards today (3/3/2): the 26 card (back
                                 2026-10-13), six Fabric families, and 1.8
                                 (Forge, back 2026-10-13) last. -->
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Viewbox>

            <!-- ===== DETAIL STATE ===== -->
            <Grid Grid.Row="1" x:Name="DetailState" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DetailSlide" X="0"/>
                </Grid.RenderTransform>

                <!-- Left: stacked cards, newest at top -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                    </ScrollViewer.Resources>
                    <ListBox x:Name="StackList" Background="Transparent" BorderThickness="0"
                             ItemTemplate="{StaticResource StackCardTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="StackList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>

                <!-- Right: the selected family's detail -->
                <Grid Grid.Column="1" x:Name="DetailPanel" Margin="28,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top: compact hero + headline info -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Smaller, crisp hero image -->
                        <Border Grid.Column="0" Width="300" Height="188" CornerRadius="{StaticResource Radius.Card}"
                                ClipToBounds="True" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding ImagePath}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <!-- Headline info -->
                        <StackPanel Grid.Column="1" Margin="24,2,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Tagline, Converter={StaticResource Upper}}"
                                       Style="{StaticResource Text.Eyebrow}"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextTrimming="None"/>
                            <TextBlock x:Name="FactsText" Style="{StaticResource Text.BodyDim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Border Style="{StaticResource Chip}"><TextBlock Text="ORIGIN UI" Style="{StaticResource Text.Chip}"/></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock Text="PERFORMANCE" Style="{StaticResource Text.Chip}"/></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock Text="SHADERS" Style="{StaticResource Text.Chip}"/></Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.TextDim}" FontSize="14" LineHeight="22"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions: a card, like the Play card on Home -->
                    <ContentControl Grid.Row="2" Style="{StaticResource Surface.Card}" Margin="0,16,0,0" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Bottom">
                                <TextBlock Text="VERSION" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="VersionDropdown" MinWidth="150" MinHeight="46" FontSize="15"
                                          ItemContainerStyle="{StaticResource Input.ComboBoxItem}"
                                          ItemTemplate="{StaticResource VersionItemTemplate}"
                                          SelectionChanged="VersionDropdown_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                <Button x:Name="LaunchButton" Content="LAUNCH" Style="{StaticResource Button.Primary}"
                                        FontSize="16" Padding="36,15" Margin="0,0,12,0" Click="Launch_Click"/>
                                <Button x:Name="ModsButton" Content="MODS" Style="{StaticResource Button.Secondary}"
                                        FontSize="16" Padding="26,15" Click="Mods_Click"
                                        ToolTip="Open this version's mods folder to add your own mods (shared by all your accounts)"/>
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
