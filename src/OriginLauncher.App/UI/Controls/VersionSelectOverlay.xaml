<UserControl x:Class="OriginLauncher.App.UI.Controls.VersionSelectOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OriginLauncher.App.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d"
             Visibility="Collapsed" Focusable="True">

    <UserControl.Resources>
        <!-- The sheet's own scroll bars are the launcher's thin ones (the default grey track showed as a white bar down
             the right edge whenever the sheet had to scroll). -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>

        <!-- Step 1: a family card is a ListBoxItem. The chrome is stripped; the template paints the card (Workbench
             "Choosing a version"): the family's art in full colour on top, then the range in bold, the family name, and
             a quiet status line (a dot and words, no bubble). Hover lifts it 4 px. The pick (the family holding the
             player's version) wears the emerald ring at a 2 px gap and a SELECTED capsule on the art; keyboard focus
             draws the same ring in the softer accent line (Focus.Card). Clicking a card opens its family (FamilyItem_Click). -->
        <Style x:Key="FamilyItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Card}"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="FamilyItem_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Tile" Background="Transparent" RenderTransformOrigin="0.5,0.5" Width="{Binding CardWidth}">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Lift"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Ring" Margin="-4" CornerRadius="{StaticResource Radius.Ring.Lg}" BorderThickness="2"
                                    BorderBrush="{StaticResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="Face" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}">
                                <StackPanel>
                                    <!-- The art is a brush on a rounded border: the corners are the card's, with no clip to pay for. -->
                                    <Border Height="{Binding ThumbHeight}" CornerRadius="{StaticResource Radius.Lg.Top}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Colour}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <!-- SELECTED: an even capsule (Padding.Capsule.Sm, ui:Capsule.Round), caps centred in it. -->
                                        <Border x:Name="Tag" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                Padding="{StaticResource Padding.Capsule.Sm}" ui:Capsule.Round="True"
                                                Background="{StaticResource Brush.ScrimMid}">
                                            <TextBlock Text="SELECTED" Style="{StaticResource Text.Capsule}" Foreground="{StaticResource Brush.Text}"/>
                                        </Border>
                                    </Border>
                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Text="{Binding Range}" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="{StaticResource LineHeight.Title}"/>
                                        <TextBlock Text="{Binding Name}" Margin="0,2,0,0" Style="{StaticResource Text.Caption}"/>
                                        <!-- "2 of 10 installed": a dot and quiet words. Nothing until every release of the family has been read
                                             (the line keeps its height meanwhile, so the cards never jump). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding BadgeVisibility}">
                                            <Ellipse Width="{StaticResource Size.Dot}" Height="{StaticResource Size.Dot}" Fill="{Binding BadgeDot}"
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BadgeText}" Style="{StaticResource Text.CaptionDim}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-4" Duration="{StaticResource Motion.Hover}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="{StaticResource Motion.Hover}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step 2: one release, a 36 px row (Size.ControlLg): the version in bold, what pressing Play will do, and a
             status capsule at the end. Rows sit in one panel with a hairline between them. Hover is a soft wash; the pick
             is the accent wash with an accent bar on its left edge; keyboard focus adds a 1 px accent line inside the row
             (a ring outside would collide with the neighbouring rows). Double-click plays. -->
        <Style x:Key="ReleaseRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="MouseDoubleClick" Handler="ReleaseRow_DoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Rectangle x:Name="Sep" Height="1" VerticalAlignment="Top" Margin="12,0" Fill="{StaticResource Brush.SoftStroke}"/>
                            <Border x:Name="Row" Height="{StaticResource Size.ControlLg}" CornerRadius="{StaticResource Radius.Sm}"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="88"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.BodyStrong}" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                                               Foreground="{Binding DetailBrush}" Margin="0,0,12,0" VerticalAlignment="Center"
                                               Visibility="{Binding StatusVisibility}"/>
                                    <!-- The status capsule (Workbench mockup): a quiet Surface.Capsule.Sm, a 10 px glyph and the caps,
                                         no outline. DOWNLOAD sits on the plain capsule fill in textDim; INSTALLED, UPDATE and FINISH
                                         are the soft-hue variants (16 % tile fill, the hue as ink). -->
                                    <Border Grid.Column="2" Style="{StaticResource Surface.Capsule.Sm}" Background="{Binding PillBackground}"
                                            VerticalAlignment="Center" Visibility="{Binding StatusVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding PillIcon}" Style="{StaticResource Icon.Base}" Stroke="{Binding PillForeground}"
                                                  Width="{StaticResource Icon.SizeCapsule}" Height="{StaticResource Icon.SizeCapsule}"
                                                  Margin="{StaticResource Margin.CapsuleIcon}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PillText}" Style="{StaticResource Text.Capsule}" Foreground="{Binding PillForeground}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Margin="0,8" CornerRadius="{StaticResource Radius.Track}"
                                    Background="{StaticResource Brush.Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.GhostHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- A whole-window view over Home's art: the page dims to the scrim and a sheet sits under the 56 px top bar
         (which stays on top, so Minimize / Close keep working). The sheet's width follows the window (SizeCards):
         about 80 % of it, between the token min and max, and its cards keep their 16:9 art. Two panes share the
         sheet's cell and crossfade; the hidden one still counts for the sheet's size, so the sheet does not jump
         between the steps. -->
    <Grid x:Name="Scene">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="OverlayTranslate"/>
        </Grid.RenderTransform>
        <!-- Clicking outside the sheet closes it. -->
        <Border Background="{StaticResource Brush.Scrim}" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

        <Grid x:Name="Stage" Margin="0,56,0,0">
            <!-- Centred in the free band, as tall as the sheet and no taller: it scrolls only when the window is shorter
                 than the sheet. (It used to be stretched to a MinHeight bound to its own viewport; that value lagged a pass
                 behind a resize and a bar flashed up on the right edge.) -->
            <ScrollViewer x:Name="Body" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" IsTabStop="False">
                <Border x:Name="Sheet" Style="{StaticResource Surface.Dialog}" Background="{StaticResource Brush.Sheet}"
                        HorizontalAlignment="Center" MaxWidth="{StaticResource Size.Sheet.Max}" Margin="24,8,24,16">
                    <Grid>
                        <!-- ===== Step 1: the families ===== -->
                        <Grid x:Name="FamiliesPane">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Choose a version" Style="{StaticResource Text.Heading}"/>
                                    <TextBlock x:Name="FamiliesCaption" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <Button x:Name="CloseButton" Style="{StaticResource Social.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="Close_Click" AutomationProperties.Name="Close">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                            <!-- Four across, two down. The panel keeps 4 px of room round the cards (8 above, for the hover
                                 lift) so the selected ring (4 px outside its card) is never clipped by the list's viewport;
                                 the list's negative margins give that room back, and the right and bottom ones also cancel
                                 the cards' own 12 px gap. Its own template: the stock ListBox template wraps the list in a
                                 border with a hard-coded 1 px padding, which made the grid 2 px wider than its slot. -->
                            <ListBox x:Name="FamilyList" Grid.Row="1" Margin="-4,-8,-16,-16" Padding="0" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource FamilyItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Version families">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" Margin="4,8,4,4"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>

                        <!-- ===== Step 2: that family's releases ===== -->
                        <Grid x:Name="ReleasesPane" Visibility="Hidden" Opacity="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SideColumn" Width="320"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Header: back to the families on the left; over the list, how many releases and what the dots mean. -->
                            <Button x:Name="BackButton" Style="{StaticResource Button.Chrome}" HorizontalAlignment="Left" Margin="0,0,0,12"
                                    Padding="8,0,12,0" Click="Back_Click" AutomationProperties.Name="All versions">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Back}" Style="{StaticResource Icon.Small}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                                    <TextBlock Text="All versions" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid Grid.Column="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReleasesLabel" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse Width="{StaticResource Size.Dot}" Height="{StaticResource Size.Dot}" Fill="{StaticResource Brush.Success}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Installed" Style="{StaticResource Text.CaptionDim}" Margin="0,0,12,0"/>
                                    <Ellipse Width="{StaticResource Size.Dot}" Height="{StaticResource Size.Dot}" Fill="{StaticResource Brush.TextMuted}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Not installed" Style="{StaticResource Text.CaptionDim}"/>
                                </StackPanel>
                                <Button x:Name="CloseButton2" Grid.Column="2" Style="{StaticResource Social.Icon}"
                                        Click="Close_Click" AutomationProperties.Name="Close">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                            <!-- The family: its art, its range, its name, what its releases added. DataContext = the family. -->
                            <StackPanel x:Name="FamilySide" Grid.Row="1" VerticalAlignment="Top">
                                <Border Height="{Binding DetailArtHeight}" CornerRadius="{StaticResource Radius.Lg}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Colour}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding Range}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                            <!-- The releases, newest first, in one panel. -->
                            <Border x:Name="ReleasePanel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Padding="4"
                                    Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Lg}">
                                <ListBox x:Name="ReleaseList" Background="Transparent" BorderThickness="0" Padding="0"
                                         ItemContainerStyle="{StaticResource ReleaseRow}" AlternationCount="1000"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="ReleaseList_SelectionChanged"
                                         AutomationProperties.Name="Releases"/>
                            </Border>
                            <!-- Bottom right: install this release without playing it, or play it. -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="InstallButton" Style="{StaticResource Button.Secondary.Medium}" Margin="0,0,8,0" Click="Install_Click">
                                    <TextBlock x:Name="InstallText" Text="Install" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="LaunchButton" Style="{StaticResource Button.Primary.Medium}" Click="Launch_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M7,5 L19,12 L7,19 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="12" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="LaunchText" Text="Play" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
