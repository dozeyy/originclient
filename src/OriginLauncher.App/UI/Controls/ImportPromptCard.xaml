<UserControl x:Class="OriginLauncher.App.UI.Controls.ImportPromptCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Visibility="Collapsed">

    <!-- The one-time first-run offer: a small card in a corner, never a modal. It stays until the player
         answers (Import opens the import panel, Not now closes it), and is never shown again. -->
    <Border Width="340" Padding="16,14,16,14"
            Background="{StaticResource Brush.PanelElevated}"
            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}"
            Effect="{StaticResource Shadow.Card}">
        <StackPanel>
            <TextBlock Text="IMPORT" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock x:Name="QuestionText" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
            <TextBlock Text="Your mods, settings and packs are copied. The old instance is not changed."
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="NotNowButton" Content="Not now" Style="{StaticResource Button.Secondary}"
                        Padding="16,6" MinHeight="32" Margin="0,0,10,0" Click="NotNow_Click"/>
                <Button x:Name="ImportButton" Content="Import" Style="{StaticResource Button.Primary}"
                        Padding="20,6" MinHeight="32" MinWidth="90" Click="Import_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
