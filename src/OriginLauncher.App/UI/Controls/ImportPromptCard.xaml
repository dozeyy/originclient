<UserControl x:Class="OriginLauncher.App.UI.Controls.ImportPromptCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d" Visibility="Collapsed">

    <!-- The one-time first-run welcome (Poster): a centred card over the dimmed Home art. It names the
         launchers it found, by their real logos, and asks one question with two answers. It stays until the
         player answers (Import opens the import drawer, Not now closes it) and is never shown again. -->
    <Grid>
        <Rectangle Fill="{StaticResource Brush.Scrim}"/>
        <Border x:Name="Card" MaxWidth="680" Margin="32,80,32,32" Padding="32,30,32,26"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Lg}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardLift"/>
            </Border.RenderTransform>
            <StackPanel>
                <controls:BrandLogo Width="{StaticResource Size.Logo.Hero}" Height="{StaticResource Size.Logo.Hero}" HorizontalAlignment="Left"/>
                <TextBlock Text="Welcome to Origin" Style="{StaticResource Text.Display}"
                           HorizontalAlignment="Left" Margin="0,16,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="QuestionText" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                           FontSize="{StaticResource FontSize.Title}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Your worlds, mods, servers and settings come over as Origin profiles. Nothing in the other launchers changes."
                           Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                           Margin="0,6,0,0"/>

                <!-- One chip per launcher with setups to bring: logo, name, how many setups. -->
                <WrapPanel x:Name="LaunchersPanel" Margin="0,18,0,0"/>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ImportButton" Style="{StaticResource Button.Primary.Medium}"
                            MinWidth="120" Click="Import_Click"
                            AutomationProperties.Name="Import everything">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Import}" Style="{StaticResource Icon.Small}"
                                  Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Import everything" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ChooseButton" Grid.Column="1" Content="Choose" Style="{StaticResource Button.Secondary}"
                            Margin="8,0,0,0" Click="Choose_Click"
                            AutomationProperties.Name="Choose what to import"/>
                    <Button x:Name="NotNowButton" Grid.Column="2" Content="Skip for now" Style="{StaticResource Button.Chrome}"
                            MinHeight="{StaticResource Size.ControlMd}" Padding="12,0" HorizontalAlignment="Right" Click="NotNow_Click"/>
                </Grid>
                <TextBlock Text="You can import later from Profiles, or the Import button at the top."
                           Style="{StaticResource Text.Caption}" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
