<UserControl x:Class="OriginLauncher.App.UI.Controls.ImportPromptCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Visibility="Collapsed">

    <!-- The one-time first-run offer. It lives in Home's banner slot (HomePage.xaml: the banner hides while
         this shows, and comes back when it is answered), the same footprint as the banner card: one question
         and two buttons, no eyebrow, no caption. It stays until the player answers (Import opens the import
         drawer, Not now closes it) and is never shown again. -->
    <Border MinHeight="96" Padding="16,12"
            Background="{StaticResource Brush.Card}"
            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="QuestionText" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextTrimming="None"/>
            <!-- A fixed 12 px under the question, so a two-line question never sits tight on the buttons. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,12,0,0">
                <Button x:Name="NotNowButton" Content="Not now" Style="{StaticResource Button.Secondary}"
                        Padding="16,0" MinHeight="32" Margin="0,0,8,0" VerticalAlignment="Center" Click="NotNow_Click"/>
                <Button x:Name="ImportButton" Content="Import" Style="{StaticResource Button.Primary}"
                        Padding="20,0" MinHeight="32" MinWidth="88" VerticalAlignment="Center" Effect="{x:Null}"
                        Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
