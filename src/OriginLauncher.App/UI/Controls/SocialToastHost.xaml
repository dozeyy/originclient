<UserControl x:Class="OriginLauncher.App.UI.Controls.SocialToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <!-- Origin-style toasts for social events (new DM, friend request, party
         invite, party warp, notices). Compact (one line of text, the action beside
         it) so they stay in the bottom-right corner, clear of the Play card:
         at most two show, newest last, with "+N more" for the rest (it opens the
         drawer). Each fades in and dismisses itself (paused on hover).
         The host has no background, so empty space never blocks a click. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Same buttons as the Friends drawer: Join is the tonal primary (Social.Join), dismiss the 32 px icon button. -->
        <Style x:Key="Toast.Join" TargetType="Button" BasedOn="{StaticResource Social.Join}"/>
        <Style x:Key="Toast.Dismiss" TargetType="Button" BasedOn="{StaticResource Social.Icon}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl x:Name="ToastList">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type controls:ToastVm}">
                    <Border Margin="0,8,0,0" Padding="12,8" Cursor="Hand"
                            Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Lg}" Effect="{StaticResource Shadow.Overlay}"
                            MouseLeftButtonUp="Toast_Click" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                         Duration="{StaticResource Motion.Scene}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Background="{StaticResource Brush.CardAlt}" CornerRadius="{StaticResource Radius.Xs}">
                                <Grid>
                                    <Border Background="{Binding Tint}" Opacity="0.2" CornerRadius="{StaticResource Radius.Xs}"/>
                                    <Path Data="{Binding Icon}" Style="{StaticResource Icon.Small}" Stroke="{Binding Tint}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding Body}">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" LineHeight="18"/>
                                <TextBlock Text="{Binding Body}" Style="{StaticResource Social.Caption}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding ActionText}" Style="{StaticResource Toast.Join}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                    Click="Action_Click"/>
                            <Button Grid.Column="3" Style="{StaticResource Toast.Dismiss}" Click="Dismiss_Click"
                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- More toasts are waiting: one press opens the drawer, where they all live. -->
        <Button x:Name="MoreButton" Style="{StaticResource Social.Action}" Margin="0,8,0,0"
                HorizontalAlignment="Right" Visibility="Collapsed"
                Click="More_Click" ToolTip="Open friends"/>
    </StackPanel>
</UserControl>
