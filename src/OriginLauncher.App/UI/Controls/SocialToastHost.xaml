<UserControl x:Class="OriginLauncher.App.UI.Controls.SocialToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <!-- Origin-style toasts for social events (new DM, friend request, party
         invite, party warp, notices). Stacked bottom-right, newest last, at
         most three; each fades in and dismisses itself (paused on hover).
         The host has no background, so empty space never blocks a click. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ItemsControl x:Name="ToastList">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type controls:ToastVm}">
                <Border Margin="0,10,0,0" Padding="14,12" Cursor="Hand"
                        Background="{StaticResource Brush.PanelElevated}"
                        BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Dialog}" Effect="{StaticResource Shadow.Card}"
                        MouseLeftButtonUp="Toast_Click" MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                     Duration="{StaticResource Motion.Scene}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Top"
                                Background="{StaticResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Swatch}">
                            <Path Data="{Binding Icon}" Style="{StaticResource Icon.Base}"
                                  Width="15" Height="15" Stroke="{StaticResource Brush.AccentHover}"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Body}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54"/>
                            <Button Content="{Binding ActionText}" Style="{StaticResource Button.Primary}"
                                    Padding="12,5" FontSize="11" Effect="{x:Null}" Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                    Click="Action_Click"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Button.Chrome}" Width="24" Height="24"
                                Padding="6" Margin="8,0,0,0" VerticalAlignment="Top" Click="Dismiss_Click"
                                ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Base}"
                                  Width="10" Height="10" Stroke="{StaticResource Brush.TextDim}"/>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
