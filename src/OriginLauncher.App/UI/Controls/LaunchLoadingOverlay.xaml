<UserControl x:Class="OriginLauncher.App.UI.Controls.LaunchLoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d"
             Visibility="Collapsed"
             IsHitTestVisible="True">

    <!-- Covers the whole Home page during install + launch. The scene IS the
         game's Origin loading screen (LoadingScene: same rings, mark, bar and
         brackets, laid out by the game's formulas), so when Minecraft's window
         fades in over it nothing seems to change. Transparent here and hit-
         testable: the scene paints its own charcoal as the Play press lands,
         and nothing can click through to Home meanwhile. -->
    <Grid Background="Transparent">
        <controls:LoadingScene x:Name="Scene"/>

        <!-- Launcher-only lines (the game's screen has none): what is happening,
             and the way out. Low and quiet, under the game's composition, and
             gone before the scene glides onto the game window. -->
        <StackPanel x:Name="LoadingStage" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,44" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LoadingStageTranslate"/>
            </StackPanel.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="EyebrowText" Text="STARTING" Style="{StaticResource Text.Eyebrow}"
                           Foreground="{StaticResource Brush.AccentHover}"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Text.Eyebrow}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="LoaderCaptionText" Style="{StaticResource Text.Label}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="StageText" Style="{StaticResource Text.BodyDim}" HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>

            <!-- The abort path: cancels the in-flight provisioning (the newest
                 launch action always wins — CLAUDE.md hard requirement), or
                 stops a game that is already starting. -->
            <Button x:Name="CancelButton" Style="{StaticResource Button.Chrome}"
                    Content="Cancel" Padding="18,6" Margin="0,18,0,0"
                    HorizontalAlignment="Center" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
