<UserControl x:Class="OriginLauncher.App.UI.Controls.LaunchLoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d"
             Visibility="Collapsed"
             IsHitTestVisible="True">

    <!-- The launch screen (Poster): the whole window, top bar included. The art
         blooms into colour underneath (ArtStage.BeginLaunch) and this scrim keeps
         every line on it at 7:1. Nothing behind is interactive meanwhile. The
         origin mark doubles as the spinner. -->
    <Grid Background="{StaticResource Brush.LaunchScrim}">
        <StackPanel x:Name="LoadingStage" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LoadingStageTranslate"/>
            </StackPanel.RenderTransform>
            <controls:BrandLogo x:Name="Mark" Width="{StaticResource Size.Logo.Hero}" Height="{StaticResource Size.Logo.Hero}" Margin="0,0,0,24"/>

            <controls:TrackedText x:Name="EyebrowText" Text="PREPARING MINECRAFT" Tracking="0.16"
                                  FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                  Foreground="{StaticResource Brush.OnPhoto}" HorizontalAlignment="Center"/>
            <!-- The big line: the real percentage while a stage has a count, else
                 the version (never a made-up number; Core/Launch/StageProgress). The
                 count runs on the same clock as the bar (Shown), so number and fill
                 move together; its digits are tabular, so it never jitters. The % is
                 smaller, on the number's baseline (set in code from the font). -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,12"
                        TextOptions.TextFormattingMode="Ideal">
                <controls:TrackedText x:Name="VersionText" Text="1.21.1" Tracking="-0.01"
                                      FontFamily="{StaticResource Font.Primary}" FontSize="{StaticResource FontSize.Display}"
                                      FontWeight="ExtraBold" Foreground="{StaticResource Brush.OnPhoto}" VerticalAlignment="Bottom"/>
                <controls:TrackedText x:Name="PercentText" Text="%" Tracking="0" Visibility="Collapsed"
                                      FontFamily="{StaticResource Font.Primary}" FontSize="{StaticResource FontSize.Title}"
                                      FontWeight="Bold" Foreground="{StaticResource Brush.OnPhoto}" VerticalAlignment="Bottom"
                                      Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="LoaderCaptionText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextDim}"
                       HorizontalAlignment="Center" Margin="0,-6,0,18"/>

            <!-- The bar. Launch: a stage with a real count ("Downloading
                 libraries (12/340)") fills to it; any other stage slides a block
                 across the track. Self-update: a fill driven by downloaded bytes.
                 The fill is a full-width bar scaled from its left edge (a GPU
                 transform, no layout per frame), pixel snapping off so its end
                 moves smoothly. The colour is the family accent (an indicator). -->
            <Border x:Name="ProgressTrack" Width="420" Height="4" CornerRadius="{StaticResource Radius.Track}"
                    Background="{StaticResource Brush.ProgressTrack}" HorizontalAlignment="Center"
                    ClipToBounds="True" Margin="0,0,0,16"
                    SnapsToDevicePixels="False" UseLayoutRounding="False">
                <Grid>
                    <Border x:Name="ProgressFill" Height="4" CornerRadius="{StaticResource Radius.Track}"
                            Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"
                            SnapsToDevicePixels="False" UseLayoutRounding="False"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="ProgressSweep" Width="96" Height="4" CornerRadius="{StaticResource Radius.Track}"
                            Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ProgressTranslate" X="-70"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <TextBlock x:Name="StageText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="520"/>

            <!-- The abort path lives here (the screen covers everything): cancels the
                 in-flight provisioning (the newest launch action always wins). -->
            <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}"
                    Content="Cancel" Margin="0,28,0,0"
                    HorizontalAlignment="Center" Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Bottom left: what is starting - the family, then account and profile. -->
        <StackPanel x:Name="CaptionPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,32">
            <controls:TrackedText x:Name="CaptionFamily" Text="TRICKY TRIALS" Tracking="0.16"
                                  FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                  Foreground="{StaticResource Brush.OnPhoto}"/>
            <TextBlock x:Name="CaptionDetail" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextDim}"
                       TextTrimming="CharacterEllipsis" MaxWidth="480"/>
        </StackPanel>
    </Grid>
</UserControl>
