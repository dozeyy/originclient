<UserControl x:Class="OriginLauncher.App.UI.Controls.FriendsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <!-- The Friends drawer (docs/SOCIAL.md → Launcher). One drawer, four views:
           MessagePane  signed out / connecting / service unreachable
           EmptyPane    signed in, no friends yet
           RowList      ONE list: warp, requests and invites, party, online, offline,
                        sent, blocked. Each section is one card group with 1 px
                        dividers between its rows.
           ChatPane     one friend, or the party, on a dark well
         Every row has one obvious action on it; the rest are in its "..." menu
         (also right-click or the Menu key). All styles come from Theme/Social.xaml
         and Theme/Menus.xaml, so a token change restyles the whole drawer. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>

        <!-- ===== Poster look (mockup 13-friends), drawer-local: these keys shadow the Social.* ones
             in Theme/Social.xaml for this drawer only. Rows are flat on the drawer's surface (no card
             fill, no dividers); a press or hover lifts one step; the party is the one dark card;
             presence is a small square on the avatar corner, like the mockup. ===== -->
        <CornerRadius x:Key="Social.PartyTop">4,4,0,0</CornerRadius>
        <Style x:Key="Social.RowStatic" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Row}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="Social.Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Social.RowFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource Radius.Row}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Card}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A party member's row: the same, on the party card's dark surface. -->
        <Style x:Key="Social.PartyRow" TargetType="Button" BasedOn="{StaticResource Social.Row}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Brush.BgAlt}" Padding="{TemplateBinding Padding}">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{StaticResource Social.CardCorners}">
                                    <Binding Path="Pos"/>
                                    <Binding Source="{StaticResource Social.PartyTop}"/>
                                </MultiBinding>
                            </Border.CornerRadius>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Social.Dot" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,-3,-3"/>
            <Setter Property="Background" Value="{StaticResource Brush.Success}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelElevated}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <!-- Crisp 3 px-corner buttons (Will: squarer, not squircles). Same height and padding for JOIN, CHAT, WARP, LEAVE;
             hover/press on all; press scales to 0.95. -->
        <Style x:Key="Social.Join" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Eyebrow}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{DynamicResource Brush.Acc}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="Hl" Background="White" Opacity="0" CornerRadius="3"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
        </Style>
        <Style x:Key="Social.IconPrimary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="MinWidth" Value="{StaticResource Social.IconSize}"/>
            <Setter Property="MinHeight" Value="{StaticResource Social.IconSize}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{StaticResource Brush.BgAlt}" BorderBrush="{DynamicResource Brush.Acc}" BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="Hl" Background="{DynamicResource Brush.Acc}" Opacity="0.22" CornerRadius="3"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Acc}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
        </Style>
        <Style x:Key="Social.IconRaised" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="MinWidth" Value="{StaticResource Social.IconSize}"/>
            <Setter Property="MinHeight" Value="{StaticResource Social.IconSize}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{StaticResource Brush.BgAlt}" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="Hl" Background="{StaticResource Brush.Danger}" Opacity="0" CornerRadius="3"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.2"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Danger}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
        </Style>
        <Style x:Key="Social.TileChat" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Acc}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Eyebrow}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{StaticResource Brush.BgAlt}" BorderBrush="{DynamicResource Brush.Acc}" BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="Hl" Background="{DynamicResource Brush.Acc}" Opacity="0.14" CornerRadius="3"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Acc}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
        </Style>
        <Style x:Key="Social.Tile" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Eyebrow}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="Hl" Background="White" Opacity="0" CornerRadius="3"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.08"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
        </Style>
        <Style x:Key="Social.TileLeave" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Eyebrow}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" CornerRadius="3"/>
                            <Border x:Name="Hl" Background="{StaticResource Brush.Danger}" Opacity="0" CornerRadius="3"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Danger}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
        </Style>
        <!-- The party card's bottom edge: the actions sit below the members on the same dark surface. -->
        <!-- Text fields: no frame, a card-coloured well (the focus animation only recolours the border, so it stays off). -->
        <Style TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        </Style>
        <!-- Unread count: a light chip with dark digits (the mockup's Chat 1). -->
        <Style x:Key="Social.Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Acc}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ================= list rows ================= -->

        <DataTemplate DataType="{x:Type controls:SectionVm}">
            <Button x:Name="Btn" Style="{StaticResource Social.SectionButton}" Margin="0,18,0,4" Padding="8,2"
                    Click="Section_Click">
                <Grid>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Social.Section}"/>
                    <Path x:Name="Chev" Data="{StaticResource Icon.Chevron}" Style="{StaticResource Icon.Base}"
                          Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Stroke="{StaticResource Brush.TextMuted}" RenderTransformOrigin="0.5,0.5"
                          Visibility="Collapsed"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Collapsible}" Value="False">
                    <Setter TargetName="Btn" Property="IsHitTestVisible" Value="False"/>
                    <Setter TargetName="Btn" Property="Focusable" Value="False"/>
                    <Setter TargetName="Btn" Property="IsTabStop" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Collapsible}" Value="True">
                    <Setter TargetName="Chev" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Collapsed}" Value="True">
                    <Setter TargetName="Chev" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:HintVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <TextBlock Text="{Binding Text}" Style="{StaticResource Social.Quiet}" TextWrapping="Wrap"
                           TextTrimming="None"/>
            </Border>
        </DataTemplate>

        <!-- The party leader asked everyone to join them. -->
        <DataTemplate DataType="{x:Type controls:WarpVm}">
            <Border Margin="0,10,0,2" Padding="12,10" Background="{StaticResource Brush.AccentSoft}"
                    BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               TextTrimming="None" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="JOIN" Style="{StaticResource Social.Join}"
                            Margin="10,0,0,0" Click="WarpJoin_Click"
                            ToolTip="Launch their Minecraft version and join the server"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A friend. The row opens the chat; JOIN is the one loud button; "..." has the rest. -->
        <DataTemplate DataType="{x:Type controls:FriendVm}">
            <Button Style="{StaticResource Social.Row}" Click="FriendRow_Click"
                    ContextMenuOpening="FriendRow_ContextMenuOpening"
                    AutomationProperties.Name="{Binding Name}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border x:Name="Avatar" Style="{StaticResource Social.Avatar}">
                            <controls:PixelFace Seed="{Binding Name}"/>
                        </Border>
                        <Border x:Name="Dot" Style="{StaticResource Social.Dot}" Background="{StaticResource Brush.TextMuted}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource Social.Name}"/>
                        <TextBlock x:Name="CaptionText" Text="{Binding Caption}" ToolTip="{Binding StatusFull}"
                                   Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Border Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource Social.Badge}" ToolTip="Unread messages">
                            <TextBlock Text="{Binding UnreadText}" FontSize="{StaticResource FontSize.Eyebrow}"
                                       FontWeight="Bold" Foreground="{StaticResource Brush.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="JOIN" Style="{StaticResource Social.Join}"
                                Visibility="{Binding CanJoin, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding JoinTip}" Click="FriendJoin_Click"/>
                        <Button Style="{StaticResource Social.Icon}" Click="FriendMore_Click"
                                ToolTip="More"
                                AutomationProperties.Name="More actions">
                            <Path Data="{StaticResource Icon.More}" Style="{StaticResource Icon.Small}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter TargetName="Dot" Property="Background" Value="{StaticResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter TargetName="Avatar" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Brush.Text}"/>
                    <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An incoming friend request: Accept is the action, the X declines. -->
        <DataTemplate DataType="{x:Type controls:RequestVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Social.Avatar}" Margin="0,0,10,0">
                        <controls:PixelFace Seed="{Binding Name}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}"/>
                        <TextBlock Text="Wants to be friends" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Style="{StaticResource Social.IconPrimary}" Click="RequestAccept_Click"
                                ToolTip="Accept" AutomationProperties.Name="Accept request">
                            <Path Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Small}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource Social.IconRaised}" Click="RequestDecline_Click"
                                ToolTip="Decline" AutomationProperties.Name="Decline request">
                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:InviteVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Social.Avatar}" Margin="0,0,10,0">
                        <controls:PixelFace Seed="{Binding Name}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}"/>
                        <TextBlock Text="Party invite" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Style="{StaticResource Social.IconPrimary}" Click="InviteAccept_Click"
                                ToolTip="Join their party (you leave your current one)" AutomationProperties.Name="Join party">
                            <Path Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Small}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource Social.IconRaised}" Click="InviteDecline_Click"
                                ToolTip="Decline" AutomationProperties.Name="Decline invite">
                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A party member: a friend's row opens their chat; "..." holds Message, Join,
             Make leader (leader only), Kick (leader only), Remove, Block. -->
        <DataTemplate DataType="{x:Type controls:MemberVm}">
            <Button x:Name="Row" Style="{StaticResource Social.PartyRow}" Click="MemberRow_Click"
                    ContextMenuOpening="MemberRow_ContextMenuOpening"
                    AutomationProperties.Name="{Binding Name}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource Social.Avatar}">
                            <controls:PixelFace Seed="{Binding Name}"/>
                        </Border>
                        <Border x:Name="MDot" Style="{StaticResource Social.Dot}" Background="{StaticResource Brush.TextMuted}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}"/>
                            <Path Data="{StaticResource Icon.Crown}" Style="{StaticResource Icon.Base}"
                                  Width="13" Height="13" Margin="6,0,0,1" VerticalAlignment="Center"
                                  Stroke="{StaticResource Brush.Warning}" ToolTip="Party leader"
                                  Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Border Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource Social.Badge}" ToolTip="Unread messages">
                            <TextBlock Text="{Binding UnreadText}" FontSize="{StaticResource FontSize.Eyebrow}"
                                       FontWeight="Bold" Foreground="{StaticResource Brush.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="JOIN" Style="{StaticResource Social.Join}"
                                Visibility="{Binding CanJoin, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding JoinTip}" Click="MemberJoin_Click"/>
                        <Button Style="{StaticResource Social.Icon}" Click="MemberMore_Click"
                                Visibility="{Binding HasMenu, Converter={StaticResource BoolToVis}}"
                                ToolTip="More" AutomationProperties.Name="More actions">
                            <Path Data="{StaticResource Icon.More}" Style="{StaticResource Icon.Small}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter TargetName="MDot" Property="Background" Value="{StaticResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Clickable}" Value="False">
                    <Setter TargetName="Row" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                    <Setter TargetName="Row" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:PartyHeaderVm}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Social.Section}" Margin="8,18,0,6"/>
        </DataTemplate>

        <!-- Chat / Warp / Leave sit under the members, on the party card's dark surface. -->
        <DataTemplate DataType="{x:Type controls:PartyActionsVm}">
            <Border Background="{StaticResource Brush.BgAlt}" CornerRadius="0,0,4,4" Padding="8,2,8,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding ChatText}" Style="{StaticResource Social.TileChat}" Margin="0"
                            Click="PartyChat_Click" ToolTip="Open the party chat"/>
                    <Button Content="WARP" Style="{StaticResource Social.Tile}"
                            Click="Warp_Click" IsEnabled="{Binding CanWarp}" ToolTip="{Binding WarpTip}"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="LEAVE" Style="{StaticResource Social.TileLeave}"
                            Click="LeaveParty_Click" ToolTip="Leave the party"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:PendingVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Social.Avatar}" Margin="0,0,10,0" Opacity="0.6">
                        <controls:PixelFace Seed="{Binding Name}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}"
                                   Foreground="{StaticResource Brush.TextDim}"/>
                        <TextBlock Text="Request sent" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="CANCEL" Style="{StaticResource Social.Action}"
                            ToolTip="Cancel your friend request" Click="RequestCancel_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:BlockedVm}">
            <Border Style="{StaticResource Social.RowStatic}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Social.Avatar}" Margin="0,0,10,0" Opacity="0.6">
                        <controls:PixelFace Seed="{Binding Name}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Social.Name}"
                                   Foreground="{StaticResource Brush.TextDim}"/>
                        <TextBlock Text="Blocked" Style="{StaticResource Social.Caption}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="UNBLOCK" Style="{StaticResource Social.Action}" Click="Unblock_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ================= chat rows ================= -->

        <DataTemplate DataType="{x:Type controls:ChatDayVm}">
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Social.Divider}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Social.Quiet}" Margin="10,0"/>
                <Border Grid.Column="2" Style="{StaticResource Social.Divider}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type controls:ChatLineVm}">
            <StackPanel Margin="{Binding Gap}">
                <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderVisibility}" Margin="0,0,0,2">
                    <TextBlock x:Name="Who" Text="{Binding Author}" Style="{StaticResource Social.Name}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Social.Quiet}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                           TextTrimming="None" ToolTip="{Binding FullTime}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="Who" Property="Foreground" Value="{StaticResource Brush.AccentHover}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- add friend -->
            <RowDefinition Height="Auto"/>   <!-- notice / stale -->
            <RowDefinition Height="*"/>      <!-- the view -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Header: back (chat only), title + one status line, then the view's own actions.
             The status line keeps its height when empty, so the title never jumps between views. -->
        <StackPanel Grid.Row="0">
        <Grid Margin="16,16,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource Social.Icon}" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="Back_Click" ToolTip="Back (Esc)"
                    AutomationProperties.Name="Back to friends">
                <Path Data="{StaticResource Icon.Back}" Style="{StaticResource Icon.Small}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="FRIENDS" Style="{StaticResource Text.H1}"/>
                <StackPanel x:Name="HeaderSubRow" Orientation="Horizontal" Visibility="Hidden">
                    <Ellipse x:Name="HeaderDot" Width="7" Height="7" Fill="{StaticResource Brush.Success}"
                             Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="HeaderSubtitle" Text=" " Style="{StaticResource Social.Quiet}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddToggle" Style="{StaticResource Social.Icon}" Click="AddToggle_Click"
                        ToolTip="Add a friend" AutomationProperties.Name="Add a friend">
                    <Path Data="{StaticResource Icon.UserPlus}" Style="{StaticResource Icon.Small}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="ChatMoreButton" Style="{StaticResource Social.Icon}" Click="ChatMore_Click"
                        Visibility="Collapsed" ToolTip="More" AutomationProperties.Name="More actions">
                    <Path Data="{StaticResource Icon.More}" Style="{StaticResource Icon.Small}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource Social.Icon}" Click="Close_Click"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close friends">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>
        <!-- One hairline under the header, in the list, the states and the chat alike. -->
        <Border Style="{StaticResource Social.Divider}" Margin="16,0,16,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Add a friend: opens from the header button (or "Add a friend" when you have none). -->
        <Grid x:Name="AddRow" Grid.Row="1" Margin="16,0,16,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AddFriendBox" MaxLength="16"
                     KeyDown="AddFriendBox_KeyDown" TextChanged="AddFriendBox_TextChanged"
                     AutomationProperties.Name="Friend's Minecraft username"/>
            <TextBlock x:Name="AddFriendHint" Text="Minecraft username" Style="{StaticResource Social.Hint}"/>
            <Button Grid.Column="1" x:Name="AddFriendButton" Content="SEND REQUEST" Style="{StaticResource Button.Primary}"
                    Padding="14,0" Margin="8,0,0,0" Effect="{x:Null}" FontSize="{StaticResource FontSize.Eyebrow}"
                    Click="AddFriend_Click" ToolTip="Send a friend request (Enter)"
                    AutomationProperties.Name="Send friend request"/>
        </Grid>

        <!-- One status line: what just happened, or why something can't. Click to dismiss. -->
        <StackPanel Grid.Row="2">
            <Border x:Name="NoticeStrip" Style="{StaticResource Social.Strip}" Visibility="Collapsed" Cursor="Hand"
                    MouseLeftButtonUp="Notice_Click" ToolTip="Click to dismiss">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="NoticeIcon" Data="{StaticResource Icon.Alert}" Style="{StaticResource Icon.Base}"
                          Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="NoticeText" Grid.Column="1" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" TextTrimming="None"/>
                </Grid>
            </Border>
            <Border x:Name="StaleStrip" Style="{StaticResource Social.Strip}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Icon.Alert}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                          Margin="0,2,8,0" Stroke="{StaticResource Brush.Warning}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="Can't reach friends. Showing what Origin last saw." Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Warning}" TextWrapping="Wrap" TextTrimming="None"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ the view (one at a time) ============ -->
        <Grid Grid.Row="3">

            <!-- Signed out / connecting / unreachable. -->
            <StackPanel x:Name="MessagePane" Margin="16,12,16,24" VerticalAlignment="Top" Visibility="Collapsed">
                <Border Width="56" Height="56" HorizontalAlignment="Left" Background="{StaticResource Brush.Card}"
                        BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Swatch}">
                    <Path Data="{StaticResource Icon.Friends}" Style="{StaticResource Icon.Base}"
                          Width="24" Height="24" Stroke="{StaticResource Brush.TextDim}"/>
                </Border>
                <TextBlock x:Name="MessageTitle" Style="{StaticResource Text.H2}" Margin="0,18,0,0"
                           TextWrapping="Wrap" TextTrimming="None"/>
                <TextBlock x:Name="MessageBody" Style="{StaticResource Text.BodyDim}" Margin="0,8,0,0"
                           TextWrapping="Wrap" TextTrimming="None"/>
                <StackPanel x:Name="FeatureList" Margin="0,18,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Path Data="{StaticResource Icon.Chat}" Style="{StaticResource Icon.Base}" Width="16" Height="16"
                              Stroke="{StaticResource Brush.TextDim}" Margin="0,0,10,0"/>
                        <TextBlock Text="Message friends" Style="{StaticResource Text.Body}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Path Data="{StaticResource Icon.Friends}" Style="{StaticResource Icon.Base}" Width="16" Height="16"
                              Stroke="{StaticResource Brush.TextDim}" Margin="0,0,10,0"/>
                        <TextBlock Text="Party up, with chat" Style="{StaticResource Text.Body}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.External}" Style="{StaticResource Icon.Base}" Width="16" Height="16"
                              Stroke="{StaticResource Brush.TextDim}" Margin="0,0,10,0"/>
                        <TextBlock Text="Join their server in one click" Style="{StaticResource Text.Body}"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="MessageAction" Style="{StaticResource Button.Primary}" Margin="0,22,0,0"
                        Padding="16,8" HorizontalAlignment="Left" Click="MessageAction_Click"/>
            </StackPanel>

            <!-- Signed in, nobody yet. -->
            <StackPanel x:Name="EmptyPane" Margin="16,12,16,24" VerticalAlignment="Top" Visibility="Collapsed">
                <Border Width="56" Height="56" HorizontalAlignment="Left" Background="{StaticResource Brush.Card}"
                        BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Swatch}">
                    <Path Data="{StaticResource Icon.UserPlus}" Style="{StaticResource Icon.Base}"
                          Width="24" Height="24" Stroke="{StaticResource Brush.TextDim}"/>
                </Border>
                <TextBlock Text="No friends yet" Style="{StaticResource Text.H2}" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource Text.BodyDim}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="Add someone by their Minecraft username. They need Origin too. Friends can chat, party up and join each other's servers."/>
                <Button Content="ADD A FRIEND" Style="{StaticResource Button.Primary}" Margin="0,22,0,0" Padding="16,8"
                        HorizontalAlignment="Left" Click="EmptyAdd_Click"/>
            </StackPanel>

            <!-- The list: virtualized, so a long friends list costs nothing off screen. -->
            <!-- The list sits 3 px inside the scroll viewport on every side (the margins here and on the
                 presenter cancel out, so the rows don't move): the outset keyboard-focus frame is drawn
                 inside the viewport's clip and would lose its left, right and edge sides without it. -->
            <ItemsControl x:Name="RowList" Margin="13,-3,3,0" Focusable="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False" Padding="0,0,8,9" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <ItemsPresenter Margin="3"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- One conversation: a friend, or the party. -->
            <Grid x:Name="ChatPane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Join / invite, only the ones that apply right now, between two hairlines. -->
                <StackPanel Grid.Row="0">
                    <StackPanel x:Name="ChatBar" Orientation="Horizontal" Margin="16,0,16,10" Visibility="Collapsed">
                        <Button x:Name="ChatJoinButton" Content="JOIN" Style="{StaticResource Social.Join}"
                                Margin="0,0,8,0" Padding="14,6" Click="ChatJoin_Click"
                                ToolTip="Launch their Minecraft version and join their server"/>
                        <Button x:Name="ChatInviteButton" Content="INVITE TO PARTY" Style="{StaticResource Social.Action}"
                                Margin="0" Padding="14,6" Click="ChatInvite_Click"/>
                    </StackPanel>
                    <Border x:Name="ChatBarDivider" Style="{StaticResource Social.Divider}" Margin="16,0,16,8"
                            Visibility="Collapsed"/>
                </StackPanel>

                <!-- The dark well the conversation sits in. -->
                <Border Grid.Row="1" Margin="16,8,16,8" Background="{StaticResource Brush.BgAlt}"
                        CornerRadius="{StaticResource Radius.Card}">
                    <Grid>
                        <ScrollViewer x:Name="ChatScroll" Padding="12,0,8,8" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="ChatScroll_ScrollChanged">
                            <ItemsControl x:Name="ChatList" Focusable="False"/>
                        </ScrollViewer>
                        <StackPanel x:Name="ChatEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="24,0">
                            <Path Data="{StaticResource Icon.Chat}" Style="{StaticResource Icon.Base}" Width="26" Height="26"
                                  Stroke="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ChatEmptyTitle" Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"/>
                            <TextBlock x:Name="ChatEmptyBody" Style="{StaticResource Social.Quiet}" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"/>
                            <Button x:Name="ChatEmptyAction" Content="INVITE A FRIEND" Style="{StaticResource Social.ActionPrimary}"
                                    Margin="0,14,0,0" Padding="14,6" HorizontalAlignment="Center" Visibility="Collapsed"
                                    Click="ChatEmptyAction_Click" ToolTip="Pick a friend to invite"/>
                        </StackPanel>
                        <Button x:Name="JumpButton" Style="{StaticResource Social.ActionPrimary}" Margin="0,0,0,10"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="12,6"
                                Visibility="Collapsed" Click="Jump_Click" ToolTip="Scroll to the newest message">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NEW MESSAGES" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextOnAccent}"/>
                                <Path Data="{StaticResource Icon.Arrow.Down}" Style="{StaticResource Icon.Base}" Width="11" Height="11"
                                      Stroke="{StaticResource Brush.TextOnAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock x:Name="ChatError" Grid.Row="2" Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Danger}" Margin="18,2,16,6"
                           TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"/>

                <Grid Grid.Row="3" Margin="16,2,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" MaxLength="256" KeyDown="ChatInput_KeyDown"
                             TextChanged="ChatInput_TextChanged" AutomationProperties.Name="Message"/>
                    <TextBlock x:Name="ChatHint" Text="Message" Style="{StaticResource Social.Hint}"/>
                    <TextBlock x:Name="ChatCounter" Style="{StaticResource Social.Quiet}" Margin="0,0,10,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                    <Button Grid.Column="1" x:Name="ChatSendButton" Style="{StaticResource Button.Primary}"
                            Padding="12,0" Margin="8,0,0,0" Effect="{x:Null}" Click="ChatSend_Click"
                            ToolTip="Send (Enter)" AutomationProperties.Name="Send message">
                        <Path Data="{StaticResource Icon.Send}" Style="{StaticResource Icon.Base}"
                              Width="15" Height="15" Stroke="{StaticResource Brush.TextOnAccent}"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer: always one click away, never in the way. -->
        <Border x:Name="Footer" Grid.Row="4" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="0,1,0,0"
                Padding="16,10,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Appear offline" Style="{StaticResource Text.Body}"/>
                    <TextBlock x:Name="AppearCaption" Text="Friends see you as online" Style="{StaticResource Social.Quiet}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" x:Name="AppearOfflineToggle" Style="{StaticResource Toggle.Switch}"
                              VerticalAlignment="Center" AutomationProperties.Name="Appear offline"
                              ToolTip="Friends see you as offline while this is on"
                              Checked="AppearOffline_Changed" Unchecked="AppearOffline_Changed"/>
            </Grid>
        </Border>

        <controls:ConfirmOverlay x:Name="Confirm" Grid.RowSpan="5"/>
    </Grid>
</UserControl>
