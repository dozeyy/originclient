<UserControl x:Class="OriginLauncher.App.UI.Controls.StartupIntro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             Background="{StaticResource Brush.Bg}"
             Focusable="False">

    <!--
        The launcher's opening: the official Origin logo (Brand.Logo, 64 box, design system 1.3) fades in and eases
        up from 94 % to full size on the bg colour, then the whole layer fades away to reveal the launcher already
        built underneath. The image itself is never redrawn, rotated or glowed (1.4). Purely decorative - there is
        no progress bar because nothing here is measuring progress; the only real signal it waits on is "the
        window has rendered and the UI thread is idle" (see StartupIntro.xaml.cs). Any click or key skips it.
    -->
    <controls:BrandLogo x:Name="Mark" Width="{StaticResource Size.Logo.Intro}" Height="{StaticResource Size.Logo.Intro}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
        <controls:BrandLogo.RenderTransform>
            <ScaleTransform x:Name="MarkScale" ScaleX="0.94" ScaleY="0.94"/>
        </controls:BrandLogo.RenderTransform>
    </controls:BrandLogo>
</UserControl>
