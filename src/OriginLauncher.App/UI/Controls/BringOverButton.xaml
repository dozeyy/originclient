<UserControl x:Class="OriginLauncher.App.UI.Controls.BringOverButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:OriginLauncher.App.UI"
             mc:Ignorable="d" Visibility="Collapsed"
             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="32,64,32,0">

    <!-- Home's one bring-over button (Will, 2026-11-04; state: Core/Import/Launcher/BringOverModel). Top centre, 16 under
         the bar, well clear of the numeral and of the strip, so it never competes with Play: a neutral 40 tall capsule
         (surfaceRaised + strong edge, DESIGN-SYSTEM 5 / 6), the one colour its small leading glyph. One launcher: a press
         brings it over at once. Several: a press opens the choice under it. While it runs: the line counts up and a
         3 px rail runs inside the bottom edge, with Stop. Then one plain line (and what didn't come over) and a close. -->
    <UserControl.Resources>
        <!-- The capsule's inner controls: 32 tall ghosts, concentric with the 40 capsule (Radius.Capsule.Md). -->
        <Style x:Key="BringOver.Inner" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Capsule.Md}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Padding" Value="12,0,14,0"/>
        </Style>
        <Style x:Key="BringOver.Icon" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Capsule.Md}"/>
            <Setter Property="MinWidth" Value="{StaticResource Size.ControlMd}"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- A row of the choice: a menu item (Radius.Md inside the Radius.Lg panel's 6 inset). -->
        <Style x:Key="BringOver.Row" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
            <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="{StaticResource Size.ControlXl}"/>
            <Setter Property="Padding" Value="10,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border x:Name="Shell" ui:Capsule.On="True" HorizontalAlignment="Center" MinHeight="{StaticResource Size.ControlXl}"
                Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1" Padding="3">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Lift"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MainButton" Style="{StaticResource BringOver.Inner}" Click="Main_Click" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="LeadIcon" Data="{StaticResource Icon.ImportIn}" Style="{StaticResource Icon.Small}"
                              Stroke="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,6">
                            <TextBlock x:Name="LineText" Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" MaxWidth="440"/>
                            <TextBlock x:Name="DetailText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextDim}"
                                       TextWrapping="Wrap" MaxWidth="440" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <Path x:Name="Chevron" Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon.Small}"
                              Stroke="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ChevronTurn"/>
                            </Path.RenderTransform>
                        </Path>
                    </StackPanel>
                </Button>

                <!-- Stop while it runs, Try again after a failed run. -->
                <Button x:Name="ActionButton" Grid.Column="1" Style="{StaticResource BringOver.Inner}" Padding="12,0"
                        VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" Click="Action_Click"/>

                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource BringOver.Icon}" VerticalAlignment="Center"
                        Margin="2,0,0,0" Click="Close_Click" AutomationProperties.Name="No thanks" ToolTip="No thanks">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- The progress rail (DESIGN-SYSTEM 11.11) inside the bottom edge; only once there is a real fraction. -->
                <Border x:Name="Rail" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="16,0,16,1" Height="{StaticResource Size.Progress}"
                        Background="{StaticResource Brush.ProgressTrack}" CornerRadius="{StaticResource Radius.Track}" Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border Background="{StaticResource Brush.Accent}" CornerRadius="{StaticResource Radius.Track}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RailFill" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- Several launchers: one row per launcher (logo, name, how many setups), All of them, then the full Import page. -->
        <Border x:Name="ChoicePanel" Visibility="Collapsed" HorizontalAlignment="Center" MinWidth="320" Margin="0,8,0,0" Padding="6"
                Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}">
            <StackPanel>
                <StackPanel x:Name="SourceRows"/>
                <Button x:Name="AllButton" Style="{StaticResource BringOver.Row}" Click="All_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{StaticResource Size.ControlSm}" Height="{StaticResource Size.ControlSm}" Margin="0,0,10,0" ui:Capsule.On="True" Background="{StaticResource Brush.Bg}">
                            <Path Data="{StaticResource Icon.ImportIn}" Style="{StaticResource Icon.Small}"
                                  Stroke="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="AllText" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Rectangle Height="1" Fill="{StaticResource Brush.SoftStroke}" Margin="8,6"/>
                <Button x:Name="MoreButton" Style="{StaticResource BringOver.Row}" Click="More_Click">
                    <Grid>
                        <TextBlock x:Name="MoreText" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource Icon.Chevron}" Style="{StaticResource Icon.Small}" HorizontalAlignment="Right"
                              Stroke="{StaticResource Brush.TextDim}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <!-- The chevron points down in the icon set: turned, it says "goes on to a page". -->
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
