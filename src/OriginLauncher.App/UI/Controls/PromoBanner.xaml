<UserControl x:Class="OriginLauncher.App.UI.Controls.PromoBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="400">

    <!-- The home banner: one card under the Play card. How it decides when it
         may run is documented at the top of PromoBanner.xaml.cs. -->

    <UserControl.Resources>
        <!-- Button.Secondary's surface and hover/press motion, but with the
             content stretched edge to edge (the base template centres it). -->
        <Style x:Key="Banner.Surface" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Card}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Card}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Space is reserved from the first frame (Opacity 0 until content is
         ready) so the Play card never jumps when the feed arrives; the row
         collapses only if the feed leaves nothing to show. -->
    <Grid x:Name="Root" Height="96" Opacity="0">

        <!-- House promos (the live Discord card and the tips slot included). -->
        <Button x:Name="HouseCard" Style="{StaticResource Banner.Surface}"
                Click="HouseCard_Click" AutomationProperties.Name="Origin news">
            <!-- Layers is clipped to the card's rounded rect in code (SizeChanged),
                 so the zooming preview art never spills past the corners. -->
            <Grid x:Name="Layers" Margin="1">

                <!-- No preview art: the Origin mark, large and faint, off the right edge. -->
                <controls:OriginMark x:Name="AmbientMark" Width="140" Height="140" Opacity="0.10"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-30,-26,-30"/>

                <!-- Preview art: fills the card, slow zoom while it's up (Ken Burns). -->
                <Image x:Name="PreviewImage" Stretch="UniformToFill" HorizontalAlignment="Right"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.75,0.5" Opacity="0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="PreviewZoom"/>
                    </Image.RenderTransform>
                </Image>

                <!-- Legibility: the card colour solid behind the text, fading out
                     across the art so the right half shows through. -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F21D2420" Offset="0"/>
                            <GradientStop Color="#E61D2420" Offset="0.36"/>
                            <GradientStop Color="#7A1D2420" Offset="0.58"/>
                            <GradientStop Color="#001D2420" Offset="0.82"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Text box: kept clear of the progress bar along the bottom edge.
                     The text is wrapped and sized to fit this box in code
                     (FitText, ladder in Core/Promos/BannerCard) — never cut off. -->
                <Grid x:Name="SlideContent" Margin="14,6,14,11" ClipToBounds="False">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SlideTransform"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Small square icon: Discord's server icon or a feed imageUrl only. -->
                    <Border Grid.Column="0" x:Name="IconBox" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                            Background="{StaticResource Brush.CardAlt}"
                            BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True" Visibility="Collapsed">
                        <Image x:Name="IconImage" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" x:Name="TextStack" VerticalAlignment="Center" Margin="0,0,10,0"
                                HorizontalAlignment="Left">
                        <!-- Width cap (TextMaxWidth) is set in code with the text size. -->
                        <!-- Eyebrow as a chip, so each card says what it is at a glance. -->
                        <Border HorizontalAlignment="Left" Padding="6,2" Background="{StaticResource Brush.AccentSoft}"
                                CornerRadius="{StaticResource Radius.Chip}">
                            <TextBlock x:Name="LabelText" Style="{StaticResource Text.Eyebrow}"
                                       Foreground="{StaticResource Brush.Accent}"/>
                        </Border>
                        <!-- Sizes + line heights come from BannerCard.TextSteps (FitText). -->
                        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Body}" FontSize="15" LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextTrimming="None"/>
                        <Grid x:Name="SubtitleRow" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Live "online" marker, Discord card only. -->
                            <Rectangle x:Name="OnlineDot" Width="6" Height="6" Margin="0,4,7,0"
                                       VerticalAlignment="Top" Fill="{StaticResource Brush.Success}"
                                       Visibility="Collapsed"/>
                            <TextBlock Grid.Column="1" x:Name="SubtitleText" Style="{StaticResource Text.Caption}"
                                       LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" TextTrimming="None"/>
                        </Grid>
                    </StackPanel>

                    <Path Grid.Column="2" x:Name="ExternalIcon" Data="{StaticResource Icon.External}"
                          Style="{StaticResource Icon.Base}" Width="12" Height="12" VerticalAlignment="Top"
                          Margin="0,12,0,0" Stroke="{StaticResource Brush.Text}"/>
                </Grid>
            </Grid>
        </Button>

        <!-- Rotation progress: one segment per card along the bottom edge; the
             current one fills over the rotation time. Click a segment to jump. -->
        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Margin="14,0,0,4"/>

        <!-- Ad-network mode: BannerAdHost puts its WebView2 in here. A WebView2
             is a native child window drawn above all WPF content (airspace),
             which is why every launcher overlay counts as "covered" in the gate. -->
        <Border x:Name="NetworkHost" Visibility="Collapsed"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"/>
    </Grid>
</UserControl>
