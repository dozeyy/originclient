<UserControl x:Class="OriginLauncher.App.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One setting per card (Poster): the shared card (Theme/Surfaces.xaml) with title + one-line why on the
             left, the control on the right. Sections are plain eyebrow headings above their cards. The type is
             the app scale: title = Text.Label (13.5), why / field label = Text.Caption (12). -->
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
            <Setter Property="MinHeight" Value="64"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="Margin" Value="0,32,0,10"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}"/>
        <Style x:Key="SettingWhy" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- The section rail: tracked caps; the current section gets a 2 px
             accent bar (an indicator) and full-strength text. -->
        <Style x:Key="RailItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsRail"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="{StaticResource Size.ControlSm}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Sharp}" Opacity="0"/>
                            <Rectangle x:Name="Bar" Width="2" HorizontalAlignment="Left" Margin="0,9" Opacity="0"
                                       Fill="{DynamicResource Brush.Acc}"/>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The page sits on the dimmed art; the top inset clears the 56 px bar.
         The scrollbar is hidden, wheel scrolling still works. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" Focusable="False" ScrollChanged="Scroller_ScrollChanged">
        <controls:PageColumn x:Name="Column" Style="{StaticResource Page.Column}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The title spans the rail's column too, so it starts at the page's left edge like every page. -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="SETTINGS" Style="{StaticResource Text.Poster}"
                       HorizontalAlignment="Left"/>

            <!-- The rail stays put while the column scrolls (moved in code). -->
            <StackPanel x:Name="Rail" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,24,0,0"
                        TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="RailShift"/>
                </StackPanel.RenderTransform>
                <RadioButton Style="{StaticResource RailItem}" Tag="SecPerformance" Checked="Rail_Checked" IsChecked="True">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Settings}" Style="{StaticResource Icon.Small}" Margin="0,0,10,0" Stroke="{StaticResource TintInk.Mint}"/><controls:TrackedText Text="PERFORMANCE" Tracking="0.16"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RailItem}" Tag="SecGame" Checked="Rail_Checked">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon.Small}" Margin="0,0,10,0" Stroke="{StaticResource TintInk.Sky}"/><controls:TrackedText Text="GAME" Tracking="0.16"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RailItem}" Tag="SecJvm" Checked="Rail_Checked">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Server}" Style="{StaticResource Icon.Small}" Margin="0,0,10,0" Stroke="{StaticResource TintInk.Violet}"/><controls:TrackedText Text="JVM ARGUMENTS" Tracking="0.16"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RailItem}" Tag="SecClient" Checked="Rail_Checked">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Mods}" Style="{StaticResource Icon.Small}" Margin="0,0,10,0" Stroke="{DynamicResource Brush.Acc}"/><controls:TrackedText Text="ORIGIN CLIENT" Tracking="0.16"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RailItem}" Tag="SecStartup" Checked="Rail_Checked">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Home}" Style="{StaticResource Icon.Small}" Margin="0,0,10,0" Stroke="{StaticResource TintInk.Gold}"/><controls:TrackedText Text="STARTUP" Tracking="0.16"/></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RailItem}" Tag="SecDeveloper" Checked="Rail_Checked">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Edit}" Style="{StaticResource Icon.Small}" Margin="0,0,10,0" Stroke="{StaticResource TintInk.Coral}"/><controls:TrackedText Text="DEVELOPER" Tracking="0.16"/></StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" x:Name="Sections">
                <!-- Performance -->
                <TextBlock x:Name="SecPerformance" Text="PERFORMANCE" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RAM allocation" Style="{StaticResource SettingTitle}"/>
                                <TextBlock x:Name="RamWhyText" Text="Auto: Origin picks the right amount for each version." Style="{StaticResource SettingWhy}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RamAutoButton" Content="Back to Auto" Style="{StaticResource Button.Secondary}"
                                    VerticalAlignment="Center" Visibility="Collapsed" Click="RamAutoButton_Click"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- The readout comes first: setting Minimum fires ValueChanged during load, and the
                                 handler writes to it. -->
                            <TextBlock Grid.Column="1" x:Name="RamValueText" Text="4096 MB" MinWidth="80" TextAlignment="Right"
                                       FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <Slider x:Name="RamSlider" Minimum="1024" SmallChange="256" VerticalAlignment="Center"
                                    LargeChange="1024" TickFrequency="256" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="RAM allocation"
                                    ValueChanged="RamSlider_ValueChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Shader cache" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Reduces stutter while shaders compile." Style="{StaticResource SettingWhy}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="ShaderCacheToggle" Style="{StaticResource Toggle.Slider}" AutomationProperties.Name="Shader cache"
                                      VerticalAlignment="Center"
                                      Checked="ShaderCacheToggle_Checked" Unchecked="ShaderCacheToggle_Unchecked"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Recommended for this PC" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Picks render distance, particles, clouds and graphics to match your PC. Changes video settings in every version you have played."
                                       Style="{StaticResource SettingWhy}"/>
                            <TextBlock x:Name="PresetStatusText" Style="{StaticResource SettingWhy}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="PresetButton" Content="Apply" Style="{StaticResource Button.Secondary}"
                                VerticalAlignment="Center" AutomationProperties.Name="Apply recommended video settings"
                                Click="PresetButton_Click"/>
                    </Grid>
                </Border>

                <!-- Game -->
                <TextBlock x:Name="SecGame" Text="GAME" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Install folder" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="Where Minecraft's game files are kept." Style="{StaticResource SettingWhy}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="InstallPathTextBox" LostFocus="InstallPathTextBox_LostFocus"
                                     AutomationProperties.Name="Install folder"/>
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource Button.Secondary}"
                                    Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Resolution" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Window size when the game opens." Style="{StaticResource SettingWhy}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ResolutionWidthTextBox" Width="96" TextAlignment="Center" LostFocus="ResolutionTextBox_LostFocus"
                                     AutomationProperties.Name="Width"/>
                            <TextBlock Text="x" Style="{StaticResource Text.BodyDim}" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ResolutionHeightTextBox" Width="96" TextAlignment="Center" LostFocus="ResolutionTextBox_LostFocus"
                                     AutomationProperties.Name="Height"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- JVM arguments (per version: the lineup spans Java 8 to 25, so a
                     flag that is valid on one version aborts startup on another) -->
                <TextBlock x:Name="SecJvm" Text="JVM ARGUMENTS" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Arguments for" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Each version keeps its own: a flag one Java accepts can stop another from starting."
                                           Style="{StaticResource SettingWhy}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="JvmVersionComboBox" MinWidth="140" VerticalAlignment="Center"
                                      AutomationProperties.Name="Version" SelectionChanged="JvmVersionComboBox_SelectionChanged"/>
                        </Grid>
                        <TextBox x:Name="JvmArgsTextBox" Height="88" Margin="0,14,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Arguments"
                                 TextChanged="JvmArgsTextBox_TextChanged"
                                 LostFocus="JvmArgsTextBox_LostFocus"/>
                        <TextBlock x:Name="JvmArgsStatusText" Style="{StaticResource SettingWhy}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Replace defaults" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Use only your arguments, without Origin's tuned ones." Style="{StaticResource SettingWhy}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="JvmReplacePresetsToggle" Style="{StaticResource Toggle.Slider}" AutomationProperties.Name="Replace defaults"
                                          VerticalAlignment="Center"
                                          Checked="JvmReplacePresetsToggle_Checked" Unchecked="JvmReplacePresetsToggle_Unchecked"/>
                        </Grid>
                        <TextBlock x:Name="JvmCustomizedVersionsText" Style="{StaticResource SettingWhy}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Origin Client -->
                <TextBlock x:Name="SecClient" Text="ORIGIN CLIENT" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Origin UI" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Origin's menus and loading screens in game." Style="{StaticResource SettingWhy}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="OriginUiToggle" Style="{StaticResource Toggle.Slider}" AutomationProperties.Name="Origin UI"
                                      VerticalAlignment="Center"
                                      Checked="OriginUiToggle_Checked" Unchecked="OriginUiToggle_Unchecked"/>
                    </Grid>
                </Border>
                <!-- Settings Sync (Core/SettingsSync.cs): off by default. -->
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Sync settings across versions" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Your keybinds, video settings, mod settings, HUD positions and server list follow you to every version."
                                       Style="{StaticResource SettingWhy}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="SettingsSyncToggle" Style="{StaticResource Toggle.Slider}" AutomationProperties.Name="Sync settings across versions"
                                      VerticalAlignment="Center"
                                      Checked="SettingsSyncToggle_Checked" Unchecked="SettingsSyncToggle_Unchecked"/>
                    </Grid>
                </Border>

                <!-- Startup - the installer offers the same choice; this is where a
                     player turns it back off (one Run value, see InstallRegistry). -->
                <TextBlock x:Name="SecStartup" Text="STARTUP" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Open Origin when Windows starts" Style="{StaticResource SettingTitle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="StartWithWindowsToggle" Style="{StaticResource Toggle.Slider}" AutomationProperties.Name="Open Origin when Windows starts"
                                      VerticalAlignment="Center"
                                      Checked="StartWithWindowsToggle_Changed" Unchecked="StartWithWindowsToggle_Changed"/>
                    </Grid>
                </Border>

                <!-- Developer (temporary: remove before public release) -->
                <TextBlock x:Name="SecDeveloper" Text="DEVELOPER" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Offline test mode" Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Play without a Microsoft sign-in, for testing." Style="{StaticResource SettingWhy}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="OfflineTestToggle" Style="{StaticResource Toggle.Slider}" AutomationProperties.Name="Offline test mode"
                                      VerticalAlignment="Center"
                                      Checked="OfflineTestToggle_Checked" Unchecked="OfflineTestToggle_Unchecked"/>
                    </Grid>
                </Border>

                <!-- Which build this is - what a bug report needs, and the one place
                     the launcher states it (Windows' Installed apps list keeps the
                     version first installed, not the self-updated one). -->
                <TextBlock x:Name="LauncherVersionText" Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center" Margin="0,32,0,8"/>
            </StackPanel>
        </Grid>
        </controls:PageColumn>
    </ScrollViewer>
</UserControl>
