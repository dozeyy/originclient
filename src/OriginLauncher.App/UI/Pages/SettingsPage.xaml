<UserControl x:Class="OriginLauncher.App.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <!-- MainWindow now reserves the compact navigation rail. Content is sized
         to fit
         within the window's MinHeight (600) without scrolling; the scrollbar
         is hidden rather than disabled so wheel-scroll still works as a
         safety net if a future addition pushes past that budget, instead of
         silently clipping content. -->
    <ScrollViewer Margin="{StaticResource Layout.PageMargin}" VerticalScrollBarVisibility="Hidden">
        <StackPanel MaxWidth="{StaticResource Layout.PageWidth}">
            <!-- Page head, as on the website: eyebrow, then the big line. -->
            <TextBlock Text="LAUNCHER" Style="{StaticResource Text.Eyebrow}" Margin="1,0,0,4"/>
            <TextBlock Text="Settings" Style="{StaticResource Text.Headline}" Margin="0,0,0,22"/>

            <!-- Performance -->
            <ContentControl Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Text="Performance" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>

                    <StackPanel Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RAM allocation" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" x:Name="RamValueText" Text="4096 MB" Style="{StaticResource Text.Body}"/>
                        </Grid>
                        <Slider x:Name="RamSlider" Minimum="1024" SmallChange="256"
                                LargeChange="1024" TickFrequency="256" IsSnapToTickEnabled="True"
                                ValueChanged="RamSlider_ValueChanged"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Shader cache" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" x:Name="ShaderCacheToggle" Style="{StaticResource Toggle.Switch}"
                                      VerticalAlignment="Center"
                                      ToolTip="Reduce shader compilation stutter"
                                      Checked="ShaderCacheToggle_Checked" Unchecked="ShaderCacheToggle_Unchecked"/>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Game -->
            <ContentControl Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Text="Game" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>

                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Install folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="InstallPathTextBox" LostFocus="InstallPathTextBox_LostFocus"/>
                            <Button Grid.Column="2" Content="Browse" Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0">
                        <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ResolutionWidthTextBox" LostFocus="ResolutionTextBox_LostFocus"/>
                            <TextBlock Grid.Column="1" Text="&#215;" Style="{StaticResource Text.BodyDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="ResolutionHeightTextBox" LostFocus="ResolutionTextBox_LostFocus"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- JVM arguments (per version: the lineup spans Java 8 to 25, so a
                 flag that is valid on one version aborts startup on another) -->
            <ContentControl Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Text="JVM arguments" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>

                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Version" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="JvmVersionComboBox" SelectionChanged="JvmVersionComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="JvmArgsTextBox" Height="88"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 TextChanged="JvmArgsTextBox_TextChanged"
                                 LostFocus="JvmArgsTextBox_LostFocus"/>
                        <TextBlock x:Name="JvmArgsStatusText" Style="{StaticResource Text.BodyDim}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Replace defaults" Style="{StaticResource Text.BodyDim}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" x:Name="JvmReplacePresetsToggle" Style="{StaticResource Toggle.Switch}"
                                      VerticalAlignment="Center"
                                      Checked="JvmReplacePresetsToggle_Checked" Unchecked="JvmReplacePresetsToggle_Unchecked"/>
                    </Grid>

                    <TextBlock x:Name="JvmCustomizedVersionsText" Style="{StaticResource Text.BodyDim}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </ContentControl>

            <!-- Origin Client -->
            <ContentControl Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Text="Origin Client" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Origin UI" Style="{StaticResource Text.BodyDim}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" x:Name="OriginUiToggle" Style="{StaticResource Toggle.Switch}"
                                      VerticalAlignment="Center"
                                      Checked="OriginUiToggle_Checked" Unchecked="OriginUiToggle_Unchecked"/>
                    </Grid>

                    <!-- Settings Sync (Core/SettingsSync.cs): off by default. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Sync settings across versions" Style="{StaticResource Text.BodyDim}"/>
                            <TextBlock Text="Your keybinds, video settings, mod settings, HUD positions and server list follow you to every version."
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="SettingsSyncToggle" Style="{StaticResource Toggle.Switch}"
                                      VerticalAlignment="Center"
                                      Checked="SettingsSyncToggle_Checked" Unchecked="SettingsSyncToggle_Unchecked"/>
                    </Grid>

                </StackPanel>
            </ContentControl>

            <!-- Startup — the installer offers the same choice; this is where a
                 player turns it back off (one Run value, see InstallRegistry). -->
            <ContentControl Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Open Origin when Windows starts" Style="{StaticResource Text.BodyDim}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" x:Name="StartWithWindowsToggle" Style="{StaticResource Toggle.Switch}"
                                      VerticalAlignment="Center"
                                      Checked="StartWithWindowsToggle_Changed" Unchecked="StartWithWindowsToggle_Changed"/>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Developer (temporary: remove before public release) -->
            <ContentControl Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Text="Developer" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Offline test mode" Style="{StaticResource Text.BodyDim}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" x:Name="OfflineTestToggle" Style="{StaticResource Toggle.Switch}"
                                      VerticalAlignment="Center"
                                      Checked="OfflineTestToggle_Checked" Unchecked="OfflineTestToggle_Unchecked"/>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Which build this is — what a bug report needs, and the one place
                 the launcher states it (Windows' Installed apps list keeps the
                 version first installed, not the self-updated one). -->
            <TextBlock x:Name="LauncherVersionText" Style="{StaticResource Text.BodyDim}"
                       HorizontalAlignment="Center" Margin="0,4,0,8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
