<UserControl x:Class="OriginLauncher.App.UI.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OriginLauncher.App.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A profile card: the shared card (Theme/Surfaces.xaml). Every card sits inside a ring wrapper built in
             code (2 px accent ring at a 2 px gap when selected, the same space transparent when not), so the grid
             stays even and the selected state never shifts a neighbour. -->
        <Style x:Key="Card.Profile" TargetType="Border" BasedOn="{StaticResource Surface.Card}"/>

        <!-- The dashed "New profile" card at the end of the grid: a thin dashed edge at the card's own radius. -->
        <Style x:Key="Card.New" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Card.Neutral}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Body" Background="Transparent">
                            <Rectangle x:Name="Dash" Stroke="{StaticResource Brush.Stroke}" StrokeThickness="1" StrokeDashArray="4 4"
                                       RadiusX="{StaticResource Radius.Lg.Value}" RadiusY="{StaticResource Radius.Lg.Value}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource Brush.Panel}"/>
                                <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Brush.TextMuted}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource Brush.Card}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Mod profiles as cards (Workbench): a named set of the player's own mods for
         ONE Minecraft version, optionally with a server. The page sits on the
         dimmed art; the top inset clears the 56 px bar. The create / edit form is a
         centred dialog over the page (FormLayer), not a panel that pushes the cards. -->
    <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
        </ScrollViewer.Resources>

        <controls:PageColumn x:Name="Column" Style="{StaticResource Page.Column}">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Profiles" Style="{StaticResource Text.Heading}" HorizontalAlignment="Left"/>
                    <TextBlock Text="Your setups. Each one keeps its own mods for one version, and can remember a server to join."
                               Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                               Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,8,0,0">
                    <Button x:Name="ImportButton" Style="{StaticResource Button.Secondary.Small}"
                            Margin="0,0,8,0" Click="ImportButton_Click"
                            ToolTip="Import from another launcher"
                            AutomationProperties.Name="Import from another launcher">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Import}" Style="{StaticResource Icon.Small}"
                                  Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Import" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewButton" Style="{StaticResource Button.Primary.Small}"
                            Click="NewButton_Click"
                            AutomationProperties.Name="New profile">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Icon.Small}"
                                  Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="New profile" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status strip (errors, "close Minecraft first", copy notes): a dot says the tone, danger for a
                 failure, accent for a note. Hidden when there is nothing to say. -->
            <Border x:Name="StatusBox" Visibility="Collapsed" Margin="0,0,0,16" Padding="12,8"
                    CornerRadius="{StaticResource Radius.Md}" Background="{StaticResource Brush.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusDot" Width="{StaticResource Size.Dot}" Height="{StaticResource Size.Dot}"
                            ui:Capsule.Round="True" VerticalAlignment="Top" Margin="{StaticResource Margin.StatusDot}"
                            Background="{StaticResource Brush.Accent}"/>
                    <TextBlock Grid.Column="1" x:Name="StatusText" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               TextTrimming="None"/>
                </Grid>
            </Border>

            <!-- "No profile" first, then one card per profile, then the dashed
                 "New profile" card (all built in code). Three across, then the next row
                 (Will, 2026-10-19), equal widths and rows. Each cell is a card plus its 4 px ring space
                 (2 px ring, 2 px gap), so cells touch and the cards sit 8 px apart; the -4 pulls the
                 ring space out so the cards line up with the page column. -->
            <UniformGrid x:Name="RowsPanel" Columns="3" Margin="-4"/>

        </StackPanel>
        </controls:PageColumn>
    </ScrollViewer>

    <!-- Create / edit: a dialog over the dimmed page. Escape or the X cancels; a
         click on the dim does nothing (a half-typed profile is never lost to a
         stray click). The emblem in the corner previews the card as you type. -->
    <Grid x:Name="FormPanel" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}"
          KeyDown="FormPanel_KeyDown">
        <Border Style="{StaticResource Surface.Dialog}" Width="{StaticResource Size.Dialog}" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="{StaticResource Margin.Dialog}">
            <!-- Header and footer stay put; only the fields scroll, when the window is too short for the whole form,
                 so Create / Save is always on screen. -->
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="FormEmblem" Width="{StaticResource Size.TileLg}" Height="{StaticResource Size.TileLg}" CornerRadius="{StaticResource Radius.Sm}"
                            Background="{StaticResource Tint.Slate}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="FormInitial" Text="P" Style="{StaticResource Text.Title}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- The picked icon (ProfileLook.EmblemGlyph); empty when the letter shows. -->
                            <Border x:Name="FormIcon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FormTitle" Grid.Column="1" Text="New profile" Style="{StaticResource Text.Heading}"
                               FontSize="{StaticResource FontSize.Heading}" LineHeight="{StaticResource FontSize.Heading}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource Social.Icon}" Margin="0,0,-8,0" Click="CancelButton_Click"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                </ScrollViewer.Resources>
            <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource Text.FieldLabel}"/>
                <StackPanel Margin="0,0,0,16">
                    <TextBox x:Name="NameBox" Style="{StaticResource Input.TextBox}" MaxLength="32"
                             AutomationProperties.Name="Profile name" TextChanged="NameBox_TextChanged"/>
                    <!-- The name rule's error, right under the box it belongs to (the server rule's sits at the foot). -->
                    <TextBlock x:Name="NameError" Foreground="{StaticResource Brush.DangerText}"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock Text="Emblem" Style="{StaticResource Text.FieldLabel}"/>
                <!-- 21 tiles (the letter, then ProfileLook.EmblemIcons), 28 square at a 4 px gap: 12 across in the
                     440 dialog, two even rows. -->
                <WrapPanel x:Name="IconRow" Orientation="Horizontal" Margin="0,0,0,12"/>

                <TextBlock Text="Colour" Style="{StaticResource Text.FieldLabel}"/>
                <StackPanel x:Name="TintRow" Orientation="Horizontal" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Version" Style="{StaticResource Text.FieldLabel}"/>
                        <ComboBox x:Name="VersionBox" AutomationProperties.Name="Minecraft version"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Server name (optional)" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox x:Name="ServerNameBox" Style="{StaticResource Input.TextBox}" MaxLength="32"
                                 AutomationProperties.Name="Server name"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Server to join (optional)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox x:Name="ServerAddressBox" Style="{StaticResource Input.TextBox}" MaxLength="255"
                         AutomationProperties.Name="Server address"/>
                <TextBlock x:Name="VersionHint" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="A profile belongs to one version. With a server, Home shows Join next to Play."/>

                <!-- An error is a caption in the danger text (the box it belongs to also wears a danger edge). -->
                <TextBlock x:Name="FormError" Foreground="{StaticResource Brush.DangerText}"
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
            </ScrollViewer>

                <!-- Footer (outside the scroll area): a ghost Cancel, then the primary; both lg (36). -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancel" Style="{StaticResource Button.Ghost}"
                            Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="Create profile" Style="{StaticResource Button.Primary.Medium}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
