<UserControl x:Class="OriginLauncher.App.UI.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A profile card: a flat panel that lifts to Card on hover. The selected
             one gets the family accent as its border (set in code). -->
        <Style x:Key="Card.Profile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14,16,14"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The dashed "New profile" card at the end of the grid. -->
        <Style x:Key="Card.New" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Card}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Body" Background="Transparent">
                            <Rectangle x:Name="Dash" Stroke="{StaticResource Brush.Track}" StrokeThickness="2" StrokeDashArray="5 4"
                                       RadiusX="4" RadiusY="4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource Brush.Panel}"/>
                                <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Brush.TextMuted}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource Brush.Card}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Mod profiles as cards (Poster): a named set of the player's own mods for
         ONE Minecraft version, optionally with a server. The page sits on the
         dimmed art; the top inset clears the 56 px bar. The create / edit form is a
         centred dialog over the page (FormLayer), not a panel that pushes the cards. -->
    <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Hidden" Focusable="False">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
        </ScrollViewer.Resources>

        <StackPanel x:Name="Column" MaxWidth="1000" Margin="32,100,32,40">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PROFILES" Style="{StaticResource Text.Poster}" HorizontalAlignment="Left"/>
                    <TextBlock Text="Your setups. Each one keeps its own mods for one version, and can remember a server to join."
                               Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                               Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,8,0,0">
                    <Button x:Name="ImportButton" Style="{StaticResource Button.Secondary}"
                            Padding="16,0" Height="40" Margin="0,0,10,0" Click="ImportButton_Click"
                            ToolTip="Import from another launcher"
                            AutomationProperties.Name="Import from another launcher">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Import}" Style="{StaticResource Icon.Base}"
                                  Width="14" Height="14" Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Import" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewButton" Style="{StaticResource Button.Primary}"
                            Padding="16,0" Height="40" Click="NewButton_Click"
                            AutomationProperties.Name="New profile">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Icon.Base}"
                                  Width="14" Height="14" Margin="0,0,8,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="New profile" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status line (errors, "close Minecraft first", copy notes) -->
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,16"/>

            <!-- "No profile" first, then one card per profile, then the dashed
                 "New profile" card (all built in code). Three across, then the next row
                 (Will, 2026-10-19), equal widths and rows; each card's 8 px right and bottom
                 margin is the gap both ways, and the -8 cancels the last column's. -->
            <UniformGrid x:Name="RowsPanel" Columns="3" Margin="0,0,-8,0"/>

        </StackPanel>
    </ScrollViewer>

    <!-- Create / edit: a dialog over the dimmed page. Escape or the X cancels; a
         click on the dim does nothing (a half-typed profile is never lost to a
         stray click). The emblem in the corner previews the card as you type. -->
    <Grid x:Name="FormPanel" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}"
          KeyDown="FormPanel_KeyDown">
        <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,72,32,32"
                Background="{StaticResource Brush.PanelElevated}" CornerRadius="{StaticResource Radius.Dialog}"
                Padding="24,20,24,24" Effect="{StaticResource Shadow.Card}">
            <!-- Scrolls only when the window is too short for the whole form. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                </ScrollViewer.Resources>
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="FormEmblem" Width="40" Height="40" CornerRadius="{StaticResource Radius.Sharp}"
                            Background="{StaticResource Tint.Slate}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="FormInitial" Text="P" Style="{StaticResource Text.CardTitle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- The picked icon (ProfileLook.EmblemGlyph); empty when the letter shows. -->
                            <Border x:Name="FormIcon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FormTitle" Grid.Column="1" Text="NEW PROFILE" Style="{StaticResource Text.Poster}"
                               FontSize="{StaticResource FontSize.DialogTitle}" LineHeight="{StaticResource FontSize.DialogTitle}"
                               VerticalAlignment="Center" Margin="14,2,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource Button.Chrome}" MinWidth="34" MinHeight="34" Padding="0"
                            VerticalAlignment="Center" Margin="0,0,-8,0" Click="CancelButton_Click"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Base}" Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>

                <TextBlock Text="Name" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Input.TextBox}" MaxLength="32"
                         AutomationProperties.Name="Profile name" Margin="0,0,0,16" TextChanged="NameBox_TextChanged"/>

                <TextBlock Text="Emblem" Style="{StaticResource Text.FieldLabel}"/>
                <!-- 21 tiles (the letter, then ProfileLook.EmblemIcons) in rows of 11. -->
                <WrapPanel x:Name="IconRow" Orientation="Horizontal" Margin="0,0,0,10"/>

                <TextBlock Text="Colour" Style="{StaticResource Text.FieldLabel}"/>
                <StackPanel x:Name="TintRow" Orientation="Horizontal" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Version" Style="{StaticResource Text.FieldLabel}"/>
                        <ComboBox x:Name="VersionBox" AutomationProperties.Name="Minecraft version"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Server name (optional)" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox x:Name="ServerNameBox" Style="{StaticResource Input.TextBox}" MaxLength="32"
                                 AutomationProperties.Name="Server name"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Server to join (optional)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox x:Name="ServerAddressBox" Style="{StaticResource Input.TextBox}" MaxLength="255"
                         AutomationProperties.Name="Server address"/>
                <TextBlock x:Name="VersionHint" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="A profile belongs to one version. With a server, Home shows Join next to Play."/>

                <TextBlock x:Name="FormError" Foreground="{StaticResource Brush.Danger}"
                           Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}"
                            Padding="20,0" Height="40" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="Create profile" Style="{StaticResource Button.Primary}"
                            Padding="20,0" Height="40" Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</UserControl>
