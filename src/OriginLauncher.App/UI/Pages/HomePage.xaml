<UserControl x:Class="OriginLauncher.App.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <!-- Home (Poster): the family art and the giant version numeral fill the
         window (ArtStage, behind every page). Everything here sits in one bottom
         strip so the art and the number stay clear: the version pill and the profile
         pill (48 px) with the status line under them on the left; the My mods switch,
         Join (48 px) and Play on the right. Row 0 holds every control and centres them
         on one line; the status line is row 1. -->
    <Grid x:Name="HomeRoot">

        <!-- Top right, under the bar: the home banner's slot. Empty while
             HomePage.HomeBannerOn is false (Will, 2026-10-19: off for now, it fought the
             poster); the feed code (PromoBanner, Core/Promos) is untouched and comes back
             by flipping that flag. The first-run welcome hides it while it shows. -->
        <Grid x:Name="BannerSlot" Width="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,72,32,0"/>

        <Grid x:Name="HomeCard" VerticalAlignment="Bottom" Margin="32,0,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StripShift"/>
            </Grid.RenderTransform>

            
                <!-- No family eyebrow above the pills (Will, 2026-10-19): the pill already
                     names the version, and the art and numeral name the family.
                     A DockPanel, not a StackPanel: when Play grows (RUNNING, Join) or the
                     window is narrow, the profile pill gets the width that is left and its
                     name trims, instead of the whole row being cut off. -->
                <DockPanel x:Name="HomeLockup" Grid.Row="0" Grid.Column="0" LastChildFill="True"
                           VerticalAlignment="Center" Margin="0,0,24,0">
                    <!-- The version pill: opens the whole-window picker. -->
                    <Button x:Name="VersionButton" DockPanel.Dock="Left" Style="{StaticResource Button.Pill}"
                            Click="VersionButton_Click"
                            AutomationProperties.Name="Choose Minecraft version">
                        <StackPanel Orientation="Horizontal">
                            <controls:TrackedText x:Name="VersionButtonText" Text="1.21.1" Tracking="0" TabularDigits="False"
                                                  FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource FontSize.PillNumber}"
                                                  FontWeight="ExtraBold" Foreground="{StaticResource Brush.Text}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon.Small}"
                                  VerticalAlignment="Center" Stroke="{StaticResource Brush.TextDim}"/>
                        </StackPanel>
                    </Button>

                    <!-- The profile chip: the mod profile Play will use; opens Profiles. -->
                    <Button x:Name="ProfileRow" Style="{StaticResource Button.Pill}" Margin="8,0,0,0"
                            HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                            Click="ProfileRow_Click"
                            AutomationProperties.Name="Switch profile">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProfileEmblem" Width="{StaticResource Size.Emblem}" Height="{StaticResource Size.Emblem}"
                                    CornerRadius="{StaticResource Radius.Chip}" Margin="0,0,8,0">
                                <Grid>
                                    <!-- No profile: the Origin mark itself (plain Origin), never a bare letter. -->
                                    <controls:OriginMark x:Name="ProfileMark" Width="24" Height="24"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- The profile's icon (ProfileLook.EmblemGlyph); empty when its letter shows. -->
                                    <Border x:Name="ProfileIcon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <controls:TrackedText x:Name="ProfileInitial" Text="" Tracking="0" FontSize="15" FontWeight="Bold"
                                                          Foreground="{StaticResource Brush.OnPhoto}" Visibility="Collapsed"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ProfileNameText" Grid.Column="1" Text="No profile" Style="{StaticResource Text.PillTitle}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                            <Path Grid.Column="2" Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon.Small}"
                                  VerticalAlignment="Center" Stroke="{StaticResource Brush.TextDim}"/>
                        </Grid>
                    </Button>
                </DockPanel>

                <!-- The status line: a 6 px square (the accent while live) and one line. The
                     players-online count joins it once it arrives, and only then. -->
                <StackPanel x:Name="StatusRow" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,12,0,0">
                    <Rectangle x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Brush.TextDim}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Sign in to play" Style="{StaticResource Text.Status}"
                               Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <StackPanel x:Name="PlayersPill" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                        <TextBlock Text="/" Style="{StaticResource Text.Status}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlayersText" Style="{StaticResource Text.Status}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

            <!-- Play, Join and the My mods switch: centred in row 0 with the pills, so the pills'
                 centre line, Join's and the Play ring's are one line (PLAY's caps centre on the ring). -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- My mods (Will, 2026-10-19: "maybe a slider would be better like a slider on
                     or off"): the Mods page's YOUR MODS switch on Home, the same setting
                     (LauncherSettings.PlayWithExternalMods). No box: a caps label and the
                     Toggle.Slider switch (Theme/Inputs.xaml), filled with the family accent when on. -->
                <ToggleButton x:Name="MyModsSwitch" Style="{StaticResource Toggle.Slider}" Margin="0,0,28,0"
                              VerticalAlignment="Center" Click="MyModsSwitch_Click"
                              AutomationProperties.Name="My mods">
                    <controls:TrackedText Text="MY MODS" Tracking="0.14" FontFamily="{StaticResource Font.Display}"
                                          FontSize="{StaticResource FontSize.Eyebrow}" FontWeight="SemiBold"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </ToggleButton>

                <!-- The selected profile's server: straight in with that profile's mods.
                     Hidden when the profile has none. -->
                <Button x:Name="JoinButton" Style="{StaticResource Button.Pill}"
                        Margin="0,0,32,0" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="JoinButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Server}" Style="{StaticResource Icon.Base}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              Stroke="{StaticResource Brush.Text}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Join server" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.TextDim}" LineHeight="16"/>
                            <TextBlock x:Name="JoinServerText" Text="Server" Style="{StaticResource Text.Label}" LineHeight="18"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Play (option 6): the word and an accent ring whose arrow fills on hover. -->
                <Button x:Name="PlayButton" Style="{StaticResource Button.PlayHero}" VerticalAlignment="Center"
                        IsEnabled="False"
                        AutomationProperties.Name="Play Minecraft"
                        Click="PlayButton_Click">
                    <Grid>
                        <controls:TrackedText x:Name="PlayLabel" Text="PLAY" Tracking="0.02"
                                              FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource FontSize.PlayWord}" FontWeight="ExtraBold"
                                              Foreground="{StaticResource Brush.OnPhoto}" VerticalAlignment="Center"/>
                        <!-- The selected account's game is already open: Play becomes
                             RUNNING and clicking it brings that window forward. -->
                        <controls:TrackedText x:Name="RunningLabel" Text="RUNNING" Tracking="0.02" Visibility="Collapsed"
                                              FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource FontSize.PlayWord}" FontWeight="ExtraBold"
                                              Foreground="{StaticResource Brush.OnPhoto}" VerticalAlignment="Center"/>
                        <Path x:Name="PlaySpinner" Visibility="Collapsed"
                              Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{StaticResource Icon.Loading}"
                              Style="{StaticResource Icon.Base}"
                              Stroke="{StaticResource Brush.OnPhoto}"
                              RenderTransformOrigin="0.5,0.5"/>
                    </Grid>
                </Button>
            </StackPanel>
            <!-- The Origin Store: capes and cosmetics. A small quiet chip on the strip's second line,
                 level with the status line and under Play's column: easy to find, never competing with
                 Play, and it takes no width from the pills (the first line is full when a profile,
                 Join and RUNNING are all up). The gold glyph is the soft accent; no art, no glow.
                 Opens OriginLinks.Store in the default browser. -->
            <Button x:Name="StoreButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource Button.Secondary.Small}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"
                    Click="StoreButton_Click"
                    AutomationProperties.Name="Open the Origin Store in your browser">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Store}" Style="{StaticResource Icon.Small}"
                          VerticalAlignment="Center" Margin="0,0,8,0" Stroke="{StaticResource TintInk.Gold}"/>
                    <TextBlock Text="Origin Store" Style="{StaticResource Text.Status}" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- Version picker above Home content, below the launch screen, so a launch
             that starts while it is (somehow) open still covers it. Both fill the
             whole window, top bar included. -->
        <!-- The one-time first-run welcome: centred over Home (the banner stays hidden while it shows). -->
        <controls:ImportPromptCard x:Name="ImportCard"/>

        <controls:VersionSelectOverlay x:Name="VersionOverlay"/>
        <controls:LaunchLoadingOverlay x:Name="LoadingOverlay"/>
    </Grid>
</UserControl>
