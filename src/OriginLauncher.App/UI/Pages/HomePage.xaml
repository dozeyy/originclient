<UserControl x:Class="OriginLauncher.App.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <!-- Home (Workbench, Will's approved mockup): the family art in full colour and the giant version numeral fill the
         window (ArtStage, behind every page). Everything here sits in one bottom strip: on the left the version card
         (family art thumbnail, version, family name, chevron) with the status line under it; on the right,
         bottom-aligned, the My mods switch, Join (only when the active profile has a server) and the solid emerald Play
         button. The cards and Play are 64 tall, the thumbnail 48 (Size.StripControl / StripTile). No profile switcher
         and no Store here (Will, 2026-10-25): the profile is picked on the Profiles page, the Store is in the top bar. -->
    <Grid x:Name="HomeRoot">

        <!-- Top right, under the bar: the home banner's slot. Empty while
             HomePage.HomeBannerOn is false (Will, 2026-10-19: off for now, it fought the
             poster); the feed code (PromoBanner, Core/Promos) is untouched and comes back
             by flipping that flag. The first-run welcome hides it while it shows. -->
        <Grid x:Name="BannerSlot" Width="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,72,32,0"/>

        <Grid x:Name="HomeCard" VerticalAlignment="Bottom" Margin="32,0,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StripShift"/>
            </Grid.RenderTransform>

            <!-- Left: the version card, then the status line under it. -->
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,24,0">
                <!-- The version card: opens the whole-window picker. -->
                <Button x:Name="VersionButton" Style="{StaticResource Button.StripCard}" HorizontalAlignment="Left"
                        Click="VersionButton_Click"
                        AutomationProperties.Name="Choose Minecraft version">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{StaticResource Size.StripTile}" Height="{StaticResource Size.StripTile}"
                                CornerRadius="{StaticResource Radius.Md}" ClipToBounds="True"
                                Background="{StaticResource Brush.CardAlt}" Margin="0,0,12,0">
                            <Image x:Name="VersionThumb" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <controls:TrackedText x:Name="VersionButtonText" Text="1.21.1" Tracking="0" TabularDigits="False"
                                                  FontFamily="{StaticResource Font.Primary}" FontSize="{StaticResource FontSize.Heading}"
                                                  FontWeight="Bold" Foreground="{StaticResource Brush.Text}"
                                                  HorizontalAlignment="Left"/>
                            <TextBlock x:Name="VersionTagline" Text="" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon.Small}"
                              VerticalAlignment="Center" Stroke="{StaticResource Brush.TextDim}"/>
                    </StackPanel>
                </Button>

                <!-- The status line: an 8 px round dot (the accent while live) and one line. The
                     players-online count joins it once it arrives, and only then. -->
                <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="4,10,0,0">
                    <Ellipse x:Name="StatusDot" Width="{StaticResource Size.StatusDot}" Height="{StaticResource Size.StatusDot}"
                             Fill="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Sign in to play" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                               LineHeight="{StaticResource Size.StatusLine}" LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis" MaxWidth="{StaticResource Size.StatusWidth}"/>
                    <StackPanel x:Name="PlayersPill" Orientation="Horizontal" Visibility="Collapsed" Margin="14,0,0,0">
                        <TextBlock Text="/" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlayersText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right, bottom-aligned with the status line: My mods, Join, Play. Every item is centred on the
                 cluster's one 64 px line. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <!-- My mods (Will, 2026-10-19: a slider, on or off): the Mods page's YOUR MODS switch on Home, the same
                     setting (LauncherSettings.PlayWithExternalMods). A tracked caps label and the iOS-style switch
                     (Toggle.HomeSwitch, Theme/Inputs.xaml): emerald with a dark knob when on. -->
                <ToggleButton x:Name="MyModsSwitch" Style="{StaticResource Toggle.HomeSwitch}" Margin="0,0,12,0"
                              VerticalAlignment="Center" Click="MyModsSwitch_Click"
                              AutomationProperties.Name="My mods">
                    <controls:TrackedText Text="MY MODS" Tracking="0.14" FontFamily="{StaticResource Font.Primary}"
                                          FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </ToggleButton>

                <!-- The selected profile's server: straight in with that profile's mods.
                     Hidden when the profile has none. Short of width it folds to its icon, a 64 square (FitStrip). -->
                <Button x:Name="JoinButton" Style="{StaticResource Button.StripCard}" Padding="14,0" HorizontalContentAlignment="Center"
                        Margin="0,0,12,0" VerticalAlignment="Center"
                        Visibility="Collapsed" Click="JoinButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="JoinIcon" Data="{StaticResource Icon.Server}" Style="{StaticResource Icon.Base}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              Stroke="{StaticResource Brush.Text}"/>
                        <StackPanel x:Name="JoinWords" VerticalAlignment="Center">
                            <TextBlock Text="Join server" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.TextDim}" LineHeight="16"/>
                            <TextBlock x:Name="JoinServerText" Text="Server" Style="{StaticResource Text.BodyStrong}" LineHeight="18"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Play (Workbench): the solid emerald card with a play triangle and the word. -->
                <Button x:Name="PlayButton" Style="{StaticResource Button.PlayHero}" VerticalAlignment="Center"
                        IsEnabled="False"
                        AutomationProperties.Name="Play Minecraft"
                        Click="PlayButton_Click">
                    <Grid>
                        <!-- Hidden, not Collapsed, while the spinner shows: the spinner takes the face's place without
                             the button changing width. -->
                        <StackPanel x:Name="PlayFace" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Play}" Style="{StaticResource Icon.Base}" Width="{StaticResource Icon.SizeLarge}"
                                  Height="{StaticResource Icon.SizeLarge}" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <controls:TrackedText x:Name="PlayLabel" Text="Play" Tracking="0.02"
                                                  FontFamily="{StaticResource Font.Primary}" FontSize="{StaticResource FontSize.Action}" FontWeight="Bold"
                                                  VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- The selected account's game is already open: Play becomes
                             Running and clicking it brings that window forward. -->
                        <controls:TrackedText x:Name="RunningLabel" Text="Running" Tracking="0.02" Visibility="Collapsed"
                                              FontFamily="{StaticResource Font.Primary}" FontSize="{StaticResource FontSize.Action}" FontWeight="Bold"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="PlaySpinner" Visibility="Collapsed"
                              Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{StaticResource Icon.Loading}"
                              Style="{StaticResource Icon.Base}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              RenderTransformOrigin="0.5,0.5"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Version picker above Home content, below the launch screen, so a launch
             that starts while it is (somehow) open still covers it. Both fill the
             whole window, top bar included. -->
        <!-- The one-time first-run welcome: centred over Home (the banner stays hidden while it shows). -->
        <controls:ImportPromptCard x:Name="ImportCard"/>

        <controls:VersionSelectOverlay x:Name="VersionOverlay"/>
        <controls:LaunchLoadingOverlay x:Name="LoadingOverlay"/>
    </Grid>
</UserControl>
