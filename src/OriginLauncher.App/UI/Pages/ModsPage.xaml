<UserControl x:Class="OriginLauncher.App.UI.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One mod row: the shared row (Theme/Surfaces.xaml: Panel, lifts to Card on hover). -->
        <Style x:Key="Row.Mod" TargetType="Border" BasedOn="{StaticResource Surface.Row}"/>
        <Style x:Key="Mods.IconWell" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        </Style>
    </UserControl.Resources>

    <!-- The page sits on the dimmed art (ArtStage.SetPage). The top inset clears
         the 56 px bar; the scrollbar stays hidden, wheel scrolling still works. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" Focusable="False">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
        </ScrollViewer.Resources>

        <controls:PageColumn x:Name="Column" Style="{StaticResource Page.Column}">
        <StackPanel>

            <!-- Header: the poster title + version tag, the intro, and the
                 YOUR MODS switch (load your own jars or not, every launch). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MODS" Style="{StaticResource Text.Heading}"/>
                        <Border x:Name="VersionChip" Style="{StaticResource Surface.Chip}" Margin="12,0,0,8" VerticalAlignment="Bottom">
                            <TextBlock x:Name="VersionChipText" Text="1.21.1" Style="{StaticResource Surface.ChipText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="IntroText" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap" MaxWidth="500"
                               HorizontalAlignment="Left" Margin="0,10,0,0"
                               Text="Your own .jar mods for this version, shared by all your accounts. Origin's built-in mods stay up to date on their own."/>
                </StackPanel>

                <!-- The switch (load your own jars or not, every launch): the same label and slider as Home's
                     MY MODS, no box and no On/Off word; the slider says it. -->
                <ToggleButton Grid.Column="1" x:Name="YourModsSwitch" Style="{StaticResource Toggle.Slider}"
                              Margin="24,8,0,0" VerticalAlignment="Top" ToolTip="Load the .jar mods you added"
                              AutomationProperties.Name="Load your mods"
                              Checked="YourModsSwitch_Changed" Unchecked="YourModsSwitch_Changed">
                    <controls:TrackedText Text="MY MODS" Tracking="0.14" FontFamily="{StaticResource Font.Primary}"
                                          FontSize="{StaticResource FontSize.Label}" FontWeight="SemiBold"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </ToggleButton>
            </Grid>

            <!-- The drop zone. Real drag and drop: a jar over it grows the zone,
                 lights it in the family accent and swaps the line to "Release to
                 add"; a drop lands the new rows below. Click / Enter browses. -->
            <Grid x:Name="DropZone" Height="168" Margin="0,28,0,32" AllowDrop="True" Cursor="Hand"
                  Focusable="True" FocusVisualStyle="{StaticResource Focus.Card}"
                  Background="{StaticResource Brush.Panel}" RenderTransformOrigin="0.5,0.5"
                  AutomationProperties.Name="Add mods: drag and drop mod jars here, or browse"
                  MouseEnter="DropZone_MouseEnter" MouseLeave="DropZone_MouseLeave"
                  MouseLeftButtonUp="DropZone_Click" KeyDown="DropZone_KeyDown"
                  DragEnter="DropZone_DragEnter" DragOver="DropZone_DragEnter"
                  DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="DropScale"/>
                </Grid.RenderTransform>
                <!-- The accent light rising from the bottom edge while a jar is over. -->
                <Rectangle x:Name="DropLit" Fill="{DynamicResource Brush.Accent}" Opacity="0" IsHitTestVisible="False">
                    <Rectangle.OpacityMask>
                        <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.6" RadiusY="0.9">
                            <GradientStop Color="{StaticResource Color.MaskSoft}" Offset="0"/>
                            <GradientStop Color="{StaticResource Color.MaskClear}" Offset="0.6"/>
                        </RadialGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="DropDash" Stroke="{StaticResource Brush.ProgressTrack}" StrokeThickness="2" StrokeDashArray="5 4"
                           RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="JarWell" Width="64" Height="64" Background="{StaticResource Brush.Bg}"
                            CornerRadius="{StaticResource Radius.Md}" RenderTransformOrigin="0.5,0.5" Margin="0,0,20,0">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="JarScale"/>
                                <TranslateTransform x:Name="JarLift"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Path x:Name="JarIcon" Data="{StaticResource Icon.Drop}" Style="{StaticResource Icon.Base}" Width="30" Height="30"
                              Stroke="{StaticResource Brush.TextDim}"/>
                    </Border>
                    <Grid VerticalAlignment="Center">
                        <StackPanel x:Name="IdleText">
                            <TextBlock x:Name="DropTitle" Text="Drag and drop mod jars here" Style="{StaticResource Text.Title}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                <Run Text="or"/>
                                <Run Text="browse" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="OverText" Text="Release to add" Style="{StaticResource Text.Title}" Opacity="0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- The "ghost" of what is being carried: how many jars. -->
                <Border x:Name="Ghost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,140,0"
                        Background="{StaticResource Brush.CardAlt}" CornerRadius="{StaticResource Radius.Md}"
                        Padding="12,10,20,10" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform x:Name="GhostTilt"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Md}"
                                Margin="0,0,12,0">
                            <Path Data="{StaticResource Icon.Jar}" Style="{StaticResource Icon.Base}"
                                  Stroke="{StaticResource Brush.Text}"/>
                        </Border>
                        <TextBlock x:Name="GhostText" Text="1 mod jar" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status line (import errors, "close Minecraft first", how many were added). -->
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,-20,0,20"/>

            <!-- Your mods -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:TrackedText x:Name="UserHeader" Text="MY MODS" Tracking="0.16" FontSize="{StaticResource FontSize.Label}"
                                          FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock x:Name="UserCount" Text="0" FontSize="{StaticResource FontSize.Label}" FontWeight="Bold" Margin="8,0,0,0"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="UserHint" Text="Switch one off to keep it without loading it"
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,12,0"/>
                <Button Grid.Column="2" x:Name="OpenFolderButton" Style="{StaticResource Button.Secondary.Small}"
                        Click="OpenFolder_Click" ToolTip="Open this mods folder">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon.Small}" Margin="0,0,8,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="Open folder" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel x:Name="UserModsPanel"/>
            <Border x:Name="UserEmptyState" Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Lg}" Padding="16">
                <TextBlock x:Name="UserEmptyText" Text="No mods yet. Drop a jar above to add one."
                           Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap"/>
            </Border>

            <!-- Built in (Origin-managed, read-only) -->
            <StackPanel x:Name="BuiltInSection" Visibility="Collapsed" Margin="0,32,0,0">
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:TrackedText Text="BUILT IN" Tracking="0.16" FontSize="{StaticResource FontSize.Label}"
                                              FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock x:Name="BuiltInCount" Text="0" FontSize="{StaticResource FontSize.Label}" FontWeight="Bold" Margin="8,0,0,0"
                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kept up to date by Origin" Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <UniformGrid x:Name="BuiltInPanel" Columns="3" Margin="0,0,-4,0"/>
            </StackPanel>

        </StackPanel>
        </controls:PageColumn>
    </ScrollViewer>
</UserControl>
