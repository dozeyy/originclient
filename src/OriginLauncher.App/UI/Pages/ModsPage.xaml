<UserControl x:Class="OriginLauncher.App.UI.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Card surface with a hover edge. The code-behind only sets local values
             while a file is dragged over it, and clears them again afterwards. -->
        <Style x:Key="ModsPage.DropZone" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.PanelGlass}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- MainWindow reserves the compact navigation rail. Scrollbar stays hidden
         while wheel scrolling remains available. -->
    <ScrollViewer Margin="{StaticResource Layout.PageMargin}" VerticalScrollBarVisibility="Hidden">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
        </ScrollViewer.Resources>

        <StackPanel MaxWidth="{StaticResource Layout.PageWidth}">

            <!-- Page head, as on the website: eyebrow, then the big line; the
                 version this list belongs to sits on the right as a chip. -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MINECRAFT" Style="{StaticResource Text.Eyebrow}" Margin="1,0,0,4"/>
                    <TextBlock Text="Mods" Style="{StaticResource Text.Headline}"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="VersionChip" VerticalAlignment="Bottom"
                        Style="{StaticResource Chip.Accent}" Margin="0,0,0,6" Padding="10,5">
                    <TextBlock x:Name="VersionChipText" Text="—" Style="{StaticResource Text.Chip}" FontSize="{StaticResource FontSize.Body}"/>
                </Border>
            </Grid>

            <!-- Drop zone: drag .jar files in, or click to open the mods folder -->
            <Border x:Name="DropZone" AllowDrop="True" Cursor="Hand"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
                    Padding="30" Margin="0,0,0,24"
                    MouseLeftButtonUp="DropZone_Click"
                    Style="{StaticResource ModsPage.DropZone}"
                    DragEnter="DropZone_DragEnter" DragOver="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon.Base}"
                          Width="34" Height="34" Stroke="{StaticResource Brush.TextDim}"
                          HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Drop .jar mods"
                               Style="{StaticResource Text.Body}" HorizontalAlignment="Center"/>
                    <TextBlock Text="or open the folder"
                               Style="{StaticResource Text.BodyDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="Shared by all your accounts on this version"
                               Style="{StaticResource Text.BodyDim}" HorizontalAlignment="Center" Margin="0,10,0,0"
                               Opacity="0.7"/>
                </StackPanel>
            </Border>

            <!-- Status line (import errors, "close Minecraft first", etc.) -->
            <TextBlock x:Name="StatusText" Style="{StaticResource Text.BodyDim}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,12"/>

            <!-- Your mods -->
            <TextBlock Text="Your mods" Style="{StaticResource Text.H2}" Margin="2,0,0,10"/>
            <StackPanel x:Name="UserModsPanel"/>
            <TextBlock x:Name="UserEmptyState"
                       Text="No mods"
                       Style="{StaticResource Text.BodyDim}" Margin="2,2,0,0"/>

            <!-- Built-in (Origin-managed, read-only) -->
            <StackPanel x:Name="BuiltInSection" Visibility="Collapsed" Margin="0,20,0,0">
                <TextBlock Text="Built-in" Style="{StaticResource Text.H2}" Margin="2,0,0,10"/>
                <StackPanel x:Name="BuiltInPanel"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
