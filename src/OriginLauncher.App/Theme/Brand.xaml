<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        THE ONE BRAND REFERENCE in the launcher (docs/overhaul/DESIGN-SYSTEM.md section 1.5; Will, 2026-10-25: the
        official logo only, never redrawn). Every window and control that shows the mark or the wordmark reads
        these two keys (through UI/Controls/BrandLogo for the mark) and nothing else. Both are the unmodified
        master files, embedded by OriginLauncher.App.csproj:
          Brand.Logo      textures/ui/origin_logo.png  (256 x 256, the same art as Assets/origin.ico; linked from
                          the 1.21.1 module's texture so there is no second copy to drift)
          Brand.Wordmark  Assets/Brand/wordmark.png    (430 x 88)
        Sizes come from Size.Logo.* / Size.Wordmark.* in Spacing.xaml. Do not draw rings, ellipses or paths for the
        mark, do not give it a glow, shadow or rotation, and do not resize the files on disk: WPF resamples them
        when it draws them. tools/design/check_logo.py fails the build if a drawn mark comes back.
    -->
    <BitmapImage x:Key="Brand.Logo" UriSource="pack://application:,,,/OriginLauncher.App;component/Assets/Brand/origin_logo.png" CacheOption="OnLoad"/>
    <BitmapImage x:Key="Brand.Wordmark" UriSource="pack://application:,,,/OriginLauncher.App;component/Assets/Brand/wordmark.png" CacheOption="OnLoad"/>

</ResourceDictionary>
