<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pop-up menus (right-click / "..." menus), Workbench spec 5:
         panel   Card fill, 1 px strong line, Radius.Md, Shadow.Overlay, 4 px padding, at most 320 wide.
         item    32 tall (Size.ControlMd), Radius.Sm, 10 px sides; hover / keyboard-highlight = the white 6 % wash
                 (Brush.GhostHover); disabled = 45 %; a destructive item sets Foreground to Brush.DangerText.
         motion  opens 4 px below its anchor and rises 4 px while it fades in (Motion.Enter, ease out); it never
                 animates out (a closing popup is gone at once, which is what feels instant).
         The Windows default is a light system menu; every value here is a token from Colors / Spacing, so a theme
         swap restyles menus with everything else.
         The popup is a transparent window: the outer Grid is the room (Popup.Bleed) Shadow.Overlay draws into, and
         the shadow sits on its own static, empty border so scrolling or hovering the items never re-rasterises it. -->

    <Style x:Key="Menu.Popup" TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="HorizontalOffset" Value="{StaticResource Popup.OffsetX}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="{StaticResource Popup.Bleed}">
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Md}"
                                Effect="{StaticResource Shadow.Overlay}" IsHitTestVisible="False"/>
                        <Border x:Name="Panel" Background="{StaticResource Brush.Card}"
                                BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}" Padding="4"
                                MinWidth="196" MaxWidth="320" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Rise" Y="4"/>
                            </Border.RenderTransform>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="{StaticResource Motion.Enter}"/>
                                    <DoubleAnimation Storyboard.TargetName="Rise" Storyboard.TargetProperty="Y"
                                                     From="4" To="0" Duration="{StaticResource Motion.Enter}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon (optional) + header. Set Foreground for a destructive item. A long header trims with an ellipsis
         (the panel is at most 320 wide) and the keyboard highlight looks exactly like the mouse hover. -->
    <Style x:Key="Menu.Item" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{StaticResource Radius.Sm}" MinHeight="{StaticResource Size.ControlMd}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.GhostHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.GhostPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Menu.Separator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{StaticResource Brush.SoftStroke}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
