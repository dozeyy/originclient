<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
                    xmlns:ui="clr-namespace:OriginLauncher.App.UI">

    <!-- Friends / party / chat (the drawer and its toasts). Built only from the
         tokens in Colors / Typography / Spacing / Buttons: change those and the
         whole social surface follows. The values that are only about this
         surface's rhythm live here. -->

    <system:Double x:Key="Social.AvatarSize">32</system:Double>

    <!-- Section labels (Social.Section) use Brush.TextDim, like Text.Label. Other small print (times,
         day dividers, the character counter, hints) uses Brush.TextMuted, which is 4.7:1 or better on
         Card, PanelElevated and the chat well. -->

    <!-- Card-group corners (a row's place in its group: first, middle, last), used by the focus frame, the
         party card and the Import drawer's grouped cards. Corner size comes from the caller. -->
    <controls:CardCornersConverter x:Key="Social.CardCorners"/>

    <!-- The drawer row (Friends, Accounts' sibling, Import): flat on the drawer's surface, no card fill and no
         dividers; hover lifts it one step to Card, press one more to CardAlt. Radius.Sm, padding 8,6. A row that is
         not itself pressable (requests, invites, hints, blocked) is the Border; one you press is the Button. -->
    <Style x:Key="Social.DrawerRowStatic" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- One person's head (UI/Controls/PlayerHead: their real skin's face + hat,
         fetched from Mojang only, never a third-party image service) on a raised block. -->
    <Style x:Key="Social.Avatar" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Social.AvatarSize}"/>
        <Setter Property="Height" Value="{StaticResource Social.AvatarSize}"/>
        <Setter Property="Background" Value="{StaticResource Brush.CardAlt}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xs}"/>
    </Style>

    <Style x:Key="Social.Initial" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <!-- The presence square sits on the avatar's corner; its ring is the drawer surface. -->
    <Style x:Key="Social.Dot" TargetType="Border">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,-3,-3"/>
        <Setter Property="Background" Value="{StaticResource Brush.Success}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xs}"/>
    </Style>

    <Style x:Key="Social.Name" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="Social.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Small print (times, counters, day dividers). -->
    <Style x:Key="Social.Quiet" TargetType="TextBlock" BasedOn="{StaticResource Social.Caption}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    </Style>

    <Style x:Key="Social.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Placeholder text over an empty TextBox (Input.TextBox has none). -->
    <Style x:Key="Social.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="Margin" Value="13,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- A list row you can press (the whole row opens the conversation): the flat drawer row,
         a step lighter on hover and press, the family-accent frame on keyboard focus (like
         Focus.Button). Inner buttons keep their own clicks. -->
    <!-- The keyboard focus frame: an outset 2 px frame around the row, corners following the row's
         place in its card (first, middle, last) at the card radius plus the outset (Radius.Ring.Lg).
         The frame is an adorner, so the next row can't cover it; it reads the row's Pos through the
         adorner's AdornedElement. A button that isn't a card row gets the full rounded frame. -->
    <Style x:Key="Social.RowFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2"
                            IsHitTestVisible="False">
                        <Border.CornerRadius>
                            <MultiBinding Converter="{StaticResource Social.CardCorners}">
                                <Binding Path="AdornedElement.DataContext.Pos"
                                         RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Adorner}}"/>
                                <Binding Source="{StaticResource Radius.Ring.Lg}"/>
                            </MultiBinding>
                        </Border.CornerRadius>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Social.DrawerRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Social.RowFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Card}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row and drawer text buttons: Button.Secondary.Small (ghost, 32 px) for the secondary choice, and the tonal
         Primary at the same size for the row's one primary. Sentence-case labels, Caption 12. Paired buttons sit 8 apart. -->
    <Style x:Key="Social.Action" TargetType="Button" BasedOn="{StaticResource Button.Secondary.Small}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Social.ActionPrimary" TargetType="Button" BasedOn="{StaticResource Button.Primary.Small}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- "Join" in a row and in a toast: the same tonal primary (the family accent is for switches, ticks, progress,
         selection and focus, not for button fills). -->
    <Style x:Key="Social.Join" TargetType="Button" BasedOn="{StaticResource Social.ActionPrimary}"/>

    <!-- Icon-only button (always has a tooltip and an automation name). Its glyph is Icon.Small:
         14 px + 9 px padding each side = Size.ControlMd (32). Min, not fixed, size: a bigger glyph makes
         the button bigger instead of being cut off by it. -->
    <Style x:Key="Social.Icon" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="MinWidth" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Padding" Value="9"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Hairline (chat day dividers, under the chat header). -->
    <Style x:Key="Social.Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Brush.SoftStroke}"/>
    </Style>

    <!-- A one-line status strip (notice, reconnecting). -->
    <Style x:Key="Social.Strip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="16,0,16,10"/>
    </Style>

    <!-- A section's heading row. -->
    <Style x:Key="Social.SectionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Social.RowFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Radius.Md}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Import drawer (UI/Controls/ImportPanel) =================
         A sibling of the Friends drawer: it reuses every style above and only adds what
         Friends has no use for. -->

    <!-- A problem line under a row: gold, wraps (Social.Caption trims to one line). -->
    <Style x:Key="Import.Warning" TargetType="TextBlock" BasedOn="{StaticResource Social.Caption}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- "What to bring": one kind of thing (Mods 12, Worlds 4) as a small switch block. Off = the card surface,
         on = a soft accent wash, an accent edge and a tick (Social.Check's language), mixed = the accent border with a dash (some
         versions bring it, some don't). Built only from the tokens above; 28 px tall, wraps in its card. -->
    <Style x:Key="Import.Chip" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- A capsule chip (radius = height / 2, ui:Capsule), like every chip. -->
                    <Border x:Name="Bd" Background="{StaticResource Brush.CardAlt}" BorderBrush="{StaticResource Brush.SoftStroke}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Full}" ui:Capsule.On="True"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Base}"
                                  Width="10" Height="10" StrokeThickness="2.6" Margin="0,0,6,0"
                                  Stroke="{StaticResource Brush.Accent}" Visibility="Collapsed" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                            <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Minus}"/>
                            <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource Brush.Text}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tick box:a square block, emerald when ticked (the toggle's square-handle language).
         The whole 32 px square is the hit area; the box inside is Size.Checkbox (16). -->
    <Style x:Key="Social.Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Height" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Margin" Value="6,-4,-6,-4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent">
                        <Border x:Name="Box" Width="{StaticResource Size.Checkbox}" Height="{StaticResource Size.Checkbox}" CornerRadius="{StaticResource Radius.Xs}"
                                Background="{StaticResource Brush.CardAlt}"
                                BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Base}"
                                  Width="12" Height="12" StrokeThickness="2.2"
                                  Stroke="{StaticResource Brush.TextOnAccent}" Visibility="Collapsed"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Mixed (Import from all versions, with some ticked): the same filled block with a dash. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Tick" Property="Data" Value="{StaticResource Icon.Minus}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drawer's one big action (Import all, Import): the filled button at the drawer's
         widest, Size.Control tall, never stretched past its row. -->
    <Style x:Key="Import.Primary" TargetType="Button" BasedOn="{StaticResource Button.Primary.Medium}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Footer buttons: Small (32), centred in the footer, never stretched, 8 apart. -->
    <Style x:Key="Import.FooterAction" TargetType="Button" BasedOn="{StaticResource Social.Action}"/>

    <!-- Disabled, the primary drops its emerald for the secondary's surface: a faded emerald still read brighter than
         the enabled DETAILS beside it (the unsupported single review, shot 39b), so "off" now looks off. -->
    <Style x:Key="Import.FooterPrimary" TargetType="Button" BasedOn="{StaticResource Social.ActionPrimary}">
        <Style.Triggers>
            <!-- A template swap, not a Background setter: the hover storyboard's held colour would win over a setter. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.SoftStroke}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
