<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls">

    <!-- Friends / party / chat (the drawer and its toasts). Built only from the
         tokens in Colors / Typography / Spacing / Buttons: change those and the
         whole social surface follows. The values that are only about this
         surface's rhythm live here. -->

    <system:Double x:Key="Social.AvatarSize">32</system:Double>
    <system:Double x:Key="Social.IconSize">28</system:Double>

    <!-- Small print (section labels, times, day dividers, the character counter, hints) uses
         Brush.TextMuted, which is 4.7:1 or better on Card, PanelElevated and the chat well. -->

    <!-- One card group of list rows, drawn row by row so the list can stay virtualized:
         the first row has the top corners, the last the bottom ones, and each row's top
         line is the 1 px divider. Corner size comes from Radius.Card. -->
    <controls:CardCornersConverter x:Key="Social.CardCorners"/>
    <controls:CardEdgesConverter x:Key="Social.CardEdges"/>

    <Style x:Key="Social.CardChrome" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="BorderThickness" Value="{Binding Pos, Converter={StaticResource Social.CardEdges}}"/>
        <Setter Property="CornerRadius">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource Social.CardCorners}">
                    <Binding Path="Pos"/>
                    <Binding Source="{StaticResource Radius.Card}"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- A row that is not itself pressable (requests, invites, hints, blocked). -->
    <Style x:Key="Social.RowStatic" TargetType="Border" BasedOn="{StaticResource Social.CardChrome}"/>

    <!-- One person: first letter on a raised block (no skin fetch: the launcher
         talks to no third-party image service). -->
    <Style x:Key="Social.Avatar" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Social.AvatarSize}"/>
        <Setter Property="Height" Value="{StaticResource Social.AvatarSize}"/>
        <Setter Property="Background" Value="{StaticResource Brush.CardAlt}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Swatch}"/>
    </Style>

    <Style x:Key="Social.Initial" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <!-- The presence dot sits on the avatar's corner; its ring is the card colour. -->
    <Style x:Key="Social.Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,-3,-3"/>
        <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.Card}"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>

    <Style x:Key="Social.Name" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="Social.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Eyebrow}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Small print (times, counters, day dividers). -->
    <Style x:Key="Social.Quiet" TargetType="TextBlock" BasedOn="{StaticResource Social.Caption}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    </Style>

    <Style x:Key="Social.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Placeholder text over an empty TextBox (Input.TextBox has none). -->
    <Style x:Key="Social.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="Margin" Value="13,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- A list row you can press (the whole row opens the conversation): the card
         row with a lighter fill on hover, the accent frame on keyboard focus.
         Inner buttons keep their own clicks. -->
    <!-- The keyboard focus frame: an outset 2 px frame around the row, corners following the row's
         place in its card (first, middle, last) at the card radius plus the outset (Radius.FocusCard).
         The frame is an adorner, so the next row can't cover it; it reads the row's Pos through the
         adorner's AdornedElement. A button that isn't a card row gets the full rounded frame. -->
    <Style x:Key="Social.RowFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2"
                            IsHitTestVisible="False">
                        <Border.CornerRadius>
                            <MultiBinding Converter="{StaticResource Social.CardCorners}">
                                <Binding Path="AdornedElement.DataContext.Pos"
                                         RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Adorner}}"/>
                                <Binding Source="{StaticResource Radius.FocusCard}"/>
                            </MultiBinding>
                        </Border.CornerRadius>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Social.Row" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Social.RowFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Style="{StaticResource Social.CardChrome}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Panel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small text buttons: ghost for secondary, filled for the row's one primary. -->
    <Style x:Key="Social.Action" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Eyebrow}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Social.ActionPrimary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Eyebrow}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- The destructive confirm (Remove, Block, Kick): redstone, not the emerald primary. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DangerStrong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DangerStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only button (always has a tooltip and an automation name). Its glyph is Icon.Small:
         14 px + 7 px padding each side = Social.IconSize. Min, not fixed, size: a bigger glyph makes
         the button bigger instead of being cut off by it. -->
    <Style x:Key="Social.Icon" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="MinWidth" Value="{StaticResource Social.IconSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource Social.IconSize}"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Hairline (chat day dividers, under the chat header). -->
    <Style x:Key="Social.Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Brush.SoftStroke}"/>
    </Style>

    <!-- A one-line status strip (notice, reconnecting). -->
    <Style x:Key="Social.Strip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Row}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="16,0,16,10"/>
    </Style>

    <!-- A section's heading row. -->
    <Style x:Key="Social.SectionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Social.RowFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Import drawer (UI/Controls/ImportPanel) =================
         A sibling of the Friends drawer: it reuses every style above and only adds what
         Friends has no use for. -->

    <!-- A problem line under a row: gold, wraps (Social.Caption trims to one line). -->
    <Style x:Key="Import.Warning" TargetType="TextBlock" BasedOn="{StaticResource Social.Caption}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- A tick box: a square block, emerald when ticked (the toggle's square-handle language).
         The whole 32 px square is the hit area; the box inside is 18 px. -->
    <Style x:Key="Social.Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="6,-4,-6,-4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="{StaticResource Radius.Control}"
                                Background="{StaticResource Brush.CardAlt}"
                                BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Base}"
                                  Width="12" Height="12" StrokeThickness="2.2"
                                  Stroke="{StaticResource Brush.TextOnAccent}" Visibility="Collapsed"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drawer's one big action (Import all, Import): the filled button at the drawer's
         widest, 40 px tall, never stretched past its row. -->
    <Style x:Key="Import.Primary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Footer buttons: 32 px, centred in the footer, never stretched. -->
    <Style x:Key="Import.FooterAction" TargetType="Button" BasedOn="{StaticResource Social.Action}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Import.FooterPrimary" TargetType="Button" BasedOn="{StaticResource Social.ActionPrimary}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
