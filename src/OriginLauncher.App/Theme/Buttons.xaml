<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:OriginLauncher.App.UI">

    <!--
        Workbench buttons (docs/overhaul/DESIGN-SYSTEM.md sections 5, 8 and 11.1). Every colour, size and radius is a
        token from Colors / Spacing / Typography; nothing is written here.

        One template, four fills (Primary, Secondary, Ghost = Chrome, Danger) and the size steps of section 5:
        sm 28 / md 32 / lg 36 / xl 40 tall, label 13.5 / 600. A style picks its step with MinHeight and its corner
        with ui:Chrome.Corner (Radius.Sm on 28-32, Radius.Md on 36-40). The height is a MINIMUM so a larger label or
        glyph grows the button instead of being cut; icon-only buttons size from their glyph
        (OriginLauncher.Tests/IconButtonTests). A filled button's border is its own fill in every state, never
        Transparent, because WPF paints a Border's Background inside the border line.

        States (spec 8): hover and press change the fill, a press scales the button to .97 (UI/Press.cs, always
        eases back to 1.0), disabled takes no hover and drops to 45 %, and the keyboard focus ring is a 2 px
        accent-line frame 2 px off the edge (Focus.Button*), shown by the FocusVisualStyle for keyboard focus only.

        Background and BorderBrush are LOCAL SolidColorBrush setters on every style, because the storyboards animate
        their Colors and a shared (frozen) brush would throw. The press trigger is a MultiTrigger (over + pressed)
        declared before the hover one, so that on release the exit action returns to the hover fill.
    -->

    <!-- Keyboard focus: a 2 px frame in the accent line, 2 px outside the control. Ring corner = control corner + 2. -->
    <Style x:Key="Focus.Button" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="{StaticResource Radius.Ring.Md}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same frame for the 28 and 32 tall controls (Radius.Sm corners). -->
    <Style x:Key="Focus.Button.Sm" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="{StaticResource Radius.Ring.Sm}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same frame around a pill (the switch track): a fully rounded ring. -->
    <Style x:Key="Focus.Pill" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="{StaticResource Radius.Full}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same frame for controls with card corners (the home banner, version and profile cards). -->
    <Style x:Key="Focus.Card" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="{StaticResource Radius.Ring.Lg}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card-corner focus in parchment: for a tile that sits where the selected (emerald) ring sits, so keyboard focus
         never reads as selected. Same frame and offset as Focus.Card. -->
    <Style x:Key="Focus.Card.Neutral" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="{StaticResource Radius.Ring.Lg}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Text}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Template.Button" TargetType="Button">
        <Border x:Name="Bg"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{Binding Path=(ui:Chrome.Corner), RelativeSource={RelativeSource TemplatedParent}}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Md}"/>
        <Setter Property="ui:Press.Scale" Value="0.97"/>
        <Setter Property="Template" Value="{StaticResource Template.Button}"/>
        <Style.Triggers>
            <!-- Press-scale: UI/Press.cs (never a storyboard on RenderTransform.ScaleX, see there).
                 Derived styles change only ui:Press.Scale. -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="ui:Press.Down" Value="True"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary: raised fill, strong edge (most actions). lg 36. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.Card}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.Stroke}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.SurfacePress}" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.CardAlt}" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.CardAlt}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.StrokeHover}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.Card}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.Stroke}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary at md (32): Profiles Import/Cancel, a row's Change, the drawers' footers. -->
    <Style x:Key="Button.Secondary.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button.Sm}"/>
    </Style>

    <!-- Ghost / icon: no fill or edge at rest, a soft wash on hover. Title-bar and toolbar icon buttons. md 32. The
         rest colour is the hover colour at alpha 0 so the fade only animates alpha. -->
    <Style x:Key="Button.Chrome" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.GhostRest}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button.Sm}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostHover}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostRest}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary: the one emerald fill per decision area. lg 36 (dialogs); Play is the primary at xl. Flat: no sheen,
         no gradient edge, no shadow. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.Accent}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.Accent}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.AccentPress}" Duration="{StaticResource Motion.Press}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.AccentPress}" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.AccentHover}" Duration="{StaticResource Motion.Release}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.AccentHover}" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.AccentHover}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.AccentHover}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.Accent}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.Accent}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Top-bar page tab: the label dim at rest (type.label 11, TextDim), full text when current, with a 2 px underline in the accent that
         grows from the centre (scaleX) under the current page. md 32. -->
    <Style x:Key="Button.NavItem" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button.Sm}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Indicator" Height="2" Margin="12,0,12,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource Brush.Accent}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="{StaticResource Motion.Scene}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0" Duration="{StaticResource Motion.Exit}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Play: the content (the PLAY word) sits left of a ring in the accent. Hover fills the ring with the accent
        from the centre (scale 0 to 1, expo ease) and the arrow turns onAccent; the arrow itself never moves. Press
        scales the whole control to .97 (ui:Press) and the ring to .94. Only scale, opacity and colour animate.
        The arrow brush is local because the storyboard animates its Color.
    -->
    <Style x:Key="Button.PlayHero" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.OnPhoto}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="ui:Press.Scale" Value="0.97"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- No pool of its own: the bottom scrim (ArtStage) already holds PLAY at 7:1. -->
                        <ContentPresenter x:Name="Word" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Grid Grid.Column="1" x:Name="Ring" Width="56" Height="56" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="RingFill" Fill="{StaticResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="FillScale" ScaleX="0" ScaleY="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RingStroke" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"/>
                            <Path x:Name="Arrow" Data="M5,12 H19 M13,6 L19,12 L13,18" Width="24" Height="24" Stretch="None"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Stroke>
                                    <SolidColorBrush Color="{StaticResource Color.Text}"/>
                                </Path.Stroke>
                            </Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Settle}">
                                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Settle}">
                                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Path.Stroke).(SolidColorBrush.Color)" To="{StaticResource Color.TextOnAccent}" Duration="{StaticResource Motion.Scene}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="{StaticResource Motion.Scene}"/>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="{StaticResource Motion.Scene}"/>
                                        <ColorAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Path.Stroke).(SolidColorBrush.Color)" To="{StaticResource Color.Text}" Duration="{StaticResource Motion.Hover}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="{StaticResource Motion.Press}"/>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="{StaticResource Motion.Press}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Running / launching: the ring steps back so the label carries the state. -->
                        <Trigger Property="Tag" Value="busy">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <!-- Can't play yet (signed out, no version, an import running): a quiet, neutral PLAY. The
                             accent is for things you can act on, so the ring goes grey. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Word" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="RingStroke" Property="Stroke" Value="{StaticResource Brush.Stroke}"/>
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="ui:Press.Down" Value="True"/>
            </Trigger>
            <!-- The disabled look is in the template (word dimmed, ring neutral): dimming the whole control left a
                 muddy half-accent ring. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary on the size steps: Medium is lg 36 (the usual button), Small is md 32 (row and header actions). -->
    <Style x:Key="Button.Primary.Medium" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>
    <Style x:Key="Button.Primary.Small" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button.Sm}"/>
    </Style>

    <!-- Icon-only primary (chat send): a lg-sized square that grows with its glyph (Min*, never fixed). -->
    <Style x:Key="Button.Primary.Icon" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinWidth" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Home strip pill (version / profile / Join): Secondary at xl 40, content stretched so a pill can hold an
         emblem, a name and a chevron. -->
    <Style x:Key="Button.Pill" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="16,0,12,0"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlXl}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Danger: a soft red fill with red text, never a filled red primary (Remove, Block, Kick, Uninstall). lg 36. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.DangerSoft}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.DangerSoft}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.DangerSoftHover}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.DangerSoftHover}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.DangerSoft}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.DangerSoft}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The same destructive confirm at md 32, beside Button.Secondary.Small (inline "Delete? / Cancel"). -->
    <Style x:Key="Button.Danger.Small" TargetType="Button" BasedOn="{StaticResource Button.Danger}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button.Sm}"/>
    </Style>

    <!-- sm 28 (spec 5, "inline actions"): the button that lives INSIDE a row or card (Use profile, Replace, Keep old,
         Remove / Delete confirms), 12 / 600 label, Radius.Sm. A toolbar action is the md 32 ".Small" above. -->
    <Style x:Key="Button.Secondary.Inline" TargetType="Button" BasedOn="{StaticResource Button.Secondary.Small}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
    </Style>
    <Style x:Key="Button.Primary.Inline" TargetType="Button" BasedOn="{StaticResource Button.Primary.Small}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
    </Style>
    <Style x:Key="Button.Danger.Inline" TargetType="Button" BasedOn="{StaticResource Button.Danger.Small}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
    </Style>

    <!-- Ghost at lg 36 (spec 11.1): "Cancel" beside a dialog's primary, no fill or edge, label TextDim. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Md}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
    </Style>

</ResourceDictionary>
