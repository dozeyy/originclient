<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Keyboard focus: a 2 px frame in the tonal primary, 3 px outside the control. -->
    <Style x:Key="Focus.Button" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{StaticResource Radius.Focus}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Acc}" Opacity="0.9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same frame for controls with Card-radius corners (the home banner). -->
    <Style x:Key="Focus.Card" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{StaticResource Radius.FocusCard}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Acc}" Opacity="0.9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        r2 buttons (Poster): a raised surface lit from the top (a 1 px light top
        edge, a faint top-to-bottom sheen) sitting on a 1 px dark contact line
        instead of a blurred shadow, so nothing re-rasterises while it moves.
        Press scales to 0.985 in 80 ms and always eases back to 1.0.

        Background stays a SolidColorBrush on every style here: derived styles
        (Button.Row, Social.Action, the banner surface) re-template and animate
        Background.Color, which a gradient brush would throw on.
    -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.985" Duration="{StaticResource Motion.Press}">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.985" Duration="{StaticResource Motion.Press}">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.0" Duration="{StaticResource Motion.Release}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.0" Duration="{StaticResource Motion.Release}">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary (r2 raised): #2C2C2C body under a lit sheen, 1 px light top edge,
         1 px dark contact line. Hover lifts the body one step. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.RaisedBody}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="0,0,0,-1" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Contact}"/>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"/>
                        <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Fill.Sheen}"/>
                        <Border CornerRadius="{StaticResource Radius.Control}" BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource Edge.Raised}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.RaisedHover}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.RaisedBody}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Row button: a whole list row that is also a button (the import panel's
         instance list). Secondary's states with the content stretched and
         left-aligned and the sharper row corners. -->
    <Style x:Key="Button.Row" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="0,0,0,-1" CornerRadius="{StaticResource Radius.Row}" Background="{StaticResource Brush.Contact}"/>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Row}"/>
                        <Border CornerRadius="{StaticResource Radius.Row}" BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource Edge.Raised}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar / icon buttons: no surface at rest, a soft one on hover. The rest
         colour is the hover colour at alpha 0 so the fade only animates alpha. -->
    <Style x:Key="Button.Chrome" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.GhostRest}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.SoftStroke}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostRest}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary (r2): the light tonal surface, a white top edge, a dark bottom edge
         and one static drop shadow (never animated: WPF blur re-rasterises). -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="24,14"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Raised}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"/>
                        <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Fill.PrimarySheen}"/>
                        <Border CornerRadius="{StaticResource Radius.Control}" BorderThickness="0,1,0,1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource Color.EdgePrimary}" Offset="0"/>
                                    <GradientStop Color="{StaticResource Color.EdgePrimary}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource Color.EdgePrimaryBottom}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource Color.EdgePrimaryBottom}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.AccentHover}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.Accent}"
                                            Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.985" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.985" Duration="{StaticResource Motion.Press}"/>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.AccentPress}" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.Accent}" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Top-bar page tab: tracked caps label, muted at rest, full text when
         current, with a 2 px underline in the version's accent that grows from
         the centre (scaleX) under the current page. -->
    <Style x:Key="Button.NavItem" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Indicator" Height="2" Margin="14,0,14,2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.Acc}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="{StaticResource Motion.Scene}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0" Duration="{StaticResource Motion.Exit}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Play (option 6): no slab. The content (the big tracked PLAY) sits left of a
        58 px ring drawn in the version's accent. Hover fills the ring with the
        accent from the centre (scale 0 to 1, expo ease), the arrow turns dark and
        nudges 4 px right; press scales the whole control to 0.97 and the ring to
        0.94. Only scale, translate, opacity and colour animate.
    -->
    <Style x:Key="Button.PlayHero" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.OnPhoto}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- No pool of its own: the bottom scrim (ArtStage) already holds PLAY at 7:1. -->
                        <ContentPresenter x:Name="Word" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Grid Grid.Column="1" x:Name="Ring" Width="58" Height="58" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="RingFill" Fill="{DynamicResource Brush.Acc}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="FillScale" ScaleX="0" ScaleY="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RingStroke" Stroke="{DynamicResource Brush.Acc}" StrokeThickness="2"/>
                            <Path x:Name="Arrow" Data="M5,12 H19 M13,6 L19,12 L13,18" Width="24" Height="24" Stretch="None"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFE6E6E6">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="ArrowShift" X="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Settle}">
                                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Settle}">
                                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Path.Stroke).(SolidColorBrush.Color)" To="#FF0E0E0E" Duration="{StaticResource Motion.Scene}"/>
                                        <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X" To="4" Duration="{StaticResource Motion.Settle}">
                                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="{StaticResource Motion.Scene}"/>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="{StaticResource Motion.Scene}"/>
                                        <ColorAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Path.Stroke).(SolidColorBrush.Color)" To="#FFE6E6E6" Duration="{StaticResource Motion.Hover}"/>
                                        <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource Motion.Scene}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="{StaticResource Motion.Press}"/>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="{StaticResource Motion.Press}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Running / launching: the ring steps back so the label carries the state. -->
                        <Trigger Property="Tag" Value="busy">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <!-- Can't play yet (signed out, no version, an import running): a quiet, neutral
                             PLAY. The accent is for things you can act on, so the ring goes grey. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Word" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="RingStroke" Property="Stroke" Value="{StaticResource Brush.Stroke}"/>
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="{StaticResource Motion.Press}"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Motion.Release}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Motion.Release}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- The disabled look is in the template (word dimmed, ring neutral): dimming the whole
                 control left a muddy half-accent ring. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Home pill (version / profile): a taller r2 raised surface whose content
         stretches; the same hover step as Secondary. -->
    <Style x:Key="Button.Pill" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="16,0,14,0"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

</ResourceDictionary>
