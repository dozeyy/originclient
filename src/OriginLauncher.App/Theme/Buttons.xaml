<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:OriginLauncher.App.UI">

    <!-- Keyboard focus: a 2 px frame in the tonal primary, 3 px outside the control. -->
    <Style x:Key="Focus.Button" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{StaticResource Radius.Focus}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Acc}" Opacity="0.9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same frame for controls with Card-radius corners (the home banner). -->
    <Style x:Key="Focus.Card" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{StaticResource Radius.FocusCard}" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Acc}" Opacity="0.9"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Buttons (Poster): Primary is the lit tonal slab, Secondary a dark ghost outline,
        Chrome nothing until hovered. Press scales to 0.985 in 80 ms and always eases back to 1.0.

        Background stays a SolidColorBrush on every style here: derived styles
        (Social.Action, the banner surface) re-template and animate
        Background.Color, which a gradient brush would throw on.
    -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Press-scale: UI/Press.cs (never a storyboard on RenderTransform.ScaleX, see there).
                 Derived styles change only ui:Press.Scale. -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="ui:Press.Down" Value="True"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary (Will, 2026-10-20: "all the buttons this style look bad"): a ghost button, a dark
         veil with a 1 px outline in the tonal primary and no raised surface, so it reads on the art
         and on the page alike. Hover washes the fill and brightens the edge, press washes less
         (and scales, UI/Press.cs). One border, nothing else to paint. Both brushes are LOCAL
         (never Brush.Acc, which FamilyTheme tweens) because the storyboards animate their Colors.
         Heights are the Size.Control* scale: this one is 40, .Small 32, Pill 48. The press trigger
         is declared before the hover one so that when the pointer leaves mid-press both exits fire
         and the hover exit (back to rest) is the one that wins. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.GhostFill}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.GhostEdge}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostFillPress}"
                                            Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostFillHover}"
                                            Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostFillHover}"
                                            Duration="{StaticResource Motion.Hover}">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.GhostEdgeHover}"
                                            Duration="{StaticResource Motion.Hover}">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostFill}"
                                            Duration="{StaticResource Motion.Hover}">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.GhostEdge}"
                                            Duration="{StaticResource Motion.Hover}">
                                <ColorAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut"/>
                                </ColorAnimation.EasingFunction>
                            </ColorAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary at header-action size (Profiles Import/Cancel, a row's Change, the drawers'
         footers): 32 px. -->
    <Style x:Key="Button.Secondary.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- Title-bar / icon buttons: no surface at rest, a soft one on hover. The rest
         colour is the hover colour at alpha 0 so the fade only animates alpha. -->
    <Style x:Key="Button.Chrome" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.GhostRest}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ui:Press.Scale" Value="0.95"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.SoftStroke}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.GhostRest}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary (r2): the light tonal surface, a white top edge, a dark bottom edge
         and one static drop shadow (never animated: WPF blur re-rasterises). -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="24,14"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Raised}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"/>
                        <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Fill.PrimarySheen}"/>
                        <Border CornerRadius="{StaticResource Radius.Control}" BorderThickness="0,1,0,1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource Color.EdgePrimary}" Offset="0"/>
                                    <GradientStop Color="{StaticResource Color.EdgePrimary}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource Color.EdgePrimaryBottom}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource Color.EdgePrimaryBottom}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.AccentHover}"
                                            Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.Accent}"
                                            Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.AccentPress}" Duration="{StaticResource Motion.Press}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.Accent}" Duration="{StaticResource Motion.Release}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Top-bar page tab: tracked caps label, muted at rest, full text when
         current, with a 2 px underline in the version's accent that grows from
         the centre (scaleX) under the current page. -->
    <Style x:Key="Button.NavItem" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border x:Name="Indicator" Height="2" Margin="14,0,14,2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.Acc}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="{StaticResource Motion.Scene}">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0" Duration="{StaticResource Motion.Exit}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Play (option 6): no slab. The content (the big tracked PLAY) sits left of a
        58 px ring drawn in the version's accent. Hover fills the ring with the
        accent from the centre (scale 0 to 1, expo ease) and the arrow turns dark; the
        arrow itself never moves (Will, 2026-10-20). Press scales the whole control to
        0.97 (ui:Press) and the ring to 0.94. Only scale, opacity and colour animate.
    -->
    <Style x:Key="Button.PlayHero" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.OnPhoto}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="ui:Press.Scale" Value="0.97"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- No pool of its own: the bottom scrim (ArtStage) already holds PLAY at 7:1. -->
                        <ContentPresenter x:Name="Word" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Grid Grid.Column="1" x:Name="Ring" Width="58" Height="58" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="RingFill" Fill="{DynamicResource Brush.Acc}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="FillScale" ScaleX="0" ScaleY="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RingStroke" Stroke="{DynamicResource Brush.Acc}" StrokeThickness="2"/>
                            <Path x:Name="Arrow" Data="M5,12 H19 M13,6 L19,12 L13,18" Width="24" Height="24" Stretch="None"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFE6E6E6"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Settle}">
                                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Settle}">
                                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Path.Stroke).(SolidColorBrush.Color)" To="#FF0E0E0E" Duration="{StaticResource Motion.Scene}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="{StaticResource Motion.Scene}"/>
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="{StaticResource Motion.Scene}"/>
                                        <ColorAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Path.Stroke).(SolidColorBrush.Color)" To="#FFE6E6E6" Duration="{StaticResource Motion.Hover}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="{StaticResource Motion.Press}"/>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="{StaticResource Motion.Press}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Motion.Release}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- Running / launching: the ring steps back so the label carries the state. -->
                        <Trigger Property="Tag" Value="busy">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <!-- Can't play yet (signed out, no version, an import running): a quiet, neutral
                             PLAY. The accent is for things you can act on, so the ring goes grey. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Word" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="RingStroke" Property="Stroke" Value="{StaticResource Brush.Stroke}"/>
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="ui:Press.Down" Value="True"/>
            </Trigger>
            <!-- The disabled look is in the template (word dimmed, ring neutral): dimming the whole
                 control left a muddy half-accent ring. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary on the shared control scale: Medium is 40 (the usual button), Small 32 (row and header
         actions). No drop shadow at these sizes: they sit on a card or a drawer, not on the art. -->
    <Style x:Key="Button.Primary.Medium" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="Button.Primary.Small" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Icon-only primary (chat send): a Control-sized square that grows with its glyph (Min*, never fixed). -->
    <Style x:Key="Button.Primary.Icon" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinWidth" Value="{StaticResource Size.Control}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Home pill (version / profile / Join): Secondary at the Home strip's height (48), content
         stretched so a pill can hold an emblem, a name and a chevron. -->
    <Style x:Key="Button.Pill" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="16,0,12,0"/>
        <Setter Property="Height" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- The destructive confirm (Remove, Block, Kick, Uninstall): redstone, not the emerald primary. Lives here (not Social.xaml) so Origin Setup, which links Buttons.xaml, uses the same one. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DangerStrong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.DangerStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same destructive confirm at the small size, beside Button.Secondary.Small (inline "Delete? / Cancel"). -->
    <Style x:Key="Button.Danger.Small" TargetType="Button" BasedOn="{StaticResource Button.Danger}">
        <Setter Property="Height" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
    </Style>

</ResourceDictionary>
