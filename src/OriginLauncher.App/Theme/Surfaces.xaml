<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:OriginLauncher.App.UI.Controls"
                    xmlns:ui="clr-namespace:OriginLauncher.App.UI">

    <!-- The launcher's shared surfaces (Will, 2026-10-20: "it all feels a bit messy"). Pages, drawers
         and dialogs build from these instead of each carrying its own card recipe. Launcher only: the
         installer links Colors / Spacing / Buttons / Inputs / Brand / Icons, not this. Everything here is
         tokens from those files. -->

    <!-- A page's column (Mods, Profiles, Settings, Import): PageColumn fills the width up to 1000 and sits against
         the left edge under the logo, x = 32, and PageColumn itself owns the top inset (96, or 80 in a short window), so every page title starts at the same point
         whatever the window width. (A plain element with a MaxWidth is centred when stretched and shrunk to its
         content when left-aligned, which is what put the old titles at four different x positions.) -->
    <Style x:Key="Page.Column" TargetType="controls:PageColumn">
        <Setter Property="ColumnMaxWidth" Value="1000"/>
        <Setter Property="Margin" Value="32,0,32,32"/>
    </Style>

    <!-- Card: a panel with 16 px inside and 8 px below it; it lifts to Card on hover. The 1 px border is clear
         at rest; a selected card sets it to Brush.Accent (the one place the family accent frames a surface). -->
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Row: the same surface for a list line (a mod, an account): 12,10 inside and 4 px below. -->
    <Style x:Key="Surface.Row" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Dialog: the confirm box and the profile form. 24 inside (the dialog gutter), a 1 px soft edge, the card shadow,
         the dialog corner (Radius.Dialog, 16). -->
    <Style x:Key="Surface.Dialog" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Overlay}"/>
    </Style>

    <!-- Dialog on the Surface step (spec 11.10): the confirm box. Same shape and shadow as Surface.Dialog, but the
         Panel fill with the strong line, so it reads as a sheet over the scrim rather than a raised card. -->
    <Style x:Key="Surface.DialogSheet" TargetType="Border" BasedOn="{StaticResource Surface.Dialog}">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
    </Style>

    <!-- Capsule: every pill, chip and badge (Will, 2026-10-25). A true capsule, radius = height / 2 (ui:Capsule.On: a
         plain Radius.Full draws an oval in WPF on anything wider than tall), one shared padding token
         (Theme/Spacing.xaml), the text in a 16 line so the ink is equal on all four sides and the box is a fixed
         22 (Sm) or 24 tall. The text style (Surface.ChipText, or Text.Label with LineHeight.Caption) goes inside it. -->
    <Style x:Key="Surface.Capsule" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.CardAlt}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Full}"/>
        <Setter Property="ui:Capsule.On" Value="True"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Capsule}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Surface.Capsule.Sm" TargetType="Border" BasedOn="{StaticResource Surface.Capsule}">
        <Setter Property="Padding" Value="{StaticResource Padding.Capsule.Sm}"/>
    </Style>
    <!-- Chip: a small label on CardAlt (the Mods version tag), a Sm capsule. The text style goes inside it. -->
    <Style x:Key="Surface.Chip" TargetType="Border" BasedOn="{StaticResource Surface.Capsule.Sm}"/>
    <Style x:Key="Surface.ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>

    <!-- Soft-hue tile (DESIGN-SYSTEM 2.3, the Settings icon tiles): a small square with a 16 % hue wash
         (Brush.HueTile.*, set per use as Background) and the glyph in the full hue (Brush.Hue.*). The only place colour
         sits behind an icon. Lg 40 (a dialog header, an empty state, a list row) at the 40-control corner (Radius.Md);
         Sm 28 (inside a row) at Radius.Sm. The glyph goes in as a Path (Icon.Base, 18 in Lg, 14 in Sm). -->
    <Style x:Key="Surface.Tile" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.TileLg}"/>
        <Setter Property="Height" Value="{StaticResource Size.TileLg}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Background" Value="{StaticResource Brush.HueTile.Sky}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Surface.Tile.Sm" TargetType="Border" BasedOn="{StaticResource Surface.Tile}">
        <Setter Property="Width" Value="{StaticResource Size.TileSm}"/>
        <Setter Property="Height" Value="{StaticResource Size.TileSm}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
    </Style>
    <!-- A dialog's section eyebrow ("LIKELY CAUSE", "TECHNICAL DETAILS", "IMPORT"): type.label in textDim, caps authored. -->
    <Style x:Key="Dialog.Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <!-- Account pill (top bar, DESIGN-SYSTEM 11.5): a compact rounded rectangle, not a capsule. md 32 tall, Radius.Sm,
         white 4 % fill and a 1 px edge; hover is CardAlt with the hovered edge. Inside: a 4 px inset, a head of
         Size.PillHead (the pill minus 8) at Radius.Head.Sm (6 - 4), 8, the name, 6, the chevron, 10. Background and
         BorderBrush are local brushes so the hover can animate their colours (as Button.Chrome does). -->
    <Style x:Key="Button.AccountPill" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.PillRest}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Color.Stroke}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.AccountPill}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button.Sm}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.CardAlt}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.StrokeHover}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource Color.PillRest}" Duration="{StaticResource Motion.Hover}"/>
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource Color.Stroke}" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Signed out: the same bar control as the other ghost buttons ("Sign in" with the account icon), no pill. -->
    <Style x:Key="Button.AccountPill.SignedOut" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- The brand lockup in the top bar (logo + wordmark) is the Website link: a ghost control like the others, md 32
         at Radius.Sm; its hover arrow comes from Icon.LinkHint. -->
    <Style x:Key="Button.Brand" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="Padding" Value="{StaticResource Padding.Brand}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    </Style>

    <!-- A drawer's header (Accounts, Friends, Import): a 16 px gutter all round, the title in H1 and one
         Caption line under it, the close button (Social.Icon, 32) at the right. -->
    <Style x:Key="Drawer.Header" TargetType="Grid">
        <Setter Property="Margin" Value="16,16,16,10"/>
    </Style>
    <Style x:Key="Drawer.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}"/>
    <Style x:Key="Drawer.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

</ResourceDictionary>
