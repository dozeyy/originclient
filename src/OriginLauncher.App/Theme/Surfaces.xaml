<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces and chips, in the website's treatment (.vcard / .vcard li):
         flat translucent glass with a 1 px soft stroke, small translucent chips.
         Clickable cards (version picker) brighten their stroke on hover in their own
         templates; static containers do not.
         Radii come from Theme/Spacing.xaml. -->

    <!-- A static card: glass, soft stroke, no hover response (it is a container, not
         a control, so it must not read as clickable). Pages set Padding and Margin. -->
    <Style x:Key="Surface.Card" TargetType="ContentControl">
        <Setter Property="Padding" Value="{StaticResource Layout.CardPadding}"/>
        <Setter Property="Margin" Value="{StaticResource Layout.CardGap}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource Brush.PanelGlass}"
                                BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A floating panel (drawer, dialog, popover): the raised surface with a
         stroke, no hover response. -->
    <Style x:Key="Surface.Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PanelElevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}"/>
    </Style>

    <!-- A chip: the website's version pill. Content is a Text.Chip TextBlock. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Chip}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- The same chip carrying the accent (selected / current). -->
    <Style x:Key="Chip.Accent" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
    </Style>

    <!-- Hairline between rows inside a card. -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="Margin" Value="0,14"/>
    </Style>

</ResourceDictionary>
