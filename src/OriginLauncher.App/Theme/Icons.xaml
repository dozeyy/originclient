    <!-- External-link arrow after the label of a button that leaves the launcher (Website, Store). It lives in a
         zero-width Canvas, so it takes no layout space at all: fading it in on hover moves nothing and the gaps stay
         the same as between icon buttons. It overlays the button's right padding and takes the button's text colour. -->
    <Style x:Key="Icon.LinkHint" TargetType="Path" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.SizeLinkHint}"/>
        <Setter Property="Height" Value="{StaticResource Icon.SizeLinkHint}"/>
        <Setter Property="Data" Value="{StaticResource Icon.External}"/>
        <Setter Property="StrokeThickness" Value="{StaticResource Icon.StrokeLinkHint}"/>
        <Setter Property="Canvas.Left" Value="{StaticResource Icon.LinkHintOffset}"/>
        <Setter Property="Canvas.Top" Value="0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.8" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
