<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Origin Line (DESIGN-SYSTEM section 10): 24 px masters, round caps and joins, one 1.7 px stroke at every size. -->
    <!-- Glyph sizes. An icon button sizes ITSELF from its glyph plus its padding (MinWidth/MinHeight,
         never a fixed Width/Height smaller than that sum): a glyph bigger than its slot is cut off
         at the slot's edge, which is how the Friends drawer's "..." lost a dot (2026-10-18). -->
    <!-- icon.sm 14 (28 tall controls), icon.md 16 (32 and 36 tall), icon.lg 18 (40 tall). Icon.Size is the default md. -->
    <system:Double x:Key="Icon.SizeSmall">14</system:Double>
    <system:Double x:Key="Icon.Size">16</system:Double>
    <system:Double x:Key="Icon.SizeLarge">18</system:Double>
    <system:Double x:Key="Icon.Stroke">1.7</system:Double>
    <!-- The small "opens in your browser" arrow after a link's label in the top bar: 10 px, a 1.25 line, 3 px in from
         the label's end. It lives in a zero-width Canvas, so it takes no layout space whatever its size. -->
    <system:Double x:Key="Icon.SizeLinkHint">10</system:Double>
    <system:Double x:Key="Icon.StrokeLinkHint">1.25</system:Double>
    <system:Double x:Key="Icon.LinkHintOffset">3</system:Double>

    <Style x:Key="Icon.Base" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="{StaticResource Icon.Size}"/>
        <Setter Property="Height" Value="{StaticResource Icon.Size}"/>
        <Setter Property="StrokeThickness" Value="{StaticResource Icon.Stroke}"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <!-- The glyph inside a small icon button (a 14 px glyph, icon.sm). -->
    <Style x:Key="Icon.Small" TargetType="Path" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.SizeSmall}"/>
        <Setter Property="Height" Value="{StaticResource Icon.SizeSmall}"/>
    </Style>

