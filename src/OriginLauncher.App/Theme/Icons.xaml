<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Origin Icon System 05: approved 24 px masters, 1.55 px optical stroke. -->
    <Style x:Key="Icon.Base" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="StrokeThickness" Value="1.55"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <GeometryGroup x:Key="Icon.Mods">
        <RectangleGeometry Rect="3,3,7.5,7.5" RadiusX="2" RadiusY="2"/>
        <RectangleGeometry Rect="13.5,3,7.5,7.5" RadiusX="2" RadiusY="2"/>
        <RectangleGeometry Rect="3,13.5,7.5,7.5" RadiusX="2" RadiusY="2"/>
        <PathGeometry>
            <PathFigure StartPoint="17.25,13.5"><LineSegment Point="17.25,21"/></PathFigure>
            <PathFigure StartPoint="13.5,17.25"><LineSegment Point="21,17.25"/></PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Home">
        <PathFigure StartPoint="3.5,11.2"><LineSegment Point="12,4"/><LineSegment Point="20.5,11.2"/></PathFigure>
        <PathFigure StartPoint="5.8,10.2"><LineSegment Point="5.8,19.5"/><LineSegment Point="18.2,19.5"/><LineSegment Point="18.2,10.2"/></PathFigure>
        <PathFigure StartPoint="9.5,19.5"><LineSegment Point="9.5,13.8"/><LineSegment Point="14.5,13.8"/><LineSegment Point="14.5,19.5"/></PathFigure>
    </PathGeometry>

    <GeometryGroup x:Key="Icon.Settings">
        <PathGeometry>
            <PathFigure StartPoint="9.6,3.4" IsClosed="True">
                <LineSegment Point="10.2,2"/><LineSegment Point="13.8,2"/><LineSegment Point="14.4,3.4"/>
                <LineSegment Point="16,4.1"/><LineSegment Point="17.4,3.5"/><LineSegment Point="20,6.1"/>
                <LineSegment Point="19.4,7.5"/><LineSegment Point="20.1,9.1"/><LineSegment Point="21.5,9.7"/>
                <LineSegment Point="21.5,13.3"/><LineSegment Point="20.1,13.9"/><LineSegment Point="19.4,15.5"/>
                <LineSegment Point="20,16.9"/><LineSegment Point="17.4,19.5"/><LineSegment Point="16,18.9"/>
                <LineSegment Point="14.4,19.6"/><LineSegment Point="13.8,21"/><LineSegment Point="10.2,21"/>
                <LineSegment Point="9.6,19.6"/><LineSegment Point="8,18.9"/><LineSegment Point="6.6,19.5"/>
                <LineSegment Point="4,16.9"/><LineSegment Point="4.6,15.5"/><LineSegment Point="3.9,13.9"/>
                <LineSegment Point="2.5,13.3"/><LineSegment Point="2.5,9.7"/><LineSegment Point="3.9,9.1"/>
                <LineSegment Point="4.6,7.5"/><LineSegment Point="4,6.1"/><LineSegment Point="6.6,3.5"/>
                <LineSegment Point="8,4.1"/>
            </PathFigure>
        </PathGeometry>
        <EllipseGeometry Center="12,11.5" RadiusX="3.2" RadiusY="3.2"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Account">
        <EllipseGeometry Center="12,8" RadiusX="3.6" RadiusY="3.6"/>
        <PathGeometry>
            <PathFigure StartPoint="4.8,20">
                <BezierSegment Point1="5.35,15.8" Point2="8.05,13.6" Point3="12,13.6"/>
                <BezierSegment Point1="15.95,13.6" Point2="18.65,15.8" Point3="19.2,20"/>
            </PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Download">
        <PathFigure StartPoint="12,3.2"><LineSegment Point="12,14.3"/></PathFigure>
        <PathFigure StartPoint="7.8,10.3"><LineSegment Point="12,14.5"/><LineSegment Point="16.2,10.3"/></PathFigure>
        <PathFigure StartPoint="4,17.3"><LineSegment Point="4,19.7"/><LineSegment Point="20,19.7"/><LineSegment Point="20,17.3"/></PathFigure>
    </PathGeometry>

    <PathGeometry x:Key="Icon.Folder">
        <PathFigure StartPoint="3,6.5" IsClosed="True">
            <LineSegment Point="9.5,6.5"/><LineSegment Point="11.7,8.8"/><LineSegment Point="21,8.8"/>
            <LineSegment Point="21,19.5"/><LineSegment Point="3,19.5"/>
        </PathFigure>
        <PathFigure StartPoint="3,9"><LineSegment Point="21,9"/></PathFigure>
    </PathGeometry>

    <PathGeometry x:Key="Icon.Trash">
        <PathFigure StartPoint="4,6.5"><LineSegment Point="20,6.5"/></PathFigure>
        <PathFigure StartPoint="9,6.5"><LineSegment Point="9,4"/><LineSegment Point="15,4"/><LineSegment Point="15,6.5"/></PathFigure>
        <PathFigure StartPoint="6.2,6.5"><LineSegment Point="7.1,19.5"/><LineSegment Point="16.9,19.5"/><LineSegment Point="17.8,6.5"/></PathFigure>
        <PathFigure StartPoint="10,10"><LineSegment Point="10,16"/></PathFigure>
        <PathFigure StartPoint="14,10"><LineSegment Point="14,16"/></PathFigure>
    </PathGeometry>

    <PathGeometry x:Key="Icon.Back">
        <PathFigure StartPoint="10,5"><LineSegment Point="3,12"/><LineSegment Point="10,19"/></PathFigure>
        <PathFigure StartPoint="3.5,12"><LineSegment Point="21,12"/></PathFigure>
    </PathGeometry>

    <PathGeometry x:Key="Icon.Minimize">
        <PathFigure StartPoint="5,17"><LineSegment Point="19,17"/></PathFigure>
    </PathGeometry>

    <PathGeometry x:Key="Icon.Close">
        <PathFigure StartPoint="5.5,5.5"><LineSegment Point="18.5,18.5"/></PathFigure>
        <PathFigure StartPoint="18.5,5.5"><LineSegment Point="5.5,18.5"/></PathFigure>
    </PathGeometry>

    <PathGeometry x:Key="Icon.Loading">
        <PathFigure StartPoint="10,16"><LineSegment Point="5,16"/><LineSegment Point="5,21"/></PathFigure>
        <PathFigure StartPoint="14,8"><LineSegment Point="19,8"/><LineSegment Point="19,3"/></PathFigure>
        <PathFigure StartPoint="4.6,9"><ArcSegment Point="18.9,8" Size="8,8" SweepDirection="Clockwise"/></PathFigure>
        <PathFigure StartPoint="19.4,15"><ArcSegment Point="5.1,16" Size="8,8" SweepDirection="Clockwise"/></PathFigure>
    </PathGeometry>

</ResourceDictionary>
