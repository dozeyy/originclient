<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        Origin launcher type: the Workbench design system (docs/overhaul/DESIGN-SYSTEM.md section 3). Inter (OFL,
        bundled static TTFs 400-800, the same face as the in-game menus) is the only UI face; Segoe UI is the
        fail-soft fallback only. Technical text (crash details, paths) is Consolas. Sizes and line heights are the
        spec's type.* rows; the Text.* styles below are the only way text is sized, so a block is the same height
        on every machine (every style fixes its line height).

        Display sizes (the Heading and Display styles) are laid out in Ideal mode so big Inter stays smooth.
        Sentence case everywhere; the one UPPERCASE style is Text.Label, authored in caps (a TextBlock has no
        letter-spacing or case switch). The giant version numeral on Home is not a style: VersionNumeral draws it
        in Inter ExtraBold at its natural width (never squashed), sized and centred in the band between the top
        bar and the Home strip (NumeralBand).
    -->
    <FontFamily x:Key="Font.Primary">/OriginLauncher.App;component/Assets/Fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Courier New</FontFamily>

    <system:Double x:Key="FontSize.Label">11</system:Double>
    <system:Double x:Key="FontSize.Caption">12</system:Double>
    <system:Double x:Key="FontSize.Body">13.5</system:Double>
    <system:Double x:Key="FontSize.Title">16</system:Double>
    <system:Double x:Key="FontSize.Action">20</system:Double>
    <system:Double x:Key="FontSize.Heading">22</system:Double>
    <system:Double x:Key="FontSize.Display">32</system:Double>
    <system:Double x:Key="LineHeight.Label">14</system:Double>
    <system:Double x:Key="LineHeight.Caption">16</system:Double>
    <system:Double x:Key="LineHeight.Body">20</system:Double>
    <system:Double x:Key="LineHeight.Title">22</system:Double>
    <system:Double x:Key="LineHeight.Action">24</system:Double>
    <system:Double x:Key="LineHeight.Heading">28</system:Double>
    <system:Double x:Key="LineHeight.Display">36</system:Double>
    <!-- Home's status line: one fixed line slot while idle; an error wraps to two rows at the status width (its
         full text is in the tooltip) and the row takes both rows' height, so the card rises by one fixed step. -->
    <system:Double x:Key="Size.StatusLine">16</system:Double>
    <system:Double x:Key="Size.StatusLinesMax">32</system:Double>
    <system:Double x:Key="Size.StatusWidth">400</system:Double>

    <!-- type.label: nav tabs, eyebrows, badges and section labels. Author the text in caps. -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Label}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- type.caption: status lines, meta, helper text. -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="Text.CaptionDim" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <!-- type.body: default text and descriptions. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.BodyDim" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <!-- type.bodyStrong: button labels, names, row titles. -->
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- type.title: card titles, dialog titles. -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Title}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- type.action: the Play label only. -->
    <Style x:Key="Text.Action" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Action}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Action}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- type.heading: page and sheet titles. -->
    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Heading}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- type.display: an empty-state or hero headline. -->
    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Display}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- A form field's label, 8 px above its box. -->
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="{StaticResource Margin.Below.2}"/>
    </Style>

</ResourceDictionary>
