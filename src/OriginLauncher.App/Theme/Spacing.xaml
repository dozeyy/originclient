<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 8px spacing grid -->
    <system:Double x:Key="Space.1">4</system:Double>
    <system:Double x:Key="Space.2">8</system:Double>
    <system:Double x:Key="Space.3">16</system:Double>
    <system:Double x:Key="Space.4">24</system:Double>
    <system:Double x:Key="Space.5">32</system:Double>
    <system:Double x:Key="Space.6">48</system:Double>

    <!-- Page rhythm (website: 14 px card gap, 22 px card padding, a centred
         column). One content column width for Mods and Settings, one card
         padding, one gap between stacked cards. -->
    <system:Double x:Key="Layout.PageWidth">760</system:Double>
    <Thickness x:Key="Layout.PageMargin">28,20,36,24</Thickness>
    <Thickness x:Key="Layout.CardPadding">20</Thickness>
    <Thickness x:Key="Layout.CardGap">0,0,0,16</Thickness>

    <!-- Block-built corners: one-pixel controls and only a slight softening on
         large containers. Circular geometry is reserved for the Origin mark. -->
    <CornerRadius x:Key="Radius.Chip">1</CornerRadius>
    <CornerRadius x:Key="Radius.Control">1</CornerRadius>
    <CornerRadius x:Key="Radius.NavItem">1</CornerRadius>
    <CornerRadius x:Key="Radius.Row">2</CornerRadius>
    <CornerRadius x:Key="Radius.Card">2</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">3</CornerRadius>
    <CornerRadius x:Key="Radius.Swatch">1</CornerRadius>

    <!-- Motion timing -->
    <Duration x:Key="Motion.Base">0:0:0.048</Duration>
    <Duration x:Key="Motion.Press">0:0:0.042</Duration>
    <Duration x:Key="Motion.Release">0:0:0.064</Duration>
    <Duration x:Key="Motion.Scene">0:0:0.18</Duration>
    <Duration x:Key="Motion.Exit">0:0:0.12</Duration>
    <!-- The launcher's opening (Home's mark assembling at first launch), and how
         long the wordmark and Play card take to settle in under it. -->
    <Duration x:Key="Motion.Intro">0:0:0.56</Duration>
    <Duration x:Key="Motion.Settle">0:0:0.32</Duration>

    <!-- Hover/press halo around the primary button (website primary button hover
         ring): a 3 px outset frame, drawn by the button template, never a blur. -->
    <Thickness x:Key="Halo.Margin">-3</Thickness>

    <!-- Dialogs and toasts only. Cards are flat glass with a stroke, like the
         website; a hard, blur-free drop keeps floating surfaces readable. -->
    <DropShadowEffect x:Key="Shadow.Card"
                      Color="#FF000000"
                      Opacity="0.38"
                      BlurRadius="0"
                      ShadowDepth="3"
                      Direction="270"/>

</ResourceDictionary>
