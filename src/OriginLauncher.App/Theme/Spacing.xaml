<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 8px spacing grid -->
    <system:Double x:Key="Space.1">4</system:Double>
    <system:Double x:Key="Space.2">8</system:Double>
    <system:Double x:Key="Space.3">16</system:Double>
    <system:Double x:Key="Space.4">24</system:Double>
    <system:Double x:Key="Space.5">32</system:Double>
    <system:Double x:Key="Space.6">48</system:Double>

    <!-- Softly rounded corners (Will 2026-10-18: "round off some corners to feel a
         bit smoother", no pills): controls, buttons and inputs 4 px; small tag chips 4 px;
         rows and cards 6 px; dialogs and big panels 8 px. Circular geometry is reserved
         for the Origin mark. Derived radii follow from these so nothing is square inside a
         rounded frame: Focus = Control + the 3 px focus-frame outset (FocusCard likewise
         for a Card-radius control); Knob nests inside a switch track (4 - 1 px border -
         2 px margin); Bar is the 2 px progress bars. -->
    <CornerRadius x:Key="Radius.Chip">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.NavItem">4</CornerRadius>
    <CornerRadius x:Key="Radius.Row">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">8</CornerRadius>
    <CornerRadius x:Key="Radius.Swatch">4</CornerRadius>
    <CornerRadius x:Key="Radius.Focus">7</CornerRadius>
    <CornerRadius x:Key="Radius.FocusCard">9</CornerRadius>
    <CornerRadius x:Key="Radius.Bar">2</CornerRadius>
    <CornerRadius x:Key="Radius.Knob">2</CornerRadius>

    <!-- Motion timing -->
    <Duration x:Key="Motion.Base">0:0:0.048</Duration>
    <Duration x:Key="Motion.Press">0:0:0.042</Duration>
    <Duration x:Key="Motion.Release">0:0:0.064</Duration>
    <Duration x:Key="Motion.Scene">0:0:0.18</Duration>
    <Duration x:Key="Motion.Exit">0:0:0.12</Duration>
    <!-- The launcher's opening (Home's mark assembling at first launch), and how
         long the wordmark and Play card take to settle in under it. -->
    <Duration x:Key="Motion.Intro">0:0:0.56</Duration>
    <Duration x:Key="Motion.Settle">0:0:0.32</Duration>

    <!-- Hard-edged depth reads like a Minecraft button, without blur work. -->
    <DropShadowEffect x:Key="Shadow.Primary"
                      Color="#FF5FD09B"
                      Opacity="0.55"
                      BlurRadius="0"
                      ShadowDepth="3"
                      Direction="270"/>

    <DropShadowEffect x:Key="Shadow.Card"
                      Color="#FF000000"
                      Opacity="0.48"
                      BlurRadius="0"
                      ShadowDepth="4"
                      Direction="270"/>

</ResourceDictionary>
