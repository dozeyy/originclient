<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 8px spacing grid -->
    <system:Double x:Key="Space.1">4</system:Double>
    <system:Double x:Key="Space.2">8</system:Double>
    <system:Double x:Key="Space.3">16</system:Double>
    <system:Double x:Key="Space.4">24</system:Double>
    <system:Double x:Key="Space.5">32</system:Double>
    <system:Double x:Key="Space.6">48</system:Double>

    <!-- Corner radius tiers -->
    <CornerRadius x:Key="Radius.Chip">7</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.NavItem">11</CornerRadius>
    <CornerRadius x:Key="Radius.Row">12</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">18</CornerRadius>
    <CornerRadius x:Key="Radius.Swatch">12</CornerRadius>

    <!-- Motion timing -->
    <Duration x:Key="Motion.Base">0:0:0.16</Duration>
    <Duration x:Key="Motion.Press">0:0:0.08</Duration>
    <Duration x:Key="Motion.Release">0:0:0.20</Duration>
    <Duration x:Key="Motion.Scene">0:0:0.19</Duration>
    <Duration x:Key="Motion.Exit">0:0:0.11</Duration>

    <!-- Primary action resting shadow — the only element allowed one -->
    <DropShadowEffect x:Key="Shadow.Primary"
                      Color="#FF4BC8AE"
                      Opacity="0.28"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Direction="270"/>

    <DropShadowEffect x:Key="Shadow.Card"
                      Color="#FF000000"
                      Opacity="0.32"
                      BlurRadius="28"
                      ShadowDepth="10"
                      Direction="270"/>

</ResourceDictionary>
