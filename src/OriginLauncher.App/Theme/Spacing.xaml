<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        Origin launcher space, size, radius, motion and elevation tokens: the Workbench design system
        (docs/overhaul/DESIGN-SYSTEM.md sections 4 to 9, key map in 17.1). Same names and values as the installer's
        Theme/Tokens.xaml where the two overlap (tools/release/check_consistency.py compares them). No other file
        writes a spacing, size, radius or duration literal.
    -->

    <!-- ===== Space (spec 4): 4 px base, 8 px rhythm ===== -->
    <system:Double x:Key="Space.1">4</system:Double>
    <system:Double x:Key="Space.2">8</system:Double>
    <system:Double x:Key="Space.3">12</system:Double>
    <system:Double x:Key="Space.4">16</system:Double>
    <system:Double x:Key="Space.5">20</system:Double>
    <system:Double x:Key="Space.6">24</system:Double>
    <system:Double x:Key="Space.8">32</system:Double>
    <system:Double x:Key="Space.10">40</system:Double>
    <system:Double x:Key="Space.12">48</system:Double>

    <!-- Layout margins that more than one style needs, as tokens. -->
    <Thickness x:Key="Margin.Below.2">0,0,0,8</Thickness>
    <Thickness x:Key="Margin.DropZone">24,20</Thickness>

    <!-- ===== Control sizes (spec 5): one height per step, on every screen ===== -->
    <system:Double x:Key="Size.ControlSm">28</system:Double>
    <system:Double x:Key="Size.ControlMd">32</system:Double>
    <system:Double x:Key="Size.ControlLg">36</system:Double>
    <system:Double x:Key="Size.ControlXl">40</system:Double>
    <!-- The top bar holds 32 tall controls with 8 above and below. List rows are 64 tall. Drawers (Accounts,
         Friends, Import) are 380 wide. -->
    <system:Double x:Key="Size.Bar">48</system:Double>
    <system:Double x:Key="Size.Row">64</system:Double>
    <system:Double x:Key="Size.Drawer">380</system:Double>
    <system:Double x:Key="Size.Checkbox">16</system:Double>
    <system:Double x:Key="Size.Progress">3</system:Double>
    <system:Double x:Key="Size.Dot">6</system:Double>
    <system:Double x:Key="Size.Badge">20</system:Double>
    <!-- Slider (spec 11): 4 track, 16 round thumb, a 20 hit box. -->
    <system:Double x:Key="Size.SliderBox">20</system:Double>
    <system:Double x:Key="Size.SliderTrack">4</system:Double>
    <system:Double x:Key="Size.SliderThumb">16</system:Double>
    <!-- Switch (spec 5): 32 x 18, knob 14. -->
    <system:Double x:Key="Size.SwitchWidth">32</system:Double>
    <system:Double x:Key="Size.SwitchHeight">18</system:Double>
    <system:Double x:Key="Size.SwitchKnob">14</system:Double>
    <system:Double x:Key="Size.SwitchTravel">14</system:Double>
    <!-- Tiles (spec 2.3 / 10): the icon square that labels a list row or a card. 28 in a dense row, 40 on a card or in
         a dialog header. Hue only inside a tile, never as a box around a bare icon. -->
    <system:Double x:Key="Size.TileSm">28</system:Double>
    <system:Double x:Key="Size.TileLg">40</system:Double>
    <!-- A dialog's width (spec 11.10: max 440) and the swatch / emblem pickers inside the profile form. -->
    <system:Double x:Key="Size.Dialog">440</system:Double>
    <!-- Brand sizes (spec 1.3): the top bar mark 24 with a 16 tall wordmark. -->
    <system:Double x:Key="Size.Emblem">24</system:Double>
    <system:Double x:Key="Size.Logo.Bar">24</system:Double>
    <system:Double x:Key="Size.Wordmark.Bar">16</system:Double>
    <system:Double x:Key="Size.Logo.Hero">48</system:Double>
    <system:Double x:Key="Size.Logo.Intro">64</system:Double>
    <system:Double x:Key="Size.Wordmark.Hero">24</system:Double>

    <!-- ===== Corner radii (spec 6) ===== -->
    <CornerRadius x:Key="Radius.Xs">4</CornerRadius>
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Radius.Full">999</CornerRadius>
    <!-- Radius.Lg as a number, for a dashed Rectangle (RadiusX / RadiusY take a double, not a CornerRadius). -->
    <system:Double x:Key="Radius.Lg.Value">12</system:Double>
    <!-- Rails (progress 3, slider 4): half their height. A 999 radius on a thin wide bar draws a pointed lens in WPF. -->
    <CornerRadius x:Key="Radius.Track">2</CornerRadius>
    <!-- Focus ring corner = control corner + 2 (spec 8). -->
    <CornerRadius x:Key="Radius.Ring.Xs">6</CornerRadius>
    <CornerRadius x:Key="Radius.Ring.Sm">8</CornerRadius>
    <CornerRadius x:Key="Radius.Ring.Md">10</CornerRadius>
    <CornerRadius x:Key="Radius.Ring.Lg">14</CornerRadius>

    <!-- ===== Motion (spec 9). App.DisableMotion zeroes every one of these for reduced motion and the CI shot
         render; code paths use UI.Motion. ===== -->
    <Duration x:Key="Motion.Press">0:0:0.08</Duration>
    <Duration x:Key="Motion.Release">0:0:0.14</Duration>
    <Duration x:Key="Motion.Hover">0:0:0.12</Duration>
    <Duration x:Key="Motion.Base">0:0:0.16</Duration>
    <Duration x:Key="Motion.Enter">0:0:0.22</Duration>
    <Duration x:Key="Motion.Exit">0:0:0.14</Duration>
    <Duration x:Key="Motion.Scene">0:0:0.26</Duration>
    <Duration x:Key="Motion.Drawer">0:0:0.32</Duration>
    <Duration x:Key="Motion.Drag">0:0:0.18</Duration>
    <Duration x:Key="Motion.Intro">0:0:0.56</Duration>
    <Duration x:Key="Motion.Settle">0:0:0.32</Duration>

    <!-- Easings as KeySplines: Out is the spec's (.2,.8,.2,1). -->
    <KeySpline x:Key="Ease.Out" ControlPoint1="0.2,0.8" ControlPoint2="0.2,1"/>
    <KeySpline x:Key="Ease.In" ControlPoint1="0.55,0" ControlPoint2="0.75,0.2"/>
    <KeySpline x:Key="Ease.Expo" ControlPoint1="0.16,1" ControlPoint2="0.3,1"/>

    <!-- ===== Elevation (spec 7): the one shadow, for menus, dialogs, sheets and toasts. Put it on a static parent
         border, never on an animating element (effects re-rasterise in software). ===== -->
    <DropShadowEffect x:Key="Shadow.Overlay" Color="#FF000000" Opacity="0.40" BlurRadius="32" ShadowDepth="12" Direction="270"/>

</ResourceDictionary>
