<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:OriginLauncher.App.UI">

    <!-- Minimal themed scrollbar: thin thumb, no arrow buttons. Scoped into a
         ScrollViewer via ScrollViewer.Resources rather than applied app-wide,
         since most of the app hides scrollbars outright. -->
    <Style x:Key="ScrollBar.Minimal" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="ScrollBar.PageUpCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="ScrollBar.PageDownCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBg" Background="{StaticResource Brush.Stroke}"
                                                    ui:Capsule.On="True" Margin="2,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBg" Property="Background" Value="{StaticResource Brush.ProgressTrack}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field (spec 5): 36 tall, the sunken Field fill, a 1 px strong line, Radius.Md.
         hover     the line steps to StrokeHover
         focus     the line turns to the accent line (AccentBorder) over Motion.Base
         error     a Danger edge (ui:Chrome.Invalid="True"); the reason goes right under the box in Input.ErrorText
         disabled  45 %, no hover or focus change
         The edge is a LOCAL SolidColorBrush, because the storyboards animate its Color (a shared brush would be
         frozen and throw). -->
    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.ProgressTrack}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Field}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlLg}"/>
        <!-- Centered is right for the single-line boxes that make up most of the
             app; a multi-line box (Settings -> JVM arguments) sets
             VerticalContentAlignment="Top" and the template honours it. -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Md}"
                                SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource Color.Stroke}"/>
                            </Border.BorderBrush>
                            <!-- No Margin here: a TextBox applies its own Padding to the text. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Border x:Name="ErrorEdge" CornerRadius="{StaticResource Radius.Md}" BorderThickness="1"
                                BorderBrush="{StaticResource Brush.Danger}" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.StrokeHover}" Duration="{StaticResource Motion.HoverIn}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.Stroke}" Duration="{StaticResource Motion.Hover}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.AccentBorder}" Duration="{StaticResource Motion.Base}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.Stroke}" Duration="{StaticResource Motion.Base}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="ui:Chrome.Invalid" Value="True">
                            <Setter TargetName="ErrorEdge" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The reason a field is invalid: caption type in the danger text colour, 4 px under the box. Collapse it
         while the field is fine. -->
    <Style x:Key="Input.ErrorText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
    </Style>

    <!-- Slider: progress-track groove, the filled part in the accent, a round accent knob. -->
    <Style x:Key="Input.Slider" TargetType="Slider">
        <Setter Property="Height" Value="{StaticResource Size.SliderBox}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- Painted (Transparent) so the whole slider height takes the mouse, not just the 4 px groove. -->
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="{StaticResource Size.SliderTrack}" Background="{StaticResource Brush.ProgressTrack}" CornerRadius="{StaticResource Radius.Track}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="{StaticResource Size.SliderTrack}" Background="{DynamicResource Brush.Accent}" CornerRadius="{StaticResource Radius.Track}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <!-- The press-scale transform and its animations must BOTH live inside
                                     the Thumb's own ControlTemplate: a Storyboard resolves TargetName in
                                     the name scope of the template it was declared in. -->
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Knob" Width="{StaticResource Size.SliderThumb}" Height="{StaticResource Size.SliderThumb}"
                                                    Background="{StaticResource Brush.Accent}"
                                                    ui:Capsule.On="True"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="KnobScale" ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="{StaticResource Brush.AccentPress}"/>
                                                </Trigger>
                                                <EventTrigger RoutedEvent="Thumb.DragStarted">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.12" Duration="{StaticResource Motion.Press}"/>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.12" Duration="{StaticResource Motion.Press}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="Thumb.DragCompleted">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.0" Duration="{StaticResource Motion.Release}">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.0" Duration="{StaticResource Motion.Release}">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Select: the same ghost outline as Button.Secondary (a dark veil, a 1 px tonal edge that
         brightens on hover, a brighter edge while open). -->
    <Style x:Key="Input.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <!-- Right padding leaves room for the dropdown chevron. -->
        <Setter Property="Padding" Value="14,9,34,9"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Md}" BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource Color.Card}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource Color.Stroke}"/>
                                            </Border.BorderBrush>
                                        </Border>
                                        <Border x:Name="OpenEdge" CornerRadius="{StaticResource Radius.Md}" BorderThickness="1"
                                                Opacity="0">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource Color.StrokeHover}"/>
                                            </Border.BorderBrush>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.Color"
                                                                        To="{StaticResource Color.CardAlt}" Duration="{StaticResource Motion.HoverIn}"/>
                                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush.Color"
                                                                        To="{StaticResource Color.StrokeHover}" Duration="{StaticResource Motion.HoverIn}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.Color"
                                                                        To="{StaticResource Color.Card}" Duration="{StaticResource Motion.Hover}"/>
                                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush.Color"
                                                                        To="{StaticResource Color.Stroke}" Duration="{StaticResource Motion.Hover}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="OpenEdge" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <!-- The dropdown arrow: a chevron, so a combo box reads as one. -->
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon.Small}"
                              Margin="0,0,12,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Stroke="{StaticResource Brush.TextDim}" IsHitTestVisible="False"/>
                        <!-- Placeholder: the combo box's Tag, shown while nothing is picked. -->
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <!-- The list: a menu panel (Card, strong line, Radius.Md, Shadow.Overlay). A transparent window, so the
                             Grid is the bleed the shadow draws into (Popup.Bleed) and the Popup is shifted left by it;
                             the shadow sits on its own empty border so scrolling never re-rasterises it. -->
                        <Popup x:Name="Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               HorizontalOffset="{StaticResource Popup.OffsetX}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Grid Margin="{StaticResource Popup.Bleed}">
                                <Border Background="{StaticResource Brush.Card}" CornerRadius="{StaticResource Radius.Md}"
                                        Effect="{StaticResource Shadow.Overlay}" IsHitTestVisible="False"/>
                                <Border Background="{StaticResource Brush.Card}"
                                        BorderBrush="{StaticResource Brush.Stroke}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Md}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <!-- Margin top and bottom only, the side gutter as Padding, so the scrollbar track runs to the
                                         list's right edge (inside the rounded corner) instead of floating 4 px in. -->
                                    <ScrollViewer MaxHeight="240" Margin="0,4" Padding="4,0">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list row (spec 11.2): 32 tall (Size.ControlMd), Radius.Sm, pad X 10. Hover and the keyboard highlight are
         the white 6 % wash. The chosen row has no fill of its own: its label goes bodyStrong in full-strength text and
         a 14 px check in the accent sits on the right. Every row keeps the check's slot (Hidden, not Collapsed), so
         the menu's width and the labels never move when the selection changes. -->
    <Style x:Key="Input.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <!-- Transparent, never empty: WPF only hovers where something is painted, and a ComboBox lights a
                         row only when the mouse ENTERS it, so an unpainted row lit only once the pointer crossed its
                         text (Will, 2026-10-26: "hovering over different versions is not registering"). -->
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path x:Name="Check" Grid.Column="1" Data="{StaticResource Icon.Check}" Style="{StaticResource Icon.Small}"
                                  Stroke="{StaticResource Brush.Accent}" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.GhostHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch (spec 5): a 32 x 18 track with a 14 knob. The toggle's Content (a caps label) sits to the left of the
         track and the whole row is one hit target.
         Off  the progress-track fill, a 1 px stroke, the muted knob on the left.
         On   the track fills with the accent, the knob turns to text colour and slides right (Motion.Release).
         Hover brightens the stroke; press squashes the knob. Space and Enter toggle; focus draws the pill ring.
         No glow and no tick (Workbench: no glow; a tick does not fit in 14 px). Reusable: drop it in with its own
         label, or with no Content. -->
    <Style x:Key="Toggle.Slider" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="0,0,12,0"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Grid Grid.Column="1" Width="{StaticResource Size.SwitchWidth}" Height="{StaticResource Size.SwitchHeight}"
                              VerticalAlignment="Center">
                            <Border x:Name="Track" ui:Capsule.On="True" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Color.ProgressTrack}"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource Color.Stroke}"/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="TrackOn" ui:Capsule.On="True"
                                    Background="{StaticResource Brush.Accent}" Opacity="0"/>
                            <Border x:Name="Knob" Width="{StaticResource Size.SwitchKnob}" Height="{StaticResource Size.SwitchKnob}"
                                    ui:Capsule.On="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Color.SwitchKnobOff}"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.StrokeHover}" Duration="{StaticResource Motion.HoverIn}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.Stroke}" Duration="{StaticResource Motion.Hover}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.18" Duration="{StaticResource Motion.Press}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="0.86" Duration="{StaticResource Motion.Press}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.Text}" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="{StaticResource Size.SwitchTravel}" Duration="{StaticResource Motion.Release}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Release}"/>
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.SwitchKnobOff}" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="0" Duration="{StaticResource Motion.Release}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Home My mods switch (Will's approved Workbench Home mockup, .sw2): the Switch above at 36 x 20 with a 14 knob
         inset 3, the caps label 8 to its left in the muted text colour. Off: the progress-track fill, a 1 px stroke and
         the muted knob on the left. On: the emerald track with a DARK knob (Color.TextOnAccent) on the right. Same
         behaviour as Toggle.Slider: Motion.Release slide, hover brightens the stroke, press squashes the knob, Space and
         Enter toggle, the pill focus ring. -->
    <Style x:Key="Toggle.HomeSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="0,0,8,0"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Grid Grid.Column="1" Width="{StaticResource Size.HomeSwitchWidth}" Height="{StaticResource Size.HomeSwitchHeight}"
                              VerticalAlignment="Center">
                            <Border x:Name="Track" ui:Capsule.On="True" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Color.ProgressTrack}"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource Color.Stroke}"/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="TrackOn" ui:Capsule.On="True"
                                    Background="{StaticResource Brush.Accent}" Opacity="0"/>
                            <Border x:Name="Knob" Width="{StaticResource Size.HomeSwitchKnob}" Height="{StaticResource Size.HomeSwitchKnob}"
                                    ui:Capsule.On="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Color.SwitchKnobOff}"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.StrokeHover}" Duration="{StaticResource Motion.HoverIn}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.Stroke}" Duration="{StaticResource Motion.Hover}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.18" Duration="{StaticResource Motion.Press}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="0.86" Duration="{StaticResource Motion.Press}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.TextOnAccent}" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="{StaticResource Size.HomeSwitchTravel}" Duration="{StaticResource Motion.Release}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Release}"/>
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.SwitchKnobOff}" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="0" Duration="{StaticResource Motion.Release}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
