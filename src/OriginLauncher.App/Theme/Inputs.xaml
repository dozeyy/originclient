<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Minimal themed scrollbar: thin thumb, no arrow buttons. Scoped into a
         ScrollViewer via ScrollViewer.Resources rather than applied app-wide,
         since most of the app hides scrollbars outright. -->
    <Style x:Key="ScrollBar.Minimal" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="ScrollBar.PageUpCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="ScrollBar.PageDownCommand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBg" Background="{StaticResource Brush.Stroke}"
                                                    CornerRadius="{StaticResource Radius.Sharp}" Margin="2,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBg" Property="Background" Value="{StaticResource Brush.Track}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text field: an inset well (darker than the card it sits on) with a quiet
         edge that brightens to the tonal primary on focus. -->
    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Track}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Inset}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
        <Setter Property="MinHeight" Value="40"/>
        <!-- Centered is right for the single-line boxes that make up most of the
             app; a multi-line box (Settings -> JVM arguments) sets
             VerticalContentAlignment="Top" and the template honours it. -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Sharp}">
                        <!-- No Margin here: a TextBox applies its own Padding to the text. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.AccentBorder}"
                                                        Duration="{StaticResource Motion.Base}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.SoftStroke}"
                                                        Duration="{StaticResource Motion.Base}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: grey track, the filled part in the version's accent, a light square knob. -->
    <Style x:Key="Input.Slider" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" Background="{StaticResource Brush.Track}" CornerRadius="{StaticResource Radius.Bar}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{DynamicResource Brush.Acc}" CornerRadius="{StaticResource Radius.Bar}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                              Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <!-- The press-scale transform and its animations must BOTH live inside
                                     the Thumb's own ControlTemplate: a Storyboard resolves TargetName in
                                     the name scope of the template it was declared in. -->
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Knob" Width="16" Height="16"
                                                    Background="{StaticResource Brush.Accent}"
                                                    BorderBrush="#33000000"
                                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Knob}"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="KnobScale" ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="{StaticResource Brush.AccentPress}"/>
                                                </Trigger>
                                                <EventTrigger RoutedEvent="Thumb.DragStarted">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.12" Duration="{StaticResource Motion.Press}"/>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.12" Duration="{StaticResource Motion.Press}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="Thumb.DragCompleted">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.0" Duration="{StaticResource Motion.Release}">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.0" Duration="{StaticResource Motion.Release}">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Select: an r2 raised control (lit top, settled bottom, 1 px lit edge). -->
    <Style x:Key="Input.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Fill.Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Edge.Raised}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <!-- Right padding leaves room for the dropdown chevron. -->
        <Setter Property="Padding" Value="14,9,34,9"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Margin="0,0,0,-1" CornerRadius="{StaticResource Radius.Control}" Background="#80000000"/>
                                        <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Fill.Raised}"/>
                                        <Border x:Name="HoverFill" CornerRadius="{StaticResource Radius.Control}"
                                                Background="{StaticResource Fill.RaisedHover}" Opacity="0"/>
                                        <Border x:Name="OpenEdge" CornerRadius="{StaticResource Radius.Control}" BorderThickness="1"
                                                BorderBrush="#26FFFFFF" Opacity="0"/>
                                        <Border CornerRadius="{StaticResource Radius.Control}" BorderThickness="0,1,0,0"
                                                BorderBrush="{StaticResource Edge.Raised}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource Motion.Hover}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="{StaticResource Motion.Hover}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="OpenEdge" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <!-- The dropdown arrow: a chevron, so a combo box reads as one. -->
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon.Base}"
                              Width="10" Height="10" Margin="0,0,14,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Stroke="{StaticResource Brush.TextDim}" IsHitTestVisible="False"/>
                        <!-- Placeholder: the combo box's Tag, shown while nothing is picked. -->
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <Popup x:Name="Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Brush.PanelElevated}"
                                    BorderBrush="{StaticResource Brush.SoftStroke}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="240" Margin="4">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Minimal}"/>
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Radius.Sharp}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Card}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider switch (Will, 2026-10-19, My mods on Home: "maybe a slider would be better
         like a slider on or off"). No box: the toggle's Content (a caps label) sits to
         the left of a 44 x 24 track, and the whole row is one hit target.
         Off  a dark inset track, 1 px edge, grey knob on the left.
         On   the track fills with the family accent (Brush.Acc) inside a soft accent
              glow (Brush.AccSoft); the knob turns white, slides right (140 ms ease-out)
              and shows a small dark tick.
         Hover brightens the track (a light veil over either state); press squashes the
         knob. Space and Enter toggle; focus draws the accent ring (Focus.Button).
         Reusable: any page can drop it in with its own label, or with no Content. -->
    <Style x:Key="Toggle.Slider" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Button}"/>
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="0,0,12,0"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Glow" Margin="-4" CornerRadius="{StaticResource Radius.SwitchGlow}"
                                    Background="{DynamicResource Brush.AccSoft}" Opacity="0"/>
                            <Border x:Name="Track" CornerRadius="{StaticResource Radius.Switch}" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Color.SwitchTrack}"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource Color.SwitchEdge}"/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="TrackOn" CornerRadius="{StaticResource Radius.Switch}"
                                    Background="{DynamicResource Brush.Acc}" Opacity="0"/>
                            <Border x:Name="Veil" CornerRadius="{StaticResource Radius.Switch}"
                                    Background="{StaticResource Brush.OnPhoto}" Opacity="0"/>
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="{StaticResource Radius.Knob}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Color.SwitchKnobOff}"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform X="0"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Path x:Name="Tick" Data="M4.5,9.2 L7.6,12.2 L13.5,6" Opacity="0"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="18" Height="18">
                                    <Path.Stroke>
                                        <SolidColorBrush Color="{StaticResource Color.SwitchTick}"/>
                                    </Path.Stroke>
                                </Path>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                         To="0.1" Duration="{StaticResource Motion.Hover}"/>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.SwitchTrackHover}" Duration="{StaticResource Motion.Hover}"/>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.SwitchEdgeHover}" Duration="{StaticResource Motion.Hover}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Hover}"/>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.SwitchTrack}" Duration="{StaticResource Motion.Hover}"/>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource Color.SwitchEdge}" Duration="{StaticResource Motion.Hover}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.18" Duration="{StaticResource Motion.Press}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="0.86" Duration="{StaticResource Motion.Press}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Release}"/>
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.SwitchKnobOn}" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="20" Duration="{StaticResource Motion.Release}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Release}"/>
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.SwitchKnobOff}" Duration="{StaticResource Motion.Release}"/>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="0" Duration="{StaticResource Motion.Release}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
