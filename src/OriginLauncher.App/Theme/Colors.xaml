<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Origin Ion Jade. These semantic colors mirror OriginTheme.java so the
         launcher and the game feel like one product instead of two skins. -->

    <Color x:Key="Color.Bg">#FF090D0C</Color>
    <Color x:Key="Color.BgAlt">#FF0D1211</Color>
    <Color x:Key="Color.Panel">#FF121918</Color>
    <Color x:Key="Color.PanelElevated">#FF18211F</Color>
    <Color x:Key="Color.PanelGlass">#EB121918</Color>
    <Color x:Key="Color.Card">#FF192320</Color>
    <Color x:Key="Color.CardAlt">#FF23302C</Color>
    <Color x:Key="Color.Stroke">#FF3B524C</Color>
    <Color x:Key="Color.SoftStroke">#FF263732</Color>

    <Color x:Key="Color.Text">#FFEFF7F4</Color>
    <Color x:Key="Color.TextDim">#FFA7BBB5</Color>
    <Color x:Key="Color.TextMuted">#FF6D817B</Color>

    <Color x:Key="Color.Accent">#FF4BC8AE</Color>
    <Color x:Key="Color.AccentHover">#FF79DEC9</Color>
    <Color x:Key="Color.AccentPress">#FF2A9A84</Color>
    <Color x:Key="Color.AccentSoft">#334BC8AE</Color>
    <Color x:Key="Color.AccentBorder">#994BC8AE</Color>
    <Color x:Key="Color.TextOnAccent">#FF061512</Color>

    <!-- Alpha-0 variant of SoftStroke: same RGB as the hover target so a hover
         fade only animates alpha, never drifts white via RGB interpolation. -->
    <Color x:Key="Color.GhostRest">#0023302C</Color>

    <Color x:Key="Color.Danger">#FFE06B7C</Color>
    <Color x:Key="Color.DangerStrong">#FFBB5061</Color>
    <Color x:Key="Color.Success">#FF69C596</Color>
    <Color x:Key="Color.SuccessStrong">#FF4FA77A</Color>
    <Color x:Key="Color.Warning">#FFD4C66A</Color>

    <!-- Brushes -->

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
    <SolidColorBrush x:Key="Brush.BgAlt" Color="{StaticResource Color.BgAlt}"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
    <SolidColorBrush x:Key="Brush.PanelElevated" Color="{StaticResource Color.PanelElevated}"/>
    <SolidColorBrush x:Key="Brush.PanelGlass" Color="{StaticResource Color.PanelGlass}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.CardAlt" Color="{StaticResource Color.CardAlt}"/>
    <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource Color.Stroke}"/>
    <SolidColorBrush x:Key="Brush.SoftStroke" Color="{StaticResource Color.SoftStroke}"/>

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentPress" Color="{StaticResource Color.AccentPress}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="{StaticResource Color.AccentBorder}"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerStrong" Color="{StaticResource Color.DangerStrong}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessStrong" Color="{StaticResource Color.SuccessStrong}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Scrim" Color="#B3000000"/>

    <!-- Window material and subtle atmospheric wash. The hue only appears in
         the accent glow and interactive state, keeping the chrome restrained. -->
    <LinearGradientBrush x:Key="Brush.WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF090D0C" Offset="0"/>
        <GradientStop Color="#FF0C1412" Offset="0.58"/>
        <GradientStop Color="#FF070A09" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF79DEC9" Offset="0"/>
        <GradientStop Color="#FF4BC8AE" Offset="0.55"/>
        <GradientStop Color="#FF2A9A84" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
