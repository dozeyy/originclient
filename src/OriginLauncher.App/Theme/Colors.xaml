<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Origin "Poster" (Will's A2 pick, 2026-10-19): neutral chrome, one tonal
         primary (#E0E0E0), and touches of colour as accents (Will, 2026-10-19: "touches
         of color everywhere as accents ... we dont want to force the mono on everyone").
         Colour lives on small things, never on big fills or body text:
           Brush.Acc      the version family's hue (FamilyTheme swaps it live): the nav
                          underline, switches, checks, progress fills, live and on dots,
                          selected outlines, the Play ring and every keyboard focus ring.
           Brush.AccLine  the same hue at 60%: a quieter outline (hovered or secondary
                          selected edges) where the full hue would shout.
           Brush.AccSoft  the same hue at 18%: a wash behind a selected chip or row.
           Tint.* / TintInk.*  a profile's own colour: the tile and the glyph on it.
         Surfaces step ~8 L* apart. -->

    <Color x:Key="Color.Bg">#FF111111</Color>
    <Color x:Key="Color.BgAlt">#FF161616</Color>
    <Color x:Key="Color.Panel">#FF1A1A1A</Color>
    <Color x:Key="Color.PanelElevated">#FF262626</Color>
    <Color x:Key="Color.PanelGlass">#F5181818</Color>
    <Color x:Key="Color.Card">#FF222222</Color>
    <Color x:Key="Color.CardAlt">#FF2C2C2C</Color>
    <Color x:Key="Color.Stroke">#FF444444</Color>
    <Color x:Key="Color.SoftStroke">#FF2A2A2A</Color>
    <Color x:Key="Color.Track">#FF555555</Color>

    <!-- TextMuted on Bg is 7.09:1; secondary lines inside raised controls use TextDim. -->
    <Color x:Key="Color.Text">#FFDCDCDC</Color>
    <Color x:Key="Color.TextDim">#FFC4C4C4</Color>
    <Color x:Key="Color.TextMuted">#FFADADAD</Color>
    <Color x:Key="Color.OnPhoto">#FFE6E6E6</Color>

    <!-- "Accent" is the tonal primary (the brand's one accent). The family hue is Acc. -->
    <Color x:Key="Color.Accent">#FFE0E0E0</Color>
    <Color x:Key="Color.AccentHover">#FFEDEDED</Color>
    <Color x:Key="Color.AccentPress">#FFC9C9C9</Color>
    <Color x:Key="Color.AccentSoft">#1FE0E0E0</Color>
    <Color x:Key="Color.AccentBorder">#66E0E0E0</Color>
    <Color x:Key="Color.TextOnAccent">#FF141414</Color>

    <!-- The default family accent (1.21 Tricky Trials). FamilyTheme swaps the live
         Brush.Acc instance at runtime; read it with DynamicResource. -->
    <Color x:Key="Color.Acc">#FFE8914F</Color>

    <!-- Alpha-0 variant of SoftStroke: same RGB as the hover target so a hover
         fade only animates alpha, never drifts white via RGB interpolation. -->
    <Color x:Key="Color.GhostRest">#002A2A2A</Color>

    <!-- Toggle.Slider (Theme/Inputs.xaml). Off: a dark inset track with a 1 px edge and
         a grey knob. On: the track is the family accent (Brush.Acc) and the knob white. -->
    <Color x:Key="Color.SwitchTrack">#FF1A1A1A</Color>
    <Color x:Key="Color.SwitchTrackHover">#FF262626</Color>
    <Color x:Key="Color.SwitchEdge">#FF3C3C3C</Color>
    <Color x:Key="Color.SwitchEdgeHover">#FF5A5A5A</Color>
    <Color x:Key="Color.SwitchKnobOff">#FF8E8E8E</Color>
    <Color x:Key="Color.SwitchKnobOn">#FFF7F7F7</Color>
    <Color x:Key="Color.SwitchTick">#FF161616</Color>

    <!-- Status colours: information only, never decoration. -->
    <Color x:Key="Color.Info">#FF8FB8E8</Color>
    <Color x:Key="Color.Danger">#FFE8786B</Color>
    <Color x:Key="Color.DangerStrong">#FFC4574B</Color>
    <Color x:Key="Color.Success">#FF7BCB98</Color>
    <Color x:Key="Color.SuccessStrong">#FF5AAE7A</Color>
    <Color x:Key="Color.Warning">#FFE2C06A</Color>

    <!-- Brushes -->

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
    <SolidColorBrush x:Key="Brush.BgAlt" Color="{StaticResource Color.BgAlt}"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
    <SolidColorBrush x:Key="Brush.PanelElevated" Color="{StaticResource Color.PanelElevated}"/>
    <SolidColorBrush x:Key="Brush.PanelGlass" Color="{StaticResource Color.PanelGlass}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.CardAlt" Color="{StaticResource Color.CardAlt}"/>
    <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource Color.Stroke}"/>
    <SolidColorBrush x:Key="Brush.SoftStroke" Color="{StaticResource Color.SoftStroke}"/>
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}"/>
    <SolidColorBrush x:Key="Brush.Inset" Color="#FF141414"/>

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.OnPhoto" Color="{StaticResource Color.OnPhoto}"/>
    <!-- The giant background numeral: neutral ink, never the family hue (Will,
         2026-10-19: "return the colored version big number back to black and white
         just make it a tiny bit more visible"). 0x36 = ~21%, up from 0x26. -->
    <SolidColorBrush x:Key="Brush.NumeralInk" Color="#36ECECEC"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentPress" Color="{StaticResource Color.AccentPress}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="{StaticResource Color.AccentBorder}"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}"/>

    <!-- Family accent. Always referenced with DynamicResource: FamilyTheme replaces
         this entry with an unfrozen brush and tweens its Color (700 ms). -->
    <SolidColorBrush x:Key="Brush.Acc" Color="{StaticResource Color.Acc}"/>
    <SolidColorBrush x:Key="Brush.AccSoft" Color="#2EE8914F"/>
    <SolidColorBrush x:Key="Brush.AccLine" Color="#99E8914F"/>

    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerStrong" Color="{StaticResource Color.DangerStrong}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessStrong" Color="{StaticResource Color.SuccessStrong}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>

    <!-- Overlays over the art: drawer scrim, page dim (non-Home pages), launch scrim. -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#A80A0A0A"/>
    <SolidColorBrush x:Key="Brush.PageDim" Color="#D60E0E0E"/>
    <SolidColorBrush x:Key="Brush.LaunchScrim" Color="#9E0C0C0C"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#2EE0E0E0"/>

    <!-- Top and bottom scrims that keep text over the art at 7:1. -->
    <LinearGradientBrush x:Key="Brush.ScrimTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E60E0E0E" Offset="0"/>
        <GradientStop Color="#D60E0E0E" Offset="0.4"/>
        <GradientStop Color="#000E0E0E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ScrimBottom" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#ED0E0E0E" Offset="0"/>
        <GradientStop Color="#E60E0E0E" Offset="0.515"/>
        <GradientStop Color="#000E0E0E" Offset="1"/>
    </LinearGradientBrush>

    <!-- r2 control fills: a lit top and a settled bottom. -->
    <LinearGradientBrush x:Key="Fill.Raised" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF313131" Offset="0"/>
        <GradientStop Color="#FF272727" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.RaisedHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF393939" Offset="0"/>
        <GradientStop Color="#FF2E2E2E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.RaisedPress" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF242424" Offset="0"/>
        <GradientStop Color="#FF282828" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.Primary" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF0F0F0" Offset="0"/>
        <GradientStop Color="#FFD6D6D6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.PrimaryHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF7F7F7" Offset="0"/>
        <GradientStop Color="#FFE0E0E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.PrimaryPress" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFCDCDCD" Offset="0"/>
        <GradientStop Color="#FFD5D5D5" Offset="1"/>
    </LinearGradientBrush>
    <!-- The 1 px lit top edge drawn inside a raised control (and the primary's). -->
    <SolidColorBrush x:Key="Edge.Raised" Color="#13FFFFFF"/>
    <SolidColorBrush x:Key="Edge.Primary" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="Edge.PrimaryBottom" Color="#29000000"/>
    <Color x:Key="Color.EdgePrimary">#CCFFFFFF</Color>
    <Color x:Key="Color.EdgePrimaryBottom">#29000000</Color>

    <!-- r2 body as a solid colour (the mid of Fill.Raised) so styles can animate
         Background.Color; the lit gradient look comes from the Fill.Sheen layer
         drawn over it. Hover / press are the mids of RaisedHover / RaisedPress. -->
    <Color x:Key="Color.RaisedBody">#FF2C2C2C</Color>
    <Color x:Key="Color.RaisedHover">#FF343434</Color>
    <Color x:Key="Color.RaisedPress">#FF262626</Color>
    <SolidColorBrush x:Key="Brush.RaisedBody" Color="{StaticResource Color.RaisedBody}"/>
    <LinearGradientBrush x:Key="Fill.Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0AFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
        <GradientStop Color="#0D000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fill.PrimarySheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1FFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
        <GradientStop Color="#14000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- The shade a bottom sheet casts up onto the art (a gradient, not an effect). -->
    <LinearGradientBrush x:Key="Fill.SheetShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#73000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- The 1 px dark contact line under a raised control (stands in for a blur shadow). -->
    <SolidColorBrush x:Key="Brush.Contact" Color="#99000000"/>

    <!-- Profile colours: a deep tile (Tint.*) and the light ink drawn on it
         (TintInk.*, the same hue; every ink is 6.8:1 or better on its own tile). ProfileLook
         picks the profile's own, else one from its id. -->
    <SolidColorBrush x:Key="Tint.Slate" Color="#FF24405E"/>
    <SolidColorBrush x:Key="Tint.Plum" Color="#FF3F2D63"/>
    <SolidColorBrush x:Key="Tint.Umber" Color="#FF57391F"/>
    <SolidColorBrush x:Key="Tint.Moss" Color="#FF234D35"/>
    <SolidColorBrush x:Key="Tint.Wine" Color="#FF5A2634"/>
    <SolidColorBrush x:Key="Tint.Graphite" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="TintInk.Slate" Color="#FFB4D2F5"/>
    <SolidColorBrush x:Key="TintInk.Plum" Color="#FFD3BFF7"/>
    <SolidColorBrush x:Key="TintInk.Umber" Color="#FFF5CDA6"/>
    <SolidColorBrush x:Key="TintInk.Moss" Color="#FFB0E8C5"/>
    <SolidColorBrush x:Key="TintInk.Wine" Color="#FFF5B6C5"/>
    <SolidColorBrush x:Key="TintInk.Graphite" Color="#FFE6E6E6"/>

    <!-- Legacy names kept so older surfaces still resolve; both are now neutral. -->
    <SolidColorBrush x:Key="Brush.WindowBackdrop" Color="{StaticResource Color.Bg}"/>
    <LinearGradientBrush x:Key="Brush.PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF0F0F0" Offset="0"/>
        <GradientStop Color="#FFD6D6D6" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
