<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        Workbench type (docs/overhaul/DESIGN-SYSTEM.md section 3). Inter is the only UI face (bundled static
        TTFs 400-800, OFL); the installer shows no code or log text, so no monospace face is bundled.
        Sentence case everywhere: the installer uses no uppercase label, so type.label is not defined here.
        WPF's TextBlock has no letter-spacing, so the small negative tracking on title and display is left out.
        Every style fixes its line height so a block is the same height on every machine.
    -->
    <FontFamily x:Key="Font.Primary">/OriginSetup;component/Assets/Fonts/#Inter, Segoe UI</FontFamily>

    <system:Double x:Key="FontSize.Caption">12</system:Double>
    <system:Double x:Key="FontSize.Body">13.5</system:Double>
    <system:Double x:Key="FontSize.Title">16</system:Double>
    <system:Double x:Key="FontSize.Display">32</system:Double>
    <system:Double x:Key="LineHeight.Caption">16</system:Double>
    <system:Double x:Key="LineHeight.Body">20</system:Double>
    <system:Double x:Key="LineHeight.Title">22</system:Double>
    <system:Double x:Key="LineHeight.Display">36</system:Double>

    <!-- Home's status line: one fixed line slot while idle; an error wraps to two rows at the status width (its
         full text is in the tooltip) and the row takes both rows' height, so the card rises by one fixed step. -->
    <system:Double x:Key="Size.StatusLine">16</system:Double>
    <system:Double x:Key="Size.StatusLinesMax">32</system:Double>
    <system:Double x:Key="Size.StatusWidth">400</system:Double>

    <!-- type.body: default text and descriptions. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Text.BodyDim" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <!-- type.bodyStrong: button labels, names, row titles. -->
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- type.caption: status lines, meta, helper text. Figures are tabular so counts do not jitter. -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="Text.CaptionDim" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
    </Style>

    <!-- type.title: card, dialog and state titles. -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Title}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- type.display: the installer's one headline per state. One line, trimmed rather than wrapped,
         so every state starts its text in the same place. Ideal formatting keeps big Inter smooth. -->
    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Display}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
</ResourceDictionary>
