<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:OriginSetup.UI"
                    xmlns:lui="clr-namespace:OriginLauncher.App.UI">

    <!--
        Workbench controls for the installer (docs/overhaul/DESIGN-SYSTEM.md sections 5, 8, 11). Everything refers
        to Theme/Tokens.xaml; there is no colour or size written in this file.

        One button template, four fills (Primary, Secondary, Ghost, Danger) and two sizes: lg 36 tall (every
        installer and dialog button) and sm 28 tall (the Change action inside the location field). The title bar's
        window buttons are 32 square (md). Same states on all of them (spec 8): hover and press change the fill, a
        press scales the button to .97 (lui:Press), disabled takes no hover, and the keyboard ring is a 2 px
        accent-line outline 2 px off the edge, shown only for keyboard focus (ui:Chrome.KeyFocus).
    -->

    <ControlTemplate x:Key="Template.Button" TargetType="Button">
        <Grid>
            <Border x:Name="Ring" Margin="-4" BorderThickness="2" BorderBrush="{StaticResource Brush.AccentBorder}"
                    CornerRadius="{Binding Path=(ui:Chrome.RingCorner), RelativeSource={RelativeSource TemplatedParent}}"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                    CornerRadius="{Binding Path=(ui:Chrome.Corner), RelativeSource={RelativeSource TemplatedParent}}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:Chrome.KeyFocus" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- size.control.lg: dialog and installer buttons. The size is a MINIMUM (not a fixed Height/Width) so a larger
         label or glyph grows the button instead of being cut at its edge: OriginLauncher.Tests/IconButtonTests
         scans this file too. The labels used here are all shorter than the minimum, so every button is exactly 36. -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource Template.Button}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Md}"/>
        <Setter Property="ui:Chrome.RingCorner" Value="{StaticResource Radius.Ring.Md}"/>
        <Setter Property="lui:Press.Scale" Value="0.97"/>
    </Style>

    <!-- Primary: the one emerald fill per screen. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentPress}"/>
                <Setter Property="lui:Press.Down" Value="True"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary: raised fill, strong edge. -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.CardAlt}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.StrokeHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SurfacePress}"/>
                <Setter Property="lui:Press.Down" Value="True"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.SoftStroke}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost: no fill, no edge; tertiary actions (Cancel, Close, Keep Origin). -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.GhostHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.GhostPress}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Setter Property="lui:Press.Down" Value="True"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Danger: soft red fill, never a filled red primary. -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoftHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoftHover}"/>
                <Setter Property="lui:Press.Down" Value="True"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- size.control.sm: the ghost "Change" inside the location field. 28 tall, label 12 / 600, radius.sm. -->
    <Style x:Key="Button.GhostSm" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlSm}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="ui:Chrome.RingCorner" Value="{StaticResource Radius.Ring.Sm}"/>
    </Style>

    <!-- size.control.md: the title bar's window buttons. 32 square, glyph 12 (the Path in Content takes the
         button's Foreground). Close turns soft red on hover. -->
    <Style x:Key="Button.Window" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinWidth" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ui:Chrome.Corner" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="ui:Chrome.RingCorner" Value="{StaticResource Radius.Ring.Sm}"/>
    </Style>

    <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.Window}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.DangerSoftHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}"/>
                <Setter Property="lui:Press.Down" Value="True"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Checkbox (spec 11.8): 16 box, radius.xs, strong edge; checked = accent fill + a 12 check in onAccent.
         The whole row (box + label) is the hit target. The label keeps body type from the style below. -->
    <ControlTemplate x:Key="Template.CheckBox" TargetType="CheckBox">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="{StaticResource Size.Checkbox}" Height="{StaticResource Size.Checkbox}" VerticalAlignment="Center">
                <Border x:Name="Ring" Margin="-4" BorderThickness="2" BorderBrush="{StaticResource Brush.AccentBorder}"
                        CornerRadius="{StaticResource Radius.Ring.Xs}" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Border x:Name="Box" BorderThickness="1" BorderBrush="{StaticResource Brush.Stroke}"
                        Background="Transparent" CornerRadius="{StaticResource Radius.Xs}"/>
                <Border x:Name="Fill" Visibility="Collapsed" CornerRadius="{StaticResource Radius.Xs}"
                        Background="{Binding Path=(ui:Chrome.CheckFill), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Path x:Name="Tick" Data="{StaticResource Icon.Check}" Stretch="Uniform" Visibility="Collapsed"
                      Width="{StaticResource Icon.SizeCheck}" Height="{StaticResource Icon.SizeCheck}"
                      Stroke="{StaticResource Brush.TextOnAccent}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.StrokeHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ui:Chrome.KeyFocus" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CheckBox.Workbench" TargetType="CheckBox">
        <Setter Property="Template" Value="{StaticResource Template.CheckBox}"/>
        <Setter Property="MinHeight" Value="{StaticResource LineHeight.Body}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="ui:Chrome.CheckFill" Value="{StaticResource Brush.Accent}"/>
    </Style>

    <!-- The uninstaller's "also delete my data" box: when ticked, its fill and label turn to the danger colours
         so the one irreversible choice reads as one (spec 14). -->
    <Style x:Key="CheckBox.Danger" TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Workbench}">
        <Setter Property="ui:Chrome.CheckFill" Value="{StaticResource Brush.Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Slider (spec 11): 4 track, accent fill up to the thumb, 16 round thumb, keyboard ring ===== -->
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="{StaticResource Size.SliderTrack}" CornerRadius="{StaticResource Radius.Full}"
                                Background="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Rest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="Width" Value="{StaticResource Size.SliderThumb}"/>
        <Setter Property="Height" Value="{StaticResource Size.SliderThumb}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Dot" Fill="{StaticResource Brush.Text}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Template.Slider" TargetType="Slider">
        <Grid Height="{StaticResource Size.SliderBox}" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="Ring" Margin="{StaticResource Margin.SliderRing}" BorderThickness="2" BorderBrush="{StaticResource Brush.AccentBorder}"
                    CornerRadius="{StaticResource Radius.Ring.Sm}" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border Height="{StaticResource Size.SliderTrack}" CornerRadius="{StaticResource Radius.Full}"
                    Background="{StaticResource Brush.ProgressTrack}" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Slider.Fill}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Slider.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Slider.Rest}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:Chrome.KeyFocus" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Slider.Workbench" TargetType="Slider">
        <Setter Property="Template" Value="{StaticResource Template.Slider}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ===== Dropdown (spec 11): the location field's look (36 tall, field fill, strong edge, radius.md), a line
         chevron on the right, a panel-fill list with radius.md and radius.sm rows. Same keyboard ring as a button. ===== -->
    <Style x:Key="Combo.Item" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Item}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Radius.Sm}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.GhostHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Template.ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Edge" Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Stroke}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Md}"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Brush.StrokeHover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="Template.Combo" TargetType="ComboBox">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Ring" Margin="{StaticResource Margin.Ring}" BorderThickness="2"
                    BorderBrush="{StaticResource Brush.AccentBorder}" CornerRadius="{StaticResource Radius.Ring.Md}"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
            <ToggleButton Template="{StaticResource Template.ComboToggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Margin="{StaticResource Pad.ComboText}" VerticalAlignment="Center" HorizontalAlignment="Left"
                              IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Path Data="{StaticResource Icon.Chevron}" Stretch="Uniform" Width="{StaticResource Icon.SizeWindow}"
                  Height="{StaticResource Icon.SizeWindow}" Stroke="{StaticResource Brush.TextDim}"
                  StrokeThickness="{StaticResource Icon.Stroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" HorizontalAlignment="Right" Margin="{StaticResource Margin.Chevron}"
                  IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{StaticResource Size.ListMaxHeight}" Margin="{StaticResource Margin.List}"
                        Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Stroke}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="{StaticResource Pad.List}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:Chrome.KeyFocus" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Combo.Workbench" TargetType="ComboBox">
        <Setter Property="Template" Value="{StaticResource Template.Combo}"/>
        <Setter Property="Height" Value="{StaticResource Size.ControlLg}"/>
        <Setter Property="Width" Value="{StaticResource Size.ComboWidth}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Combo.Item}"/>
    </Style>

    <!-- The one progress element (spec 11.11): 3 tall, full radius, a faint track, an accent fill. The fill
         grows by code (PageMotion.Width) to the real fraction; there is never a fake percentage. -->
    <Style x:Key="Setup.ProgressTrack" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Size.Progress}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Full}"/>
        <Setter Property="Background" Value="{StaticResource Brush.ProgressTrack}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="Setup.ProgressFill" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Full}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
    </Style>
</ResourceDictionary>
