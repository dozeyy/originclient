<Application x:Class="OriginSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order matters: tokens first (everything reads them), then type, the shared glyph set,
                     the controls, and last the installer's own pieces + the brand reference. -->
                <ResourceDictionary Source="Theme/Tokens.xaml"/>
                <ResourceDictionary Source="Theme/Typography.xaml"/>
                <ResourceDictionary Source="Theme/Icons.xaml"/>
                <ResourceDictionary Source="Theme/Controls.xaml"/>
                <ResourceDictionary Source="Theme/Setup.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Workbench}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
