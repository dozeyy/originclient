<Window x:Class="OriginSetup.UI.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:OriginSetup.UI"
        Title="Uninstall Origin"
        Icon="/OriginSetup;component/Assets/origin.ico"
        Width="860" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <!-- Same window, same pages, same styles as SetupWindow: the uninstall flow is the
         installer's Welcome / Installing / Done / Problem pages with different words. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid Background="{StaticResource Brush.WindowBackdrop}" IsHitTestVisible="False">
            <Rectangle Opacity="0.72" Fill="{StaticResource Brush.Deepslate}"/>
        </Grid>

        <Grid Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <ui:TitleBar x:Name="Bar" Mode="UNINSTALL"/>

            <Grid Margin="0,56,0,56">

                <!-- ============ CONFIRM ============ -->
                <Grid x:Name="ConfirmPage">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                        <ui:OrbitMark Width="96" Height="96" Margin="0,0,0,24"/>
                        <TextBlock Text="UNINSTALL" Style="{StaticResource Text.Eyebrow}"
                                   Foreground="{StaticResource Brush.AccentHover}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Uninstall Origin?" Style="{StaticResource Text.Display}"
                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,10"/>
                        <TextBlock x:Name="ConfirmBody" Style="{StaticResource Text.BodyDim}" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center"
                                   Text="This removes Origin Launcher, its shortcuts and its startup entry from this PC."/>

                        <Border Style="{StaticResource Setup.Card}" Margin="0,24,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Also delete my Origin data" Style="{StaticResource Text.Body}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               Text="Accounts, settings and game installs, including the worlds saved inside them. Leave this off to keep everything for later."/>
                                </StackPanel>
                                <ToggleButton x:Name="RemoveDataToggle" Grid.Column="1" Style="{StaticResource Toggle.Slider}"
                                              VerticalAlignment="Center" AutomationProperties.Name="Also delete my Origin data"
                                              Checked="RemoveDataToggle_Changed" Unchecked="RemoveDataToggle_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Keep is the default (Enter). The danger colour is on the final button only. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Keep Origin" MinWidth="168"
                                    Click="Keep_Click" IsDefault="True"/>
                            <Button x:Name="UninstallButton" Style="{StaticResource Button.Danger}" Content="Uninstall"
                                    MinWidth="128" Margin="14,0,0,0" Click="Uninstall_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ REMOVING (the installer's Installing page, same layout) ============ -->
                <Grid x:Name="RemovingPage" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                        <ui:OrbitMark x:Name="RemovingMark" Width="96" Height="96" Margin="0,0,0,28"/>
                        <TextBlock Text="REMOVING" Style="{StaticResource Text.Eyebrow}"
                                   Foreground="{StaticResource Brush.AccentHover}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Origin Launcher" Style="{StaticResource Text.H1}" HorizontalAlignment="Center"
                                   Margin="0,6,0,24"/>
                        <Border x:Name="ProgressTrack" Style="{StaticResource Setup.ProgressTrack}" Width="380">
                            <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.Bar}"
                                    Background="{StaticResource Brush.PrimaryGradient}"/>
                        </Border>
                        <Grid Width="380" Margin="0,12,0,0">
                            <TextBlock x:Name="StageText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="PercentText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Brush.Text}"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ============ DONE ============ -->
                <Grid x:Name="DonePage" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                        <ui:OrbitMark Width="112" Height="112" Margin="0,0,0,26"/>
                        <TextBlock Text="REMOVED" Style="{StaticResource Text.Eyebrow}"
                                   Foreground="{StaticResource Brush.Success}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DoneTitle" Text="Origin has been removed" Style="{StaticResource Text.Display}"
                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,10"/>
                        <TextBlock x:Name="DoneBody" Style="{StaticResource Text.BodyDim}" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center"/>
                        <Button x:Name="DoneCloseButton" Style="{StaticResource Button.Primary}" Content="Close" MinWidth="168"
                                HorizontalAlignment="Center" Margin="0,30,0,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ============ PROBLEM (same as the installer's) ============ -->
                <Grid x:Name="ProblemPage" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="540">
                        <Border Width="48" Height="48" CornerRadius="{StaticResource Radius.Row}" BorderThickness="2" HorizontalAlignment="Center"
                                BorderBrush="{StaticResource Brush.Warning}" Margin="0,0,0,24">
                            <TextBlock Text="!" FontFamily="{StaticResource Font.Display}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Warning}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="NOT FULLY REMOVED" Style="{StaticResource Text.Eyebrow}"
                                   Foreground="{StaticResource Brush.Warning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Origin is mostly removed" Style="{StaticResource Text.H1}"
                                   HorizontalAlignment="Center" Margin="0,8,0,10"/>
                        <TextBlock x:Name="ProblemBody" Style="{StaticResource Text.BodyDim}" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center"/>
                        <Button x:Name="ProblemCloseButton" Style="{StaticResource Button.Primary}" Content="Close" MinWidth="168"
                                HorizontalAlignment="Center" Margin="0,28,0,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Step rail, same as the installer's. -->
            <StackPanel x:Name="StepRail" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="22,0,0,24" IsHitTestVisible="False">
                <Border x:Name="Step1Marker" Style="{StaticResource Setup.StepMarker}"/>
                <TextBlock x:Name="Step1Label" Text="CONFIRM" Style="{StaticResource Setup.StepLabel}"/>
                <Border x:Name="Step2Marker" Style="{StaticResource Setup.StepMarker}"/>
                <TextBlock x:Name="Step2Label" Text="REMOVE" Style="{StaticResource Setup.StepLabel}"/>
                <Border x:Name="Step3Marker" Style="{StaticResource Setup.StepMarker}"/>
                <TextBlock x:Name="Step3Label" Text="DONE" Style="{StaticResource Setup.StepLabel}"/>
            </StackPanel>
        </Grid>

        <Border BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
