<Window x:Class="OriginSetup.UI.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:OriginSetup.UI"
        Title="Uninstall Origin"
        Icon="/OriginSetup;component/Assets/origin.ico"
        Width="{StaticResource Size.WindowWidth}" Height="{StaticResource Size.WindowHeight}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <!-- The uninstaller is the installer's window (spec 14): same size, title bar, hero, content start and
         footer, with the uninstall words. One screen, four states. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" MouseLeftButtonDown="Bar_MouseLeftButtonDown"/>
        <ui:BrandHero Grid.Row="1" Margin="{StaticResource Pad.Hero}"/>

        <Grid Grid.Row="2">

            <!-- ============ CONFIRM ============ -->
            <Grid x:Name="ConfirmPage" Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" Text="Uninstall Origin?"/>
                    <TextBlock Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.1}"
                               Text="Origin and its shortcuts are removed."/>
                    <!-- Off by default: uninstalling never deletes worlds unless the player ticks this. -->
                    <CheckBox x:Name="RemoveDataCheck" Style="{StaticResource CheckBox.Danger}" Margin="{StaticResource Top.5}"
                              Content="Also delete my worlds, settings and accounts"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Left.6}"
                               Text="Leave this off to keep them for a later reinstall."/>
                </StackPanel>
                <!-- Keep Origin is the default (Enter, and the first focus). The danger colour is on the final button only. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="KeepButton" Style="{StaticResource Button.Ghost}" Content="Keep Origin"
                            Click="Keep_Click" IsDefault="True"/>
                    <Button x:Name="UninstallButton" Style="{StaticResource Button.Danger}" Margin="{StaticResource Left.2}"
                            Content="Uninstall" Click="Uninstall_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ REMOVING ============ -->
            <Grid x:Name="RemovingPage" Visibility="Collapsed" Margin="{StaticResource Pad.Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" Text="Removing Origin"/>
                    <TextBlock Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.1}"
                               Text="This takes a moment."/>
                    <Border x:Name="ProgressTrack" Style="{StaticResource Setup.ProgressTrack}" Margin="{StaticResource Top.6}">
                        <Border x:Name="ProgressFill" Style="{StaticResource Setup.ProgressFill}" Width="0"/>
                    </Border>
                    <Grid Margin="{StaticResource Top.3}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StageText" Style="{StaticResource Text.Caption}"/>
                        <TextBlock x:Name="PercentText" Grid.Column="1" Style="{StaticResource Text.CaptionDim}"
                                   Margin="{StaticResource Left.2}"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ============ DONE ============ -->
            <Grid x:Name="DonePage" Visibility="Collapsed" Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" Text="Origin was removed"/>
                    <TextBlock x:Name="DoneBody" Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.1}"/>
                    <Grid Margin="{StaticResource Top.4}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource Setup.Dot}" Fill="{StaticResource Brush.Success}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Success}" Text="Removed"/>
                    </Grid>
                    <!-- Where the kept data lives (only when it was kept). -->
                    <TextBlock x:Name="KeptCaption" Style="{StaticResource Text.Caption}" Margin="{StaticResource Top.4}"
                               Text="Kept in" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="KeptPath" Style="{StaticResource Text.CaptionDim}" TextWrapping="NoWrap"
                               Margin="{StaticResource Top.1}" SizeChanged="KeptPath_SizeChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DoneCloseButton" Style="{StaticResource Button.Primary}" Content="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ PROBLEM ============ -->
            <Grid x:Name="ProblemPage" Visibility="Collapsed" Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" Text="Origin is mostly removed"/>
                    <Grid Margin="{StaticResource Top.2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource Setup.Dot}" Fill="{StaticResource Brush.Danger}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.DangerText}" Text="Some files could not be removed"/>
                    </Grid>
                    <TextBlock x:Name="ProblemBody" Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.4}"/>
                    <!-- The folder on its own line, shortened in the middle so it never wraps mid-path. -->
                    <TextBlock x:Name="ProblemPath" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap"
                               Margin="{StaticResource Top.2}" SizeChanged="ProblemPath_SizeChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ProblemCloseButton" Style="{StaticResource Button.Primary}" Content="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="3" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
