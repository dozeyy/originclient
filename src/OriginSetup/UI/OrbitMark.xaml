<UserControl x:Class="OriginSetup.UI.OrbitMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <!-- The Origin mark (same three rings as the launcher's OriginMark: one
         ellipse at 0/60/120 degrees, three sizes) — but alive: each ring
         orbits at its own pace. Calm on the welcome screen, quicker while
         installing (SetSpeed), still when Windows animations are off. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="200" Height="200" Effect="{StaticResource Effect.OriginGlow}">
            <Ellipse Width="180" Height="64" Stroke="{StaticResource Brush.Text}" StrokeThickness="3"
                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="Ring1" Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="150" Height="54" Stroke="{StaticResource Brush.Text}" StrokeThickness="3"
                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="Ring2" Angle="60"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="120" Height="44" Stroke="{StaticResource Brush.Text}" StrokeThickness="3"
                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="Ring3" Angle="120"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
    </Viewbox>
</UserControl>
