<Window x:Class="OriginSetup.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:OriginSetup.UI"
        Title="Origin Setup"
        Icon="/OriginSetup;component/Assets/origin.ico"
        Width="{StaticResource Size.WindowWidth}" Height="{StaticResource Size.WindowHeight}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <!--
        Origin Setup, installer (docs/overhaul/DESIGN-SYSTEM.md section 14): ONE screen with states, no wizard.
        Title bar, then the hero (logo + wordmark), then the state's content starting in the same place, then a
        footer pinned 32 above the bottom. Every state is a page below; only one is visible at a time.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" MouseLeftButtonDown="Bar_MouseLeftButtonDown"/>
        <ui:BrandHero Grid.Row="1" Margin="{StaticResource Pad.Hero}"/>

        <Grid x:Name="PagesHost" Grid.Row="2">

            <!-- ============ READY (install / update / reinstall) ============ -->
            <Grid x:Name="ReadyPage" Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ReadyTitle" Style="{StaticResource Text.Display}" Text="Install Origin"/>
                    <TextBlock x:Name="ReadyBody" Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.1}"/>

                    <!-- Location: an editable path with a ghost Change inside on the right. Unfocused it shows the path
                         shortened in the middle (LocationText, over the box); focused, the box itself is edited. -->
                    <Border x:Name="LocationField" Style="{StaticResource Setup.Field}" Margin="{StaticResource Top.5}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocationBox" Style="{StaticResource Setup.FieldInput}"
                                     Margin="{StaticResource Pad.FieldText}" Opacity="0" SpellCheck.IsEnabled="False"
                                     TextChanged="LocationBox_TextChanged" GotKeyboardFocus="LocationBox_FocusChanged"
                                     LostKeyboardFocus="LocationBox_FocusChanged" AutomationProperties.Name="Install folder"/>
                            <TextBlock x:Name="LocationText" Style="{StaticResource Text.Body}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Margin="{StaticResource Pad.FieldText}" IsHitTestVisible="False"
                                       SizeChanged="LocationText_SizeChanged"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource Button.GhostSm}"
                                    Content="Change" Margin="{StaticResource Pad.FieldAction}" Click="BrowseButton_Click"
                                    AutomationProperties.Name="Change install folder"/>
                        </Grid>
                    </Border>

                    <!-- One status line under the field: a hint normally, a danger dot + the reason when the folder won't do. -->
                    <Grid Margin="{StaticResource Top.2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="LocationDot" Style="{StaticResource Setup.Dot}" Fill="{StaticResource Brush.Danger}"
                                 Visibility="Collapsed"/>
                        <TextBlock x:Name="LocationStatus" Grid.Column="1" Style="{StaticResource Text.Caption}"/>
                    </Grid>

                    <CheckBox x:Name="StartupCheck" Margin="{StaticResource Top.4}"
                              Content="Open Origin when Windows starts"/>

                    <!-- Customize (closed by default; the footer's Customize button opens it and the window grows to
                         fit): memory for Minecraft and the version Origin opens on. Both are optional: untouched,
                         the installer hands the launcher nothing and it picks its own defaults. -->
                    <StackPanel x:Name="CustomizePanel" Visibility="Collapsed" Margin="{StaticResource Top.4}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Body}" Text="Memory for Minecraft"/>
                            <TextBlock x:Name="RamValue" Grid.Column="1" Style="{StaticResource Text.BodyStrong}"/>
                        </Grid>
                        <Slider x:Name="RamSlider" Style="{StaticResource Slider.Workbench}" Margin="{StaticResource Top.2}"
                                SmallChange="256" LargeChange="1024" TickFrequency="256" IsSnapToTickEnabled="True"
                                ValueChanged="RamSlider_ValueChanged" AutomationProperties.Name="Memory for Minecraft"/>
                        <Grid Margin="{StaticResource Top.2}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RamHint" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                            <Button x:Name="RamResetButton" Grid.Column="1" Style="{StaticResource Button.GhostSm}"
                                    Margin="{StaticResource Margin.GhostSmTrailEdge}"
                                    Content="Use recommended" Click="RamResetButton_Click"/>
                        </Grid>
                        <Grid Margin="{StaticResource Top.3}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center" Text="Default version"/>
                            <ComboBox x:Name="VersionCombo" Grid.Column="1" Style="{StaticResource Combo.Workbench}"
                                      AutomationProperties.Name="Default Minecraft version"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Customize on the left (it never moves, open or closed), Cancel and Install on the right. -->
                <Grid Grid.Row="1">
                    <Button x:Name="CustomizeButton" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                            Margin="{StaticResource Margin.GhostLeadEdge}"
                            Click="CustomizeButton_Click" AutomationProperties.Name="Customize install options">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Customize" VerticalAlignment="Center"/>
                            <Path x:Name="CustomizeChevron" Data="{StaticResource Icon.Chevron}" Style="{StaticResource Setup.Glyph}"
                                  Margin="{StaticResource Margin.Glyph}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="CustomizeTurn" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ReadyCancelButton" Style="{StaticResource Button.Ghost}" Content="Cancel" Click="CloseButton_Click"/>
                        <Button x:Name="InstallButton" Style="{StaticResource Button.Primary}" Margin="{StaticResource Left.2}"
                                Content="Install" Click="InstallButton_Click" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ INSTALLING ============ -->
            <Grid x:Name="InstallingPage" Visibility="Collapsed" Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="InstallingTitle" Style="{StaticResource Text.Display}" Text="Installing Origin"/>
                    <TextBlock Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.1}"
                               Text="This takes about a minute. You can keep using your PC."/>
                    <Border x:Name="ProgressTrack" Style="{StaticResource Setup.ProgressTrack}" Margin="{StaticResource Top.6}">
                        <Border x:Name="ProgressFill" Style="{StaticResource Setup.ProgressFill}" Width="0"/>
                    </Border>
                    <Grid Margin="{StaticResource Top.3}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StageText" Style="{StaticResource Text.Caption}"/>
                        <TextBlock x:Name="PercentText" Grid.Column="1" Style="{StaticResource Text.CaptionDim}"
                                   Margin="{StaticResource Left.2}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource Button.Ghost}" Content="Cancel" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ DONE ============ -->
            <Grid x:Name="DonePage" Visibility="Collapsed" Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DoneTitle" Style="{StaticResource Text.Display}" Text="Origin is installed"/>
                    <TextBlock Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.1}"
                               Text="Origin is on your desktop and in the Start menu."/>
                    <Grid Margin="{StaticResource Top.4}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource Setup.Dot}" Fill="{StaticResource Brush.Success}"/>
                        <TextBlock x:Name="DoneStatus" Grid.Column="1" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.Success}"/>
                    </Grid>
                    <!-- Optional: open the launcher straight into "Import from another Minecraft launcher". Off by default.
                         (The name ImportToggle is pinned by OriginSetup.Tests/FinishLaunchTests.) -->
                    <CheckBox x:Name="ImportToggle" Margin="{StaticResource Top.5}"
                              Content="Import from another Minecraft launcher"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Left.6}"
                               Text="Bring over your mods, settings and packs when Origin opens."/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Ghost}" Content="Close" Click="CloseButton_Click"/>
                    <Button x:Name="LaunchButton" Style="{StaticResource Button.Primary}" Margin="{StaticResource Left.2}"
                            Content="Open Origin" Click="LaunchButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ PROBLEM ============ -->
            <Grid x:Name="ProblemPage" Visibility="Collapsed" Margin="{StaticResource Pad.Page}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ProblemTitle" Style="{StaticResource Text.Display}" Text="Origin wasn't installed"/>
                    <Grid Margin="{StaticResource Top.2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource Setup.Dot}" Fill="{StaticResource Brush.Danger}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.DangerText}" Text="Setup stopped"/>
                    </Grid>
                    <TextBlock x:Name="ProblemBody" Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.4}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Ghost}" Content="Close" Click="CloseButton_Click"/>
                    <Button x:Name="CopyDetailsButton" Margin="{StaticResource Left.2}" Content="Copy details"
                            Click="CopyDetailsButton_Click"/>
                    <Button x:Name="RetryButton" Style="{StaticResource Button.Primary}" Margin="{StaticResource Left.2}"
                            Content="Try again" Click="RetryButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Hairline frame so the chromeless window has an edge on any wallpaper. -->
        <Border Grid.RowSpan="3" BorderBrush="{StaticResource Brush.SoftStroke}" BorderThickness="1" IsHitTestVisible="False"/>

        <!-- "Origin is open": asked before installing over a running launcher (spec 11.10 dialog). The safe action,
             Not now, takes the focus. -->
        <Grid x:Name="RunningOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource Brush.Scrim}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Style="{StaticResource Setup.Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Close Origin Launcher?" Style="{StaticResource Text.Title}"/>
                    <TextBlock Style="{StaticResource Text.BodyDim}" Margin="{StaticResource Top.2}"
                               Text="It needs to close so setup can replace it. A game that's already running keeps going."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Top.6}">
                        <Button x:Name="RunningCancelButton" Style="{StaticResource Button.Ghost}" Content="Not now"
                                Click="RunningCancel_Click"/>
                        <Button x:Name="RunningCloseButton" Style="{StaticResource Button.Primary}" Margin="{StaticResource Left.2}"
                                Content="Close it and install" Click="RunningClose_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
