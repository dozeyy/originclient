<UserControl x:Class="OriginSetup.UI.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="{StaticResource Size.TitleBar}" VerticalAlignment="Top">

    <!-- Spec 14: 40 tall; the logo (20) and "Origin Setup" (bodyStrong) at left 16, 8 apart; ghost minimise and
         close (32) at right 4. The bar is the drag area (the window handles the mouse-down). -->
    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="{StaticResource Pad.TitleLeft}">
            <Image Source="{StaticResource Brand.Logo}" Width="{StaticResource Size.Logo.Bar}"
                   Height="{StaticResource Size.Logo.Bar}" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Origin"/>
            <TextBlock Text="Origin Setup" Style="{StaticResource Text.BodyStrong}" Margin="{StaticResource Left.2}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="{StaticResource Pad.TitleRight}">
            <Button Style="{StaticResource Button.Window}" Click="Minimize_Click" ToolTip="Minimize"
                    AutomationProperties.Name="Minimize" Focusable="False">
                <Path Data="{StaticResource Icon.Minimize}" Style="{StaticResource Setup.Glyph}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource Button.WindowClose}" Margin="{StaticResource Left.1}"
                    Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" Focusable="False">
                <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Setup.Glyph}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
