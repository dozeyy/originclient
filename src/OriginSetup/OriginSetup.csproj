<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Origin Setup — the custom installer (OriginLauncher-Setup.exe).

    Targets .NET Framework 4.7.2, which ships inside every supported Windows
    10/11, so the installer needs no runtime and stays ~1 MB: it DOWNLOADS
    the newest released launcher (OriginLauncher-win-x64.zip) while it
    installs — see Engine/ReleaseFeed.cs. The launcher itself is .NET 8;
    nothing here references it — the few files both need are LINKED from the
    launcher (theme, RAM rule, registry names) so the two can never drift apart.

    Build: dotnet build -c Release (Windows; CI's build-installer action does
    it). The built OriginSetup.exe IS OriginLauncher-Setup.exe, and a copy of
    it is the installed uninstall.exe (run with the uninstall switch).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>OriginSetup</AssemblyName>
    <RootNamespace>OriginSetup</RootNamespace>
    <ApplicationIcon>..\OriginLauncher.App\Assets\origin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Origin Launcher Setup</Product>
    <Company>Will Henry</Company>
    <Copyright>Will Henry</Copyright>
    <Description>Origin Launcher Setup</Description>
    <Version>1.0.0</Version>
    <!-- One exe, nothing beside it: no .config, no .pdb next to the build. -->
    <GenerateAppConfig>false</GenerateAppConfig>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- In .NET Framework itself (nothing ships beside the exe), but not
         referenced by default: the download (HttpClient), reading the release
         feed's JSON, and unpacking the launcher zip. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- The launcher's own theme, linked (not copied) so the installer looks
       exactly like the launcher. Typography is the one exception — see
       Theme/Typography.xaml. -->
  <ItemGroup>
    <Page Include="..\OriginLauncher.App\Theme\Colors.xaml" Link="Theme\Colors.xaml" />
    <Page Include="..\OriginLauncher.App\Theme\Spacing.xaml" Link="Theme\Spacing.xaml" />
    <Page Include="..\OriginLauncher.App\Theme\Buttons.xaml" Link="Theme\Buttons.xaml" />
    <Page Include="..\OriginLauncher.App\Theme\Inputs.xaml" Link="Theme\Inputs.xaml" />
    <Page Include="..\OriginLauncher.App\Theme\Brand.xaml" Link="Theme\Brand.xaml" />
    <Page Include="..\OriginLauncher.App\Theme\Icons.xaml" Link="Theme\Icons.xaml" />
    <Resource Include="..\..\tools\font-atlas\fonts\Monocraft.ttf" Link="Assets\Fonts\Monocraft.ttf" />
    <!-- Inter (OFL): Typography.xaml mirrors the launcher's, whose text face is Inter since the Poster restyle. -->
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-400.ttf" Link="Assets\Fonts\Inter-400.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-500.ttf" Link="Assets\Fonts\Inter-500.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-600.ttf" Link="Assets\Fonts\Inter-600.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-700.ttf" Link="Assets\Fonts\Inter-700.ttf" />
    <Resource Include="..\..\tools\font-atlas\fonts\Inter-800.ttf" Link="Assets\Fonts\Inter-800.ttf" />
    <EmbeddedResource Include="..\..\website\assets\fonts\Inter-LICENSE.txt" LogicalName="Inter-LICENSE.txt" />
    <Resource Include="..\OriginLauncher.App\Assets\origin.ico" Link="Assets\origin.ico" />
    <EmbeddedResource Include="..\..\tools\font-atlas\fonts\Monocraft-LICENSE.txt" LogicalName="Monocraft-LICENSE.txt" />
    <EmbeddedResource Include="..\mods\live-modules.json" LogicalName="live-modules.json" />
  </ItemGroup>

  <!-- Launcher code shared with the installer (written to compile on both). -->
  <ItemGroup>
    <Compile Include="..\OriginLauncher.App\Core\RamAdvice.cs" Link="Shared\RamAdvice.cs" />
    <Compile Include="..\OriginLauncher.App\Core\SystemInfo.cs" Link="Shared\SystemInfo.cs" />
    <Compile Include="..\OriginLauncher.App\Core\Install\InstallRegistry.cs" Link="Shared\InstallRegistry.cs" />
    <!-- Button press-scale (ui:Press), used by the linked Theme/Buttons.xaml. -->
    <Compile Include="..\OriginLauncher.App\UI\Press.cs" Link="Shared\Press.cs" />
  </ItemGroup>
</Project>
