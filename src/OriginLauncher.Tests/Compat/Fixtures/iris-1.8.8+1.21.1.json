   ]
  },
  "breaks": {
   "embeddium": "*",
   "iris-explorer": "*",
   "originsenhanced": "<=1.3.2",
   "colormatic": "<=3.0.0",
   "bedrockwaters": "<=1.6.0",
   "batchedentityrendering": "*",
   "canvas": "*",
   "optifabric": "*",
   "worldeditcui": "<1.18.1",
   "physicsmod": "<=3.0.13",
   "distanthorizons": "<=2.1.99",
   "immersive_portals": "<=1.4.2"
  },
  "custom": {
   "sodium:options": {
    "mixin.features.render.world.sky": false
   },
   "mc-publish": {
    "loaders": [
     "fabric",
     "quilt"
    ]
   }
  },
