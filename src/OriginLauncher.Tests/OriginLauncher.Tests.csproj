<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the launcher's pure logic — the parts that need no WPF and run on
    any OS (CI runs them on Linux in build-check). Each tested area is linked
    in from src/OriginLauncher.App rather than referenced, because the app
    itself is a net10.0-windows WPF exe that can't be built off Windows.

    Linked today: Core/Promos (home banner feed parsing + fallback chain,
    Discord invite handling, the visibility gate, occlusion math, rotation)
    Core/Sync (Settings Sync's merge rules + file formats, exercised on
    real files in temp folders), Core/GameFolders (per-account game folders:
    layout, migration, seeding, the shared per-version mods folder + its merge,
    the per-account launch state machine) and Core/Social (Origin social: sign-in,
    sync parsing/merging, polling budget, status lines, join arguments) and
    Core/Profiles (mod profiles) and Core/Auth/Sessions (when the launcher signs in to Minecraft: per-account
    session reuse until expiry, 429 back-off, pending accounts).
    Network is never touched: every fetch goes through a fake HttpTextGet.
    Run: dotnet test src/OriginLauncher.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Per-OS seams (X.Windows.cs / X.Mac.cs / X.Linux.cs next to each Core file that has a Windows-only part).
       Default: the Windows side, what the shipped launcher runs (CI's Linux job and Will's PC test it).
       dotnet test -p:OriginPlatform=Mac links the Mac side instead and adds MacSeamTests (the macos-15
       CI job: Keychain round-trip, hard links, paths, LaunchAgent, sysctl); -p:OriginPlatform=Linux links
       the Linux side and adds LinuxSeamTests (linux-launcher.yml: key file + keyring, hard links, XDG paths,
       autostart, procfs, sysfs GPU pick). The rest of the suite carries Windows-shaped data, so those jobs
       filter to the tests that apply. -->
  <PropertyGroup>
    <OriginPlatform Condition="'$(OriginPlatform)' == ''">Windows</OriginPlatform>
    <DefineConstants Condition="'$(OriginPlatform)' == 'Mac'">$(DefineConstants);ORIGIN_MAC</DefineConstants>
    <DefineConstants Condition="'$(OriginPlatform)' == 'Linux'">$(DefineConstants);ORIGIN_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OriginLauncher.App\Core\Accounts\AccountStore.$(OriginPlatform).cs" LinkBase="Accounts" />
    <Compile Include="..\OriginLauncher.App\Core\OriginPaths.$(OriginPlatform).cs" LinkBase="Accounts" />
    <Compile Include="..\OriginLauncher.App\Core\Runtime\TemurinJava8.$(OriginPlatform).cs" LinkBase="Runtime" />
    <Compile Include="..\OriginLauncher.App\Core\Versions\LaunchPrewarm.$(OriginPlatform).cs" LinkBase="Versions" />
    <!-- The per-OS launch seam (Windows: no-ops; Mac: MacLaunchPolicy applied to CmlLib). -->
    <Compile Include="..\OriginLauncher.App\Core\Launch\PlatformLaunch.cs" LinkBase="Launch" />
    <!-- The distro install commands PlatformLaunch.Linux, PlayFailure and CrashRules use (pure, every OS). -->
    <Compile Include="..\OriginLauncher.App\Core\Launch\LinuxPackages.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\LinuxOptionalPieces.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\PlatformLaunch.$(OriginPlatform).cs" LinkBase="Launch" />
  </ItemGroup>
  <ItemGroup Condition="'$(OriginPlatform)' == 'Windows'">
    <!-- SettingsStore names it; the tests swap the probe out, so the kernel32 call never runs off Windows. -->
    <Compile Include="..\OriginLauncher.App\Core\SystemInfo.Windows.cs" LinkBase="Settings" />
  </ItemGroup>
