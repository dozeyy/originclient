<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the launcher's pure logic — the parts that need no WPF and run on
    any OS (CI runs them on Linux in build-check). Each tested area is linked
    in from src/OriginLauncher.App rather than referenced, because the app
    itself is a net8.0-windows WPF exe that can't be built off Windows.

    Linked today: Core/Promos (home banner feed parsing + fallback chain,
    Discord invite handling, the visibility gate, occlusion math, rotation)
    Core/Sync (Settings Sync's merge rules + file formats, exercised on
    real files in temp folders), Core/GameFolders (per-account game folders:
    layout, migration, seeding, the shared per-version mods folder + its merge,
    the per-account launch state machine) and Core/Social (Origin social: sign-in,
    sync parsing/merging, polling budget, status lines, join arguments) and
    Core/Profiles (mod profiles) and Core/Auth/Sessions (when the launcher signs in to Minecraft: per-account
    session reuse until expiry, 429 back-off, pending accounts).
    Network is never touched: every fetch goes through a fake HttpTextGet.
    Run: dotnet test src/OriginLauncher.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OriginLauncher.App\Core\Promos\*.cs" LinkBase="Promos" />
    <!-- Mods page icons: jar icon parsing and the in-memory result cache. -->
    <Compile Include="..\OriginLauncher.App\Core\Mods\Icons\*.cs" LinkBase="ModIcons" />
    <Compile Include="..\OriginLauncher.App\Core\Sync\*.cs" LinkBase="Sync" />
    <!-- Recommended-for-this-PC preset: tier picking + the era-aware options.txt write (HardwareProbe is registry glue and stays out). -->
    <Compile Include="..\OriginLauncher.App\Core\Performance\PerformancePreset.cs" LinkBase="Performance" />
    <!-- The 1.8.9 performance presets (Competitive / Balanced / Quality): the bundle table, previewing, applying
         and undoing them on options.txt, optionsof.txt and Origin's config (pure; temp folders in the tests). -->
    <Compile Include="..\OriginLauncher.App\Core\Presets\*.cs" LinkBase="Presets" />
    <!-- Player heads: skin -> face + hat, default heads, cache key, Mojang profile parsing (pure). -->
    <Compile Include="..\OriginLauncher.App\Core\Skins\SkinFace.cs" LinkBase="Skins" />
    <!-- Only the top folder: Core/Social/Launcher is the WPF/account glue. -->
    <Compile Include="..\OriginLauncher.App\Core\Social\*.cs" LinkBase="Social" />
    <!-- The Friends drawer's keyed list diff (pure: ObservableCollection only). -->
    <Compile Include="..\OriginLauncher.App\UI\Controls\KeyedDiff.cs" LinkBase="Social" />
    <!-- The toasts waiting behind the two on screen (pure). -->
    <Compile Include="..\OriginLauncher.App\UI\Controls\ToastQueue.cs" LinkBase="Social" />
    <!-- The Home numeral's placement maths (band, size, centring; pure). -->
    <Compile Include="..\OriginLauncher.App\UI\Controls\NumeralBand.cs" LinkBase="UI" />
    <!-- Only the top folder: Core/GameFolders/Launcher is the account/settings glue. -->
    <Compile Include="..\OriginLauncher.App\Core\GameFolders\*.cs" LinkBase="GameFolders" />
    <!-- When the launcher signs in to Minecraft: per-account session reuse, expiry,
         429 back-off (Core/Auth/Sessions is pure; the broker glue stays out). -->
    <Compile Include="..\OriginLauncher.App\Core\Auth\Sessions\*.cs" LinkBase="Auth" />
    <Compile Include="..\OriginLauncher.App\Core\Auth\MicrosoftAuthException.cs" LinkBase="Auth" />
    <!-- The real accounts.json vault, run against a temporary file with DPAPI
         swapped for a pass-through (AccountVaultTests): never the real file. -->
    <Compile Include="..\OriginLauncher.App\Core\Auth\AccountSessionVault.cs" LinkBase="Auth" />
    <Compile Include="..\OriginLauncher.App\Core\Accounts\AccountStore.cs" LinkBase="Accounts" />
    <Compile Include="..\OriginLauncher.App\Core\Accounts\StoredAccount.cs" LinkBase="Accounts" />
    <Compile Include="..\OriginLauncher.App\Core\OriginPaths.cs" LinkBase="Accounts" />
    <!-- Mod profiles: the naming/server/selection rules, the profile list edits,
         the launch mods folder and the profile folder copy/delete (all pure). -->
    <Compile Include="..\OriginLauncher.App\Core\Profiles\*.cs" LinkBase="Profiles" />
    <!-- Import from another Minecraft instance: the pure engine (detectors, version picker,
         mod resolver, settings/pack migrator, transaction + journal). Core/Import/Launcher is
         the Windows/WPF glue and stays out. Every root is a parameter, so the tests only ever
         touch temp folders. -->
    <!-- The compatibility engine (Phase 5.1): pure, shared by the import resolver, launch and crash repair. -->
    <Compile Include="..\OriginLauncher.App\Core\Compat\*.cs" LinkBase="Compat" />
    <None Include="Compat\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\OriginLauncher.App\Core\Import\**\*.cs" Exclude="..\OriginLauncher.App\Core\Import\Launcher\**" LinkBase="Import" />
    <!-- The launcher glue that is pure: where each launcher keeps its data (roots), the settings change an
         import makes, the one-time first-run card rules and the Done page's summary reader. The rest of
         Core/Import/Launcher (backend, HTTP, startup, dry run) needs Windows and stays out. -->
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportRoots.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportSettingsRules.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportPrompt.cs" LinkBase="Import" />
    <!-- The Import drawer's words and decisions that need no WPF (plurals, the Import all label, the Done page's summary). -->
    <Compile Include="..\OriginLauncher.App\UI\Controls\ImportLogic.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\UI\Controls\ImportFlowModel.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\UI\Controls\ImportGridModel.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportSummaryView.cs" LinkBase="Import" />
    <!-- Launch/import safety glue (pure: no WPF, no OriginPaths, no files): the run-state counters, the startup
         recovery wrapper, the second-launch pipe, the close-while-importing rule, the bulk dry-run grouping,
         and the lazy builder that keeps the backend constructor free of disk work. -->
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportRunState.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\LaunchRunState.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\UpdateRunState.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportRecoveryRunner.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportIpc.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportCloseGuard.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\ImportBulkReport.cs" LinkBase="Import" />
    <Compile Include="..\OriginLauncher.App\Core\Import\Launcher\Deferred.cs" LinkBase="Import" />
    <!-- The self-update zip's integrity check (pure: streams + files; UpdateService, the WPF/HTTP glue, stays out). -->
    <Compile Include="..\OriginLauncher.App\Core\Updates\UpdateVerifier.cs" LinkBase="Updates" />
    <!-- The mandatory-update gate's state machine: a failed check never blocks play, retries quietly (pure; the clock is a parameter). -->
    <Compile Include="..\OriginLauncher.App\Core\Updates\UpdateGate.cs" LinkBase="Updates" />
    <Compile Include="..\OriginLauncher.App\Core\Models\LauncherSettings.cs" LinkBase="Models" />
    <Compile Include="..\OriginLauncher.App\Core\Models\VersionJvmOptions.cs" LinkBase="Models" />
    <!-- Settings: which rail item is lit, and who may see the Developer switch (both pure). -->
    <Compile Include="..\OriginLauncher.App\UI\Pages\SettingsRailSpy.cs" LinkBase="Settings" />
    <Compile Include="..\OriginLauncher.App\Core\DeveloperAccess.cs" LinkBase="Settings" />
    <!-- The launcher-to-game startup handshake and the loading bar's stage parsing (pure). -->
    <Compile Include="..\OriginLauncher.App\Core\Launch\GameHandoff.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\StageProgress.cs" LinkBase="Launch" />
    <!-- Crash handling that needs no files or WPF: cause table + classifier, memory bump, the show/no-show gate,
         the one-retry guard and the secret-free Copy report (CrashAnalyzer/CrashDiagnoser read files, so they stay out). -->
    <Compile Include="..\OriginLauncher.App\Core\Launch\CrashModels.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\CrashClassifier.cs" LinkBase="Launch" />
    <!-- Other clients' core jars (Feather, Lunar, ...): never imported, blamed first in a crash stack. -->
    <Compile Include="..\OriginLauncher.App\Core\ClientCoreMods.cs" LinkBase="Launch" />
    <!-- Mod blame from crash logs (uses the real ModManager linked further down). -->
    <Compile Include="..\OriginLauncher.App\Core\Launch\CrashAnalyzer.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\CrashReportBundle.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\RamAdvice.cs" LinkBase="Launch" />
    <!-- Heap cap + G1 flags for 1.8.9-era versions, and the pinned Temurin 8 provisioner (pure; network faked). -->
    <Compile Include="..\OriginLauncher.App\Core\Launch\HeapPlan.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\PackProbe.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\RamPolicy.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Launch\JvmArgPresets.cs" LinkBase="Launch" />
    <Compile Include="..\OriginLauncher.App\Core\Runtime\TemurinJava8.cs" LinkBase="Runtime" />
    <!-- The performance-mod catalog (per-version pins + SHA-512), the pin's hash check and the Mods page's
         managed-jar classification, so PerformanceModCatalogTests can hold the data consistent (pure). -->
    <!-- Which Modrinth versions the launcher may install on its own: releases only (pure). -->
    <Compile Include="..\OriginLauncher.App\Core\Loaders\ModrinthReleasePicker.cs" LinkBase="Loaders" />
    <!-- The integrity gate for Modrinth live-API downloads (Fabric API): host, file name, SHA-512, fail soft (pure). -->
    <Compile Include="..\OriginLauncher.App\Core\Loaders\ModrinthFileGuard.cs" LinkBase="Loaders" />
    <Compile Include="..\OriginLauncher.App\Core\Loaders\PerfMod.cs" LinkBase="Loaders" />
    <Compile Include="..\OriginLauncher.App\Core\Loaders\PerfStackTier.cs" LinkBase="Loaders" />
    <Compile Include="..\OriginLauncher.App\Core\Loaders\LegacyStackInstaller.cs" LinkBase="Loaders" />
    <Compile Include="..\OriginLauncher.App\Core\Loaders\VersionPerfProfile.cs" LinkBase="Loaders" />
    <Compile Include="..\OriginLauncher.App\Core\Loaders\PerformanceModCatalog.cs" LinkBase="Loaders" />
    <Compile Include="..\OriginLauncher.App\Core\Loaders\PerformanceModCatalog.Data.cs" LinkBase="Loaders" />
    <Compile Include="..\OriginLauncher.App\Core\Mods\ModManager.cs" LinkBase="Mods" />
    <!-- 1.8.9's FML splash theme (pure file IO). -->
    <Compile Include="..\OriginLauncher.App\Core\Loaders\ForgeSplashTheme.cs" LinkBase="Loaders" />
    <!-- Offline launching: the Mojang metadata disk copy and the "you're offline" classifier (pure). -->
    <Compile Include="..\OriginLauncher.App\Core\Versions\MojangMetaCache.cs" LinkBase="Versions" />
    <Compile Include="..\OriginLauncher.App\Core\Versions\OfflineLaunch.cs" LinkBase="Versions" />
    <!-- Home's background warm-up of the picked version (pure file reads; the startup trace is its log). -->
    <Compile Include="..\OriginLauncher.App\Core\Versions\LaunchPrewarm.cs" LinkBase="Versions" />
    <Compile Include="..\OriginLauncher.App\Core\StartupTrace.cs" LinkBase="Versions" />
    <!-- Which versions are installed / partial / missing / update-ready (pure disk reads; InstalledVersions.Shared.cs, the real wiring, stays out). -->
    <Compile Include="..\OriginLauncher.App\Core\Versions\InstalledVersions.cs" LinkBase="Versions" />
    <!-- The pinned legacy Forge table (pure data, no CmlLib), so a test can assert the real 1.8.9 layout. -->
    <Compile Include="..\OriginLauncher.App\Core\Loaders\LegacyForgeBuilds.cs" LinkBase="Loaders" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <!-- Compile-time only for AccountStore; the tests never call DPAPI. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>
</Project>
