<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OriginLauncher.Mac.UI.Controls.ConfirmOverlay"
             IsVisible="False" Focusable="True">

    <!-- Modal confirm dialog (twin of the WPF ConfirmOverlay.xaml): Surface.DialogSheet over the scrim, at most 440
         wide, footer right-aligned with the secondary (cancel) first, then the primary or danger button, both at least
         96 wide. Awaited via ShowAsync; Primary returns true, Secondary/Esc returns false; the safe action holds focus. -->
    <Border Background="{StaticResource Brush.Scrim}">
        <Border Theme="{StaticResource Surface.DialogSheet}" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="440" Margin="24">
            <StackPanel>
                <TextBlock x:Name="TitleText" Theme="{StaticResource Text.Title}" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Theme="{StaticResource Text.BodyDim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="SecondaryButton" Theme="{StaticResource Button.Secondary}" MinWidth="96" Margin="0,0,8,0"/>
                    <Button x:Name="PrimaryButton" Theme="{StaticResource Button.Primary.Medium}" MinWidth="96"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
