<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OriginLauncher.Mac.UI.Controls"
             x:Class="OriginLauncher.Mac.UI.Controls.ImportPromptCard"
             IsVisible="False">

    <!-- Twin of the WPF UI/Controls/ImportPromptCard.xaml. The one-time first-run welcome (Poster): a centred card over
         the dimmed Home art. It names the launchers it found, by their real logos, and asks one question with two
         answers. It stays until the player answers (Import opens the Import page, Skip for now closes it) and is never
         shown again. -->
    <Panel>
        <Border Background="{StaticResource Brush.Scrim}"/>
        <!-- A dialog over the scrim (Workbench: the dialog corner, Radius.Dialog, and the strong 1 px edge of a sheet).
             No shadow: the card itself animates in, and effects never go on an animating element. The rise in is
             opacity + translate only (the transitions below; render-shots clear them, Motion.Off). -->
        <Border x:Name="Card" MaxWidth="680" Margin="32,80,32,32" Padding="32,24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.Panel}" CornerRadius="{StaticResource Radius.Dialog}"
                BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{StaticResource Motion.Enter}"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource Motion.Enter}" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel>
                <c:BrandLogo Width="{StaticResource Size.Logo.Hero}" Height="{StaticResource Size.Logo.Hero}" HorizontalAlignment="Left"/>
                <TextBlock Text="Welcome to Origin" Theme="{StaticResource Text.Display}"
                           HorizontalAlignment="Left" Margin="0,16,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="QuestionText" Theme="{StaticResource Text.Body}" FontWeight="SemiBold"
                           FontSize="{StaticResource FontSize.Title}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Your worlds, mods, servers and settings come over as Origin profiles. Nothing in the other launchers changes."
                           Theme="{StaticResource Text.BodyDim}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                           Margin="0,6,0,0"/>

                <!-- One chip per launcher with setups to bring: logo, name, how many setups. -->
                <WrapPanel x:Name="LaunchersPanel" Margin="0,20,0,0"/>

                <Grid Margin="0,16,0,0" ColumnDefinitions="Auto,Auto,*">
                    <Button x:Name="ImportButton" Theme="{StaticResource Button.Primary.Medium}"
                            MinWidth="120" Click="Import_Click"
                            AutomationProperties.Name="Import everything">
                        <StackPanel Orientation="Horizontal">
                            <c:IconPath Data="{StaticResource Icon.Import}" Theme="{StaticResource Icon.Small}"
                                        Margin="0,0,8,0" Stroke="{Binding $parent[Button].Foreground}"/>
                            <TextBlock Text="Import everything" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ChooseButton" Grid.Column="1" Content="Choose" Theme="{StaticResource Button.Secondary}"
                            Margin="8,0,0,0" Click="Choose_Click"
                            AutomationProperties.Name="Choose what to import"/>
                    <Button x:Name="NotNowButton" Grid.Column="2" Content="Skip for now" Theme="{StaticResource Button.Chrome}"
                            MinHeight="{StaticResource Size.ControlMd}" Padding="12,0" HorizontalAlignment="Right" Click="NotNow_Click"/>
                </Grid>
                <TextBlock Text="You can import later from Profiles, or the Import button at the top."
                           Theme="{StaticResource Text.Caption}" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
