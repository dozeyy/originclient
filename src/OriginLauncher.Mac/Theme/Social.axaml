<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Avalonia twin of src/OriginLauncher.App/Theme/Social.xaml: the toasts', the Friends drawer's and the chat's keys,
        plus the drawer's "..." menu (Menu.*, the WPF ContextMenu skin). Same keys, same values. The row keys the
        Import page shares with the drawer (Social.Avatar, Social.DrawerRow, ...) live in Import.axaml.
    -->

    <ControlTheme x:Key="Social.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </ControlTheme>

    <!-- Row and drawer text buttons: Button.Secondary.Small (32 px) with the Caption size. -->
    <ControlTheme x:Key="Social.Action" TargetType="Button" BasedOn="{StaticResource Button.Secondary.Small}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>

    <!-- Icon-only button: Icon.Small (14) + 9 px padding each side = Size.ControlMd (32). Min, not fixed, size. -->
    <ControlTheme x:Key="Social.Icon" TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
        <Setter Property="MinWidth" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlMd}"/>
        <Setter Property="Padding" Value="9"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>

    <!-- The presence dot on an avatar's corner: a 10 px round dot (stays a circle), ringed in the card colour. -->
    <ControlTheme x:Key="Social.Dot" TargetType="Border">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,-3,-3"/>
        <Setter Property="Background" Value="{StaticResource Brush.Success}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xs}"/>
    </ControlTheme>

    <!-- A text box's placeholder, laid over the box (13 px in = the box's own text inset). -->
    <ControlTheme x:Key="Social.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="Margin" Value="13,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </ControlTheme>

    <ControlTheme x:Key="Social.ActionPrimary" TargetType="Button" BasedOn="{StaticResource Button.Primary.Small}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </ControlTheme>

    <!-- Join a friend's server: the one primary action a row carries. -->
    <ControlTheme x:Key="Social.Join" TargetType="Button" BasedOn="{StaticResource Social.ActionPrimary}"/>

    <ControlTheme x:Key="Social.Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Brush.SoftStroke}"/>
    </ControlTheme>

    <!-- ===== The "..." menu (WPF: the ContextMenu / MenuItem / Separator skin) ===== -->

    <!-- The menu's card. It opens rising 4 px while it fades in over Motion.Enter (UI/Controls/PopupMenu.cs); it
         never animates out (closing is instant, like every Origin overlay). -->
    <ControlTheme x:Key="Menu.Popup" TargetType="Border">
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="BoxShadow" Value="{StaticResource Shadow.Overlay}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="196"/>
        <Setter Property="MaxWidth" Value="320"/>
    </ControlTheme>

    <!-- One menu row: a 26 px icon column, then the words (trimmed). Tag holds the icon geometry; a danger item sets
         Foreground to Brush.Danger in code, and its icon follows the foreground. -->
    <ControlTheme x:Key="Menu.Item" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}"
                        MinHeight="{StaticResource Size.ControlMd}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource Brush.GhostHover}"/>
        </Style>
        <!-- The keyboard's highlight (WPF: IsHighlighted): arrow keys light an item, a mouse-opened menu lights none. -->
        <Style Selector="^:focus-visible /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource Brush.GhostHover}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource Brush.GhostPress}"/>
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="Menu.Separator" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Background" Value="{StaticResource Brush.SoftStroke}"/>
    </ControlTheme>
</ResourceDictionary>
