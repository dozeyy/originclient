{
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "node -e \"const f=require('fs');let j;for(const p of['launcher/promos.json','website/launcher/promos.json'])if(f.existsSync(p))try{j=JSON.parse(f.readFileSync(p,'utf8'))}catch{j=0}process.exit(j===undefined||j&&j.schema===1&&j.promos&&j.promos.length?1:0)\"",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/((?!ad/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://crafthead.net https://mc-heads.net https://textures.minecraft.net; connect-src 'self' https://api.github.com https://playerdb.co https://origin-cosmetics.will-f11.workers.dev; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
